{{>head}}
<body class="bg-gray-50">
  <div class="min-h-screen lg:flex">
    {{> seller-sidebar}}
    <main class="flex-1 p-5 lg:p-8">
      <div class="max-w-3xl mx-auto">
        <div class="mb-6"><a href="/seller/products" class="text-sm font-semibold text-emerald-700">← Back to products</a><h1 class="mt-2 text-3xl font-extrabold text-gray-900">{{title}}</h1></div>

        {{#each errors}}<div class="mb-3 rounded-xl bg-red-100 px-4 py-3 text-red-800">{{this}}</div>{{/each}}

        <form method="POST" action="{{formAction}}" enctype="multipart/form-data" class="cf-card space-y-5 p-6 lg:p-8">
          <div><label class="mb-1 block text-sm font-semibold">Product name</label><input class="cf-input" type="text" name="name" required minlength="2" maxlength="200" value="{{product.name}}" /></div>
          <div><label class="mb-1 block text-sm font-semibold">Description</label><textarea class="cf-input" name="description" rows="5" required minlength="5" maxlength="5000">{{product.description}}</textarea></div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div><label class="mb-1 block text-sm font-semibold">Category</label><select class="cf-input" name="category" required><option value="">Select category</option>{{#each categories}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></div>
            <div><label class="mb-1 block text-sm font-semibold">Status</label><select class="cf-input" name="status"><option value="active" {{#if (eq product.status 'active')}}selected{{/if}}>Active</option><option value="inactive" {{#if (eq product.status 'inactive')}}selected{{/if}}>Inactive</option><option value="pending" {{#if (eq product.status 'pending')}}selected{{/if}}>Pending</option></select></div>
            <div><label class="mb-1 block text-sm font-semibold">Price (PHP)</label><input class="cf-input" type="number" name="price" min="0.01" max="1000000" step="0.01" required value="{{product.price}}" /></div>
            <div><label class="mb-1 block text-sm font-semibold">Stock quantity</label><input class="cf-input" type="number" name="stocks" min="0" max="1000000" step="1" required value="{{product.stocks}}" /></div>
          </div>
          <div><label class="mb-1 block text-sm font-semibold">Product image</label><input class="cf-input" type="file" name="image_file" accept="image/jpeg,image/png,image/webp" /><p class="mt-1 text-xs text-gray-500">JPEG, PNG, or WebP; maximum 3 MB. A new image replaces the existing one.</p>{{#if product.image_url}}<img src="{{product.image_url}}" alt="Current product" class="mt-3 h-28 w-28 rounded-xl border object-cover" />{{/if}}</div>
          <label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="free_shipping" {{#if product.free_shipping}}checked{{/if}} /> Offer free shipping</label>
          <div class="flex gap-3 border-t pt-5"><button class="cf-btn cf-btn-primary" type="submit">{{submitLabel}}</button><a href="/seller/products" class="cf-btn cf-btn-ghost">Cancel</a></div>
        </form>
      </div>
    </main>
  </div>
</body>
</html>
