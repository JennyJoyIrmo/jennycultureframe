{{>head}}
<body class="bg-gray-50">
  <div class="min-h-screen lg:flex">
    {{> seller-sidebar}}
    <main class="flex-1 p-5 lg:p-8">
      <div class="max-w-5xl mx-auto">
        <div class="mb-6"><h1 class="text-3xl font-extrabold text-gray-900">Product Categories</h1><p class="text-gray-500">Categories are shared across the CultureFrame storefront.</p></div>
        {{#if success_msg}}<div class="mb-5 rounded-xl bg-emerald-100 px-4 py-3 text-emerald-800">{{success_msg}}</div>{{/if}}
        {{#if error_msg}}<div class="mb-5 rounded-xl bg-red-100 px-4 py-3 text-red-800">{{error_msg}}</div>{{/if}}

        <form method="POST" action="/seller/categories/add" class="cf-card mb-6 grid gap-3 p-5 md:grid-cols-[1fr_2fr_auto]">
          <input class="cf-input" name="name" minlength="2" maxlength="120" required placeholder="Category name" />
          <input class="cf-input" name="description" maxlength="1000" placeholder="Short description" />
          <button class="cf-btn cf-btn-primary" type="submit">Add category</button>
        </form>

        <div class="cf-card divide-y">
          {{#each categories}}
            <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center">
              <div class="min-w-0 flex-1"><div class="flex items-center gap-2"><h2 class="font-bold text-gray-900">{{name}}</h2>{{#if is_active}}<span class="cf-badge cf-badge-green">Active</span>{{else}}<span class="cf-badge cf-badge-gray">Inactive</span>{{/if}}</div><p class="mt-1 text-sm text-gray-500">{{description}}</p></div>
              <div class="text-sm text-gray-500">{{productCount}} product(s)</div>
              <form method="POST" action="/seller/categories/delete/{{id}}" onsubmit="return confirm('Delete this unused category?');"><button type="submit" class="cf-btn bg-red-50 text-red-700" {{#if productCount}}disabled{{/if}}>Delete</button></form>
            </div>
          {{/each}}
        </div>
      </div>
    </main>
  </div>
</body>
</html>
