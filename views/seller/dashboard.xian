{{>head}}
<body class="bg-gray-50">
  <div class="min-h-screen lg:flex">
    {{> seller-sidebar}}
    <main class="flex-1 p-5 lg:p-8">
      <div class="max-w-7xl mx-auto">
        <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <p class="text-sm font-semibold text-emerald-600">Seller dashboard</p>
            <h1 class="text-3xl font-extrabold text-gray-900">Welcome, {{seller.business_name}}</h1>
            <p class="mt-1 text-gray-500">Manage your CultureFrame inventory and storefront listings.</p>
          </div>
          <a href="/seller/products/add" class="cf-btn cf-btn-primary">Add product</a>
        </div>

        {{#if success_msg}}<div class="mb-5 rounded-xl bg-emerald-100 px-4 py-3 text-emerald-800">{{success_msg}}</div>{{/if}}
        {{#if error_msg}}<div class="mb-5 rounded-xl bg-red-100 px-4 py-3 text-red-800">{{error_msg}}</div>{{/if}}

        <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <article class="cf-card p-5"><p class="text-sm text-gray-500">Total products</p><p class="mt-2 text-3xl font-extrabold">{{stats.total}}</p></article>
          <article class="cf-card p-5"><p class="text-sm text-gray-500">Active listings</p><p class="mt-2 text-3xl font-extrabold text-emerald-600">{{stats.active}}</p></article>
          <article class="cf-card p-5"><p class="text-sm text-gray-500">Low stock</p><p class="mt-2 text-3xl font-extrabold text-amber-600">{{stats.lowStock}}</p></article>
          <article class="cf-card p-5"><p class="text-sm text-gray-500">Out of stock</p><p class="mt-2 text-3xl font-extrabold text-red-600">{{stats.outOfStock}}</p></article>
        </section>

        <section class="cf-card mt-8 overflow-hidden">
          <div class="flex items-center justify-between border-b px-5 py-4">
            <div><h2 class="font-bold text-gray-900">Recently updated products</h2><p class="text-sm text-gray-500">Your six latest inventory changes</p></div>
            <a href="/seller/products" class="text-sm font-semibold text-emerald-700 hover:text-emerald-900">View all</a>
          </div>
          <div class="divide-y">
            {{#each recentProducts}}
              <a href="/seller/products/edit/{{id}}" class="flex items-center gap-4 px-5 py-4 hover:bg-emerald-50">
                <img src="{{#if image_url}}{{image_url}}{{else}}/images/logo.png{{/if}}" alt="" class="h-12 w-12 rounded-lg border object-cover" />
                <div class="min-w-0 flex-1"><p class="font-semibold truncate">{{name}}</p><p class="text-sm text-gray-500">{{category}} · {{stocks}} in stock</p></div>
                <span class="cf-badge {{#if (eq status 'active')}}cf-badge-green{{else}}cf-badge-gray{{/if}}">{{status}}</span>
              </a>
            {{else}}
              <div class="px-5 py-12 text-center text-gray-500">No seller products yet. Add your first product to begin.</div>
            {{/each}}
          </div>
        </section>
      </div>
    </main>
  </div>
</body>
</html>
