{{>head}}
<body class="bg-gray-50">
  {{>nav}}

  <div class="max-w-7xl mx-auto px-4 pt-8">
    <div class="cf-page-header cf-fade-up">
      <div class="flex items-center gap-2 mb-2">
        <i class="fas fa-paint-brush text-emerald-200"></i>
        <span class="text-emerald-200 text-sm font-medium">Arts & Crafts</span>
      </div>
      <h1 class="text-3xl font-extrabold text-white">Traditional Arts & Crafts</h1>
      <p class="text-emerald-100 mt-1 text-sm">Discover the rich heritage of Hanunuo Mangyan craftsmanship</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">

      <!-- Filter sidebar -->
      <aside class="lg:col-span-1">
        <div class="cf-card p-5 sticky top-20 cf-fade-up">
          <h4 class="font-bold text-gray-800 mb-4 flex items-center gap-2">
            <i class="fas fa-filter text-emerald-600 text-sm"></i> Filter Crafts
          </h4>
          <form method="GET" action="/crafts" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Search</label>
              <div class="relative">
                <input name="search" placeholder="Search crafts…"
                       class="cf-input pl-9" value="{{search}}" />
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Category</label>
              <select name="category" class="cf-input">
                <option value="">All Categories</option>
                <option value="weaving">Weaving</option>
                <option value="pottery">Pottery</option>
                <option value="woodcarving">Wood Carving</option>
                <option value="basketry">Basketry</option>
              </select>
            </div>
            <button type="submit" class="cf-btn cf-btn-primary w-full justify-center">
              <i class="fas fa-search"></i> Apply Filter
            </button>
            <a href="/crafts" class="cf-btn cf-btn-ghost w-full justify-center text-xs">
              <i class="fas fa-times"></i> Clear
            </a>
          </form>
        </div>
      </aside>

      <!-- Crafts grid -->
      <div class="lg:col-span-3">
        {{#if crafts.length}}
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
          {{#each crafts}}
          <a href="/crafts/{{this.id}}" class="group cf-card overflow-hidden hover:shadow-lg transition-all duration-200 cf-fade-up">
            <div class="relative h-48 overflow-hidden bg-amber-100">
              {{#if this.image_url}}
              <img src="{{this.image_url}}" alt="{{this.title}}"
                   class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                   onerror="this.src='/images/logo.png'" />
              {{else}}
              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-amber-400 to-orange-500">
                <i class="fas fa-paint-brush text-white text-5xl opacity-40"></i>
              </div>
              {{/if}}
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div class="absolute bottom-3 left-3 right-3">
                <h3 class="font-bold text-white text-sm group-hover:text-emerald-200 transition-colors line-clamp-1">{{this.title}}</h3>
                {{#if this.location}}
                <p class="text-white/80 text-xs mt-0.5 flex items-center gap-1">
                  <i class="fas fa-map-marker-alt text-xs"></i> {{this.location}}
                </p>
                {{/if}}
              </div>
            </div>
            <div class="p-4">
              <p class="text-gray-500 text-sm mb-3 line-clamp-2">{{this.description}}</p>
              <span class="inline-flex items-center gap-1.5 text-emerald-600 text-sm font-semibold">
                View Details <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
              </span>
            </div>
          </a>
          {{/each}}
        </div>
        {{else}}
        <div class="cf-card p-16 text-center">
          <i class="fas fa-paint-brush text-5xl text-gray-200 mb-4"></i>
          <h3 class="text-xl font-bold text-gray-500 mb-2">No Crafts Found</h3>
          <p class="text-gray-400 text-sm">Try adjusting your filters or search terms.</p>
          <a href="/crafts" class="cf-btn cf-btn-primary mt-4"><i class="fas fa-times"></i> Clear Filters</a>
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  {{>footer}}
</body>
</html>
