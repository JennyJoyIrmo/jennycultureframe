{{>head}}
<body class="min-h-screen bg-cover bg-center bg-fixed" style="background-image: url('https://c8.alamy.com/comp/B28RJE/mangyan-crafts-created-in-the-panaytayan-community-near-mansalay-oriental-B28RJE.jpg');">
  <div class="absolute inset-0 bg-white/5 z-0"></div>
  
  <div class="relative z-10">
    {{>nav}}
    
    <div class="container mx-auto px-6 py-8">
      <!-- Enhanced Header -->
      <div class="bg-gradient-to-r from-emerald-600 to-green-700 backdrop-blur-sm rounded-xl shadow-lg p-8 mb-8 border border-emerald-500 text-center">
        <h2 class="text-5xl font-bold text-white mb-4">
          🎨 Traditional Arts & Crafts
        </h2>
        <p class="text-xl text-emerald-100 max-w-2xl mx-auto">
          Discover the rich heritage of Hanunuo Mangyan craftsmanship and local artisan works
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Filters Sidebar -->
        <aside class="lg:col-span-3">
          <div class="bg-white rounded-2xl shadow-xl p-6 border border-emerald-200/50 sticky top-24">
            <h4 class="text-xl font-bold text-gray-800 mb-6 flex items-center">
              <svg class="w-5 h-5 text-emerald-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
              </svg>
              Filter Crafts
            </h4>
            <form method="GET" action="/crafts" class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Search</label>
                <div class="relative">
                  <input name="search" placeholder="Search crafts..." class="w-full border-2 border-gray-200 px-4 py-3 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 pl-11" />
                  <svg class="w-5 h-5 text-gray-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
              </div>
              
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Category</label>
                <select name="category" class="w-full border-2 border-gray-200 px-4 py-3 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                  <option value="">All Categories</option>
                  <option value="weaving">Weaving</option>
                  <option value="pottery">Pottery</option>
                  <option value="woodcarving">Wood Carving</option>
                  <option value="basketry">Basketry</option>
                </select>
              </div>
              
              <button type="submit" class="w-full bg-gradient-to-r from-emerald-600 to-green-600 text-white py-3 rounded-xl font-semibold hover:from-emerald-700 hover:to-green-700 transition-all shadow-lg hover:shadow-xl transform hover:scale-105 flex items-center justify-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                Apply Filters
              </button>
            </form>
          </div>
        </aside>

        <!-- Crafts Grid -->
        <div class="lg:col-span-9">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {{#each crafts}}
            <a href="/crafts/{{this.id}}" class="group">
              <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transform transition-all duration-300 hover:-translate-y-2 overflow-hidden border border-emerald-100">
                <!-- Image -->
                <div class="relative h-56 bg-gradient-to-r from-emerald-400 to-green-400 overflow-hidden">
                  {{#if this.image_url}}
                    <img src="{{this.image_url}}" alt="{{this.title}}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                  {{else}}
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-20 h-20 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
                      </svg>
                    </div>
                  {{/if}}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                  
                  <!-- Title Overlay -->
                  <div class="absolute bottom-4 left-4 right-4">
                    <h3 class="font-bold text-white text-xl mb-1 group-hover:text-emerald-200 transition-colors">{{this.title}}</h3>
                    {{#if this.location}}
                    <div class="flex items-center text-white/90 text-sm">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 12.414a2 2 0 010-2.828l4.243-4.243a2 2 0 012.828 0l4.243 4.243a2 2 0 010 2.828l-4.243 4.243a2 2 0 01-2.828 0z"></path>
                      </svg>
                      {{this.location}}
                    </div>
                    {{/if}}
                  </div>
                </div>
                
                <!-- Content -->
                <div class="p-5">
                  <p class="text-gray-600 text-sm line-clamp-2 mb-4">{{this.description}}</p>
                  
                  <div class="flex items-center justify-between">
                    <span class="text-emerald-600 font-semibold group-hover:text-green-600 transition-colors flex items-center">
                      View Details
                      <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>
            </a>
            {{/each}}
          </div>
          
          <!-- Empty State -->
          {{#unless crafts.length}}
          <div class="bg-white rounded-2xl shadow-xl p-12 text-center border border-emerald-200/50">
            <svg class="w-20 h-20 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
            </svg>
            <h3 class="text-2xl font-bold text-gray-800 mb-2">No Crafts Found</h3>
            <p class="text-gray-600">Try adjusting your filters or search terms.</p>
          </div>
          {{/unless}}
        </div>
      </div>
    </div>
  </div>

  <style>
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>

{{>footer}}
