{{>head}}
<body class="bg-gray-50">
  {{>nav}}

  <div class="max-w-3xl mx-auto px-4 py-12">
    <div class="cf-card overflow-hidden cf-fade-up">

      <!-- Hero -->
      <div class="cf-hero py-12 px-8 text-center">
        <div class="relative inline-flex items-center justify-center mb-5">
          <div class="w-24 h-24 bg-white/20 rounded-full flex items-center justify-center shadow-xl">
            <i class="fas fa-check text-white text-4xl"></i>
          </div>
          <div class="absolute inset-0 w-24 h-24 rounded-full border-4 border-white/30 animate-ping"></div>
        </div>
        <h1 class="text-3xl font-extrabold text-white mb-2">Order Confirmed! 🎉</h1>
        <p class="text-emerald-200">Thank you for supporting local crafts from Mansalay.</p>
      </div>

      <!-- Order summary -->
      <div class="p-6 md:p-8">
        <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-5 mb-6">
          <p class="text-sm text-gray-500 mb-1">Order Reference</p>
          <p class="text-2xl font-extrabold text-emerald-700">#{{order.id}}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          <div class="cf-card-green p-4">
            <p class="text-xs text-gray-400 mb-0.5"><i class="fas fa-user text-emerald-500 mr-1"></i> Customer</p>
            <p class="font-semibold text-gray-800">{{order.customer_name}}</p>
            <p class="text-sm text-gray-500">{{order.customer_email}}</p>
          </div>
          <div class="cf-card-green p-4">
            <p class="text-xs text-gray-400 mb-0.5"><i class="fas fa-credit-card text-emerald-500 mr-1"></i> Payment</p>
            <p class="font-semibold text-gray-800 capitalize">{{order.payment_method}}</p>
            <p class="text-xl font-extrabold text-emerald-600">₱{{order.total_amount}}</p>
          </div>
        </div>

        <!-- Info banner -->
        <div class="flex items-start gap-3 p-4 bg-blue-50 border border-blue-100 rounded-xl mb-6">
          <i class="fas fa-envelope text-blue-500 mt-0.5 flex-shrink-0"></i>
          <p class="text-blue-700 text-sm">We'll send you an email confirmation with tracking details once your order ships.</p>
        </div>

        <!-- What's next -->
        <h3 class="font-bold text-gray-700 mb-4 flex items-center gap-2">
          <i class="fas fa-route text-emerald-500 text-sm"></i> What's Next?
        </h3>
        <div class="grid grid-cols-3 gap-3 mb-8">
          <div class="text-center p-3 bg-emerald-50 rounded-xl border border-emerald-100">
            <div class="w-9 h-9 bg-emerald-500 rounded-full flex items-center justify-center mx-auto mb-2">
              <i class="fas fa-check text-white text-xs"></i>
            </div>
            <p class="text-xs font-semibold text-emerald-700">Confirmed</p>
            <p class="text-[10px] text-gray-400 mt-0.5">Order received</p>
          </div>
          <div class="text-center p-3 bg-blue-50 rounded-xl border border-blue-100">
            <div class="w-9 h-9 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-2">
              <i class="fas fa-truck text-white text-xs"></i>
            </div>
            <p class="text-xs font-semibold text-blue-700">Shipping</p>
            <p class="text-[10px] text-gray-400 mt-0.5">Items dispatched</p>
          </div>
          <div class="text-center p-3 bg-purple-50 rounded-xl border border purple-100">
            <div class="w-9 h-9 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-2">
              <i class="fas fa-home text-white text-xs"></i>
            </div>
            <p class="text-xs font-semibold text-purple-700">Delivered</p>
            <p class="text-[10px] text-gray-400 mt-0.5">At your door</p>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/customer/orders" class="cf-btn cf-btn-primary flex-1 justify-center py-3">
            <i class="fas fa-box"></i> Track My Order
          </a>
          <a href="/shop" class="cf-btn cf-btn-outline flex-1 justify-center py-3">
            <i class="fas fa-shopping-bag"></i> Continue Shopping
          </a>
        </div>
      </div>
    </div>
  </div>

  {{>footer}}
</body>
</html>
