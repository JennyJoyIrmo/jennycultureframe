<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout — CultureFrame</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    body { font-family: 'Inter', 'Segoe UI', sans-serif; background: #f0fdf4; }

    .input-field {
      width: 100%;
      padding: 0.65rem 1rem;
      border: 1.5px solid #d1fae5;
      border-radius: 10px;
      font-size: 0.9rem;
      transition: all 0.2s;
      background: #fff;
      outline: none;
    }
    .input-field:focus {
      border-color: #059669;
      box-shadow: 0 0 0 3px rgba(5,150,105,0.12);
    }
    .input-field::placeholder { color: #9ca3af; }

    .card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.06), 0 4px 16px rgba(5,150,105,0.06);
      border: 1px solid #d1fae5;
    }
    .card-header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid #f0fdf4;
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }
    .step-badge {
      width: 26px; height: 26px;
      border-radius: 50%;
      background: linear-gradient(135deg, #059669, #10b981);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }

    .payment-card {
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      padding: 0.9rem 1rem;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .payment-card:hover { border-color: #6ee7b7; background: #f0fdf4; }
    .payment-card.selected { border-color: #059669; background: #ecfdf5; }
    .payment-card input[type="radio"] { accent-color: #059669; width: 16px; height: 16px; }

    .shipping-card {
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      padding: 0.9rem 1rem;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .shipping-card:hover { border-color: #6ee7b7; }
    .shipping-card.selected { border-color: #059669; background: #ecfdf5; }

    .qty-btn {
      width: 28px; height: 28px;
      border-radius: 8px;
      border: 1.5px solid #d1fae5;
      background: #f0fdf4;
      color: #065f46;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      transition: all 0.15s;
      font-size: 0.8rem;
    }
    .qty-btn:hover { background: #059669; color: #fff; border-color: #059669; }

    .order-btn {
      width: 100%;
      padding: 0.9rem;
      background: linear-gradient(135deg, #059669, #10b981);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 4px 12px rgba(5,150,105,0.3);
      letter-spacing: 0.02em;
    }
    .order-btn:hover {
      background: linear-gradient(135deg, #047857, #059669);
      box-shadow: 0 6px 20px rgba(5,150,105,0.4);
      transform: translateY(-1px);
    }
    .order-btn:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }

    .progress-step { display: flex; align-items: center; gap: 0.5rem; }
    .progress-circle {
      width: 32px; height: 32px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 0.85rem;
    }
    .progress-line { height: 3px; width: 60px; border-radius: 2px; }

    .product-img {
      width: 64px; height: 64px;
      border-radius: 10px;
      object-fit: cover;
      border: 1.5px solid #d1fae5;
      flex-shrink: 0;
      background: #f0fdf4;
    }

    .trust-badge {
      display: flex; flex-direction: column; align-items: center;
      gap: 0.25rem; font-size: 0.7rem; color: #6b7280;
    }
    .trust-badge .icon {
      width: 32px; height: 32px; border-radius: 8px;
      background: #f0fdf4; display: flex; align-items: center; justify-content: center;
      color: #059669; font-size: 0.9rem;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up { animation: fadeUp 0.4s ease both; }
    .fade-up-2 { animation: fadeUp 0.4s 0.1s ease both; }
    .fade-up-3 { animation: fadeUp 0.4s 0.2s ease both; }
    .fade-up-4 { animation: fadeUp 0.4s 0.3s ease both; }
  </style>
</head>
<body class="min-h-screen">

  <!-- Top bar -->
  <div class="bg-emerald-700 text-white text-xs py-2">
    <div class="max-w-6xl mx-auto px-4 flex justify-between items-center">
      <div class="flex items-center gap-1 opacity-80">
        <i class="fas fa-shield-alt"></i>
        <span>Secure Checkout</span>
      </div>
      {{#if user}}
      <div class="flex items-center gap-2">
        <div class="w-5 h-5 rounded-full bg-emerald-500 flex items-center justify-center text-xs font-bold">
          {{#if user.name}}{{user.name.[0]}}{{else}}U{{/if}}
        </div>
        <span>{{user.name}}</span>
      </div>
      {{else}}
      <div class="flex gap-3">
        <a href="/login" class="hover:text-emerald-200 transition-colors">Login</a>
        <a href="/register" class="hover:text-emerald-200 transition-colors">Sign Up</a>
      </div>
      {{/if}}
    </div>
  </div>

  <!-- Nav -->
  <nav class="bg-white shadow-sm border-b border-emerald-100 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <img src="/images/logo.png" alt="CultureFrame" class="w-9 h-9 object-contain" />
        <div>
          <p class="text-base font-bold text-gray-800 leading-none">CultureFrame</p>
          <p class="text-[10px] text-emerald-600 leading-none mt-0.5">Mansalay</p>
        </div>
      </a>
      <div class="flex items-center gap-4">
        <a href="/cart" class="relative text-gray-500 hover:text-emerald-600 transition-colors">
          <i class="fas fa-shopping-cart text-lg"></i>
          {{#if cart.length}}
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-[10px] rounded-full w-4 h-4 flex items-center justify-center">{{cart.length}}</span>
          {{/if}}
        </a>
        <a href="{{#if referer}}{{referer}}{{else}}/shop{{/if}}" class="text-sm text-emerald-600 hover:text-emerald-800 font-medium flex items-center gap-1 transition-colors">
          <i class="fas fa-arrow-left text-xs"></i> Back
        </a>
      </div>
    </div>
  </nav>

  <div class="max-w-6xl mx-auto px-4 py-8">

    <!-- Progress bar -->
    <div class="flex items-center justify-center mb-8 fade-up">
      <div class="progress-step">
        <div class="progress-circle bg-emerald-600 text-white"><i class="fas fa-check text-xs"></i></div>
        <span class="text-sm font-semibold text-emerald-600">Cart</span>
      </div>
      <div class="progress-line bg-emerald-500 mx-2"></div>
      <div class="progress-step">
        <div class="progress-circle bg-emerald-600 text-white font-bold text-sm">2</div>
        <span class="text-sm font-bold text-emerald-700">Checkout</span>
      </div>
      <div class="progress-line bg-gray-200 mx-2"></div>
      <div class="progress-step">
        <div class="progress-circle bg-gray-200 text-gray-400 text-sm">3</div>
        <span class="text-sm text-gray-400">Complete</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

      <!-- ── LEFT COLUMN ── -->
      <div class="lg:col-span-2 space-y-5">

        <!-- 1. Shipping Address -->
        <div class="card fade-up">
          <div class="card-header">
            <div class="step-badge">1</div>
            <h2 class="font-bold text-gray-800">Shipping Address</h2>
          </div>
          <div class="p-5">
            <form id="addressForm" class="space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">Full Name *</label>
                  <input type="text" name="customer_name" required
                    class="input-field" placeholder="Juan dela Cruz"
                    value="{{customer_name}}" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">Phone Number *</label>
                  <input type="tel" name="customer_phone" required
                    class="input-field" placeholder="+63 9XX XXX XXXX"
                    value="{{customer_phone}}" />
                </div>
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">Email Address *</label>
                <input type="email" name="customer_email" required
                  class="input-field" placeholder="juan@email.com"
                  value="{{customer_email}}" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">Complete Address *</label>
                <textarea name="shipping_address" required rows="3"
                  class="input-field resize-none"
                  placeholder="House No., Street, Barangay">{{shipping_address}}</textarea>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">City / Municipality</label>
                  <input type="text" name="city" class="input-field" placeholder="Mansalay" value="{{city}}" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">Province</label>
                  <input type="text" name="province" class="input-field" placeholder="Oriental Mindoro" value="{{province}}" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wide">ZIP Code</label>
                  <input type="text" name="zip_code" class="input-field" placeholder="5210" value="{{zip_code}}" />
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- 2. Shipping Method -->
        <div class="card fade-up-2">
          <div class="card-header">
            <div class="step-badge">2</div>
            <h2 class="font-bold text-gray-800">Shipping Method</h2>
          </div>
          <div class="p-5 space-y-3">
            <label class="shipping-card selected" id="ship-standard">
              <div class="flex items-center gap-3">
                <input type="radio" name="shipping_method" value="standard" checked class="accent-emerald-600" />
                <div>
                  <div class="font-semibold text-gray-800 text-sm flex items-center gap-2">
                    <i class="fas fa-truck text-emerald-600"></i> Standard Delivery
                  </div>
                  <div class="text-xs text-gray-500 mt-0.5">3–7 business days</div>
                </div>
              </div>
              <span class="text-emerald-600 font-bold text-sm bg-emerald-50 px-2 py-0.5 rounded-full">FREE</span>
            </label>
            <label class="shipping-card" id="ship-express">
              <div class="flex items-center gap-3">
                <input type="radio" name="shipping_method" value="express" class="accent-emerald-600" />
                <div>
                  <div class="font-semibold text-gray-800 text-sm flex items-center gap-2">
                    <i class="fas fa-bolt text-yellow-500"></i> Express Delivery
                  </div>
                  <div class="text-xs text-gray-500 mt-0.5">1–2 business days</div>
                </div>
              </div>
              <span class="text-gray-700 font-bold text-sm">₱50</span>
            </label>
          </div>
        </div>

        <!-- 3. Payment Method -->
        <div class="card fade-up-3">
          <div class="card-header">
            <div class="step-badge">3</div>
            <h2 class="font-bold text-gray-800">Payment Method</h2>
          </div>
          <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="payment-card selected">
              <input type="radio" name="payment_method" value="cash_on_delivery" checked />
              <div>
                <div class="font-semibold text-gray-800 text-sm">💰 Cash on Delivery</div>
                <div class="text-xs text-gray-500">Pay when item arrives</div>
              </div>
            </label>
            <label class="payment-card">
              <input type="radio" name="payment_method" value="gcash" />
              <div>
                <div class="font-semibold text-gray-800 text-sm">📱 GCash</div>
                <div class="text-xs text-gray-500">Pay via GCash app</div>
              </div>
            </label>
            <label class="payment-card">
              <input type="radio" name="payment_method" value="bank_transfer" />
              <div>
                <div class="font-semibold text-gray-800 text-sm">🏦 Bank Transfer</div>
                <div class="text-xs text-gray-500">BPI, BDO, Metrobank</div>
              </div>
            </label>
            <label class="payment-card">
              <input type="radio" name="payment_method" value="credit_card" />
              <div>
                <div class="font-semibold text-gray-800 text-sm">💳 Credit / Debit Card</div>
                <div class="text-xs text-gray-500">Visa, Mastercard</div>
              </div>
            </label>
          </div>
        </div>

        <!-- 4. Order Items -->
        <div class="card fade-up-4">
          <div class="card-header">
            <div class="step-badge">4</div>
            <h2 class="font-bold text-gray-800">Order Items</h2>
            <span class="ml-auto text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">{{cart.length}} item(s)</span>
          </div>
          <div class="p-5 space-y-3">
            {{#each cart}}
            <div class="flex items-center gap-4 p-3 rounded-xl border border-emerald-50 hover:border-emerald-200 hover:bg-emerald-50/40 transition-all checkout-item"
                 data-product-id="{{this.product_id}}" data-price="{{this.price}}">
              <img src="{{this.image_url}}" alt="{{this.name}}" class="product-img"
                   onerror="this.src='/images/logo.png'" />
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-gray-800 text-sm leading-snug truncate">{{this.name}}</p>
                <p class="text-xs text-emerald-600 font-medium mt-0.5">₱{{this.price}} each</p>
                <div class="flex items-center gap-2 mt-2">
                  <button type="button" class="qty-btn qty-decrease" data-product-id="{{this.product_id}}">
                    <i class="fas fa-minus" style="font-size:10px"></i>
                  </button>
                  <input type="number" value="{{this.quantity}}" min="1" max="99" readonly
                         class="qty-input w-10 text-center text-sm font-bold border border-emerald-100 rounded-lg py-0.5 bg-white"
                         data-product-id="{{this.product_id}}" />
                  <button type="button" class="qty-btn qty-increase" data-product-id="{{this.product_id}}">
                    <i class="fas fa-plus" style="font-size:10px"></i>
                  </button>
                </div>
              </div>
              <div class="text-right shrink-0">
                <p class="font-bold text-emerald-700 text-base item-total">₱{{this.total}}</p>
              </div>
            </div>
            {{/each}}
          </div>
        </div>

      </div><!-- end left column -->

      <!-- ── RIGHT COLUMN — Order Summary ── -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-[72px] space-y-4">

          <!-- Summary card -->
          <div class="card fade-up">
            <div class="card-header">
              <i class="fas fa-receipt text-emerald-600"></i>
              <h3 class="font-bold text-gray-800">Order Summary</h3>
            </div>
            <div class="p-5 space-y-3">
              <div class="flex justify-between text-sm text-gray-600">
                <span>Subtotal ({{cart.length}} items)</span>
                <span class="font-medium text-gray-800" id="subtotal">₱{{cartTotal}}</span>
              </div>
              <div class="flex justify-between text-sm text-gray-600">
                <span>Shipping Fee</span>
                <span class="text-emerald-600 font-semibold" id="shippingDisplay">FREE</span>
              </div>
              <div class="flex justify-between text-sm text-gray-600">
                <span>Service Fee</span>
                <span class="font-medium text-gray-800">₱0</span>
              </div>
              <div class="flex justify-between text-sm text-gray-500">
                <span>Voucher Discount</span>
                <span class="text-red-500 font-medium">- ₱0</span>
              </div>
              <div class="border-t border-emerald-100 pt-3 flex justify-between items-center">
                <span class="font-bold text-gray-800">Total Payment</span>
                <span class="text-2xl font-extrabold text-emerald-600" id="totalAmount">₱{{cartTotal}}</span>
              </div>
            </div>

            <!-- Voucher -->
            <div class="px-5 pb-4">
              <div class="flex gap-2">
                <input type="text" id="voucherInput" placeholder="Voucher code"
                  class="input-field flex-1 text-xs py-2" />
                <button type="button" onclick="applyVoucher()"
                  class="text-xs px-3 py-2 rounded-xl bg-emerald-100 text-emerald-700 font-semibold hover:bg-emerald-200 transition-colors whitespace-nowrap">
                  Apply
                </button>
              </div>
            </div>

            <!-- Place Order form -->
            <div class="px-5 pb-5">
              <form method="POST" action="/order/create" id="checkoutForm">
                <input type="hidden" name="cart_items" value='{{{serverCartJSON}}}'>
                <input type="hidden" name="total_amount" id="hiddenTotal" value="{{cartTotal}}">
                <input type="hidden" name="customer_name" id="finalCustomerName">
                <input type="hidden" name="customer_email" id="finalCustomerEmail">
                <input type="hidden" name="customer_phone" id="finalCustomerPhone">
                <input type="hidden" name="shipping_address" id="finalShippingAddress">
                <input type="hidden" name="payment_method" id="finalPaymentMethod">
                <button type="submit" class="order-btn" id="placeOrderBtn">
                  <i class="fas fa-lock mr-2"></i>Place Order Securely
                </button>
              </form>
            </div>
          </div>

          <!-- Trust badges -->
          <div class="card p-4">
            <div class="grid grid-cols-3 gap-2">
              <div class="trust-badge">
                <div class="icon"><i class="fas fa-shield-alt"></i></div>
                <span>Secure Pay</span>
              </div>
              <div class="trust-badge">
                <div class="icon"><i class="fas fa-truck"></i></div>
                <span>Free Shipping</span>
              </div>
              <div class="trust-badge">
                <div class="icon"><i class="fas fa-undo"></i></div>
                <span>7-Day Return</span>
              </div>
            </div>
          </div>

        </div>
      </div><!-- end right column -->

    </div>
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', () => {
    const checkoutForm = document.getElementById('checkoutForm');
    const addressForm  = document.getElementById('addressForm');
    const placeBtn     = document.getElementById('placeOrderBtn');
    let shippingFee    = 0;

    // ── Quantity Controls ──────────────────────────
    document.querySelectorAll('.qty-decrease').forEach(btn => {
      btn.addEventListener('click', () => {
        const pid   = btn.dataset.productId;
        const input = document.querySelector(`.qty-input[data-product-id="${pid}"]`);
        if (parseInt(input.value) > 1) {
          input.value = parseInt(input.value) - 1;
          updateItemTotal(pid);
          updateCartTotal();
          syncCartJSON();
        }
      });
    });

    document.querySelectorAll('.qty-increase').forEach(btn => {
      btn.addEventListener('click', () => {
        const pid   = btn.dataset.productId;
        const input = document.querySelector(`.qty-input[data-product-id="${pid}"]`);
        if (parseInt(input.value) < 99) {
          input.value = parseInt(input.value) + 1;
          updateItemTotal(pid);
          updateCartTotal();
          syncCartJSON();
        }
      });
    });

    function updateItemTotal(pid) {
      const item  = document.querySelector(`.checkout-item[data-product-id="${pid}"]`);
      const price = parseFloat(item.dataset.price);
      const qty   = parseInt(item.querySelector('.qty-input').value);
      item.querySelector('.item-total').textContent = '₱' + (price * qty).toFixed(2);
    }

    function updateCartTotal() {
      let sub = 0;
      document.querySelectorAll('.checkout-item').forEach(item => {
        sub += parseFloat(item.dataset.price) * parseInt(item.querySelector('.qty-input').value);
      });
      const total = sub + shippingFee;
      document.getElementById('subtotal').textContent    = '₱' + sub.toFixed(2);
      document.getElementById('totalAmount').textContent = '₱' + total.toFixed(2);
      document.getElementById('hiddenTotal').value       = total.toFixed(2);
    }

    function syncCartJSON() {
      const items = [];
      document.querySelectorAll('.checkout-item').forEach(item => {
        items.push({
          product_id: item.dataset.productId,
          name:       item.querySelector('p.font-semibold').textContent.trim(),
          price:      parseFloat(item.dataset.price),
          quantity:   parseInt(item.querySelector('.qty-input').value)
        });
      });
      document.querySelector('input[name="cart_items"]').value = JSON.stringify(items);
    }

    // ── Shipping method toggle ──────────────────────
    document.querySelectorAll('input[name="shipping_method"]').forEach(r => {
      r.addEventListener('change', () => {
        document.querySelectorAll('.shipping-card').forEach(c => c.classList.remove('selected'));
        r.closest('.shipping-card').classList.add('selected');
        shippingFee = r.value === 'express' ? 50 : 0;
        document.getElementById('shippingDisplay').textContent = shippingFee === 0 ? 'FREE' : '₱50';
        updateCartTotal();
      });
    });

    // ── Payment method toggle ───────────────────────
    document.querySelectorAll('input[name="payment_method"]').forEach(r => {
      r.addEventListener('change', () => {
        document.querySelectorAll('.payment-card').forEach(c => c.classList.remove('selected'));
        r.closest('.payment-card').classList.add('selected');
      });
    });

    // ── Form submit ─────────────────────────────────
    checkoutForm.addEventListener('submit', e => {
      e.preventDefault();

      const name    = addressForm.querySelector('[name="customer_name"]').value.trim();
      const email   = addressForm.querySelector('[name="customer_email"]').value.trim();
      const phone   = addressForm.querySelector('[name="customer_phone"]').value.trim();
      const addr    = addressForm.querySelector('[name="shipping_address"]').value.trim();
      const city    = addressForm.querySelector('[name="city"]').value.trim();
      const prov    = addressForm.querySelector('[name="province"]').value.trim();
      const zip     = addressForm.querySelector('[name="zip_code"]').value.trim();
      const payment = document.querySelector('input[name="payment_method"]:checked').value;

      if (!name || !email || !phone || !addr) {
        showToast('Please fill in all required fields.', 'error');
        return;
      }

      const fullAddr = [addr, city, prov, zip].filter(Boolean).join(', ');

      document.getElementById('finalCustomerName').value    = name;
      document.getElementById('finalCustomerEmail').value   = email;
      document.getElementById('finalCustomerPhone').value   = phone;
      document.getElementById('finalShippingAddress').value = fullAddr;
      document.getElementById('finalPaymentMethod').value   = payment;

      placeBtn.innerHTML  = '<i class="fas fa-spinner fa-spin mr-2"></i>Processing...';
      placeBtn.disabled   = true;
      checkoutForm.submit();
    });
  });

  // ── Toast notification ──────────────────────────────
  function showToast(msg, type = 'info') {
    const t = document.createElement('div');
    t.className = `fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-5 py-3 rounded-xl shadow-lg text-sm font-semibold text-white transition-all
      ${type === 'error' ? 'bg-red-500' : 'bg-emerald-600'}`;
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3000);
  }

  // ── Voucher (placeholder) ───────────────────────────
  function applyVoucher() {
    const code = document.getElementById('voucherInput').value.trim();
    if (!code) return showToast('Enter a voucher code first.', 'error');
    showToast('Voucher "' + code + '" is not valid.', 'error');
  }
  </script>

  {{>footer}}
</body>
</html>
