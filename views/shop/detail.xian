{{>head}}
<body class="min-h-screen bg-cover bg-center bg-fixed" style="background-image: url('https://images.unsplash.com/photo-1586773860418-d37222d8fce3?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2073&q=80');">
  <!-- Green gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-emerald-400/20 via-green-300/30 to-lime-200/40 z-0"></div>
  
  <div class="relative z-10">
    {{>nav}}
    {{>messages}}
 
    {{>shopHeader}}

    <div class="container mx-auto px-4 py-8">
      <a href="/shop" class="text-emerald-600 hover:text-emerald-700 font-semibold mb-4 inline-block transition duration-200">
        ← Back to Shop
      </a>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Product Image -->
        <div class="bg-white/95 backdrop-blur-sm rounded-xl shadow-lg p-6 border border-emerald-100">
          <img src="{{product.image_url}}" alt="{{product.name}}" class="w-full rounded-lg shadow-md">
        </div>
        
        <!-- Product Details -->
        <div class="bg-white/95 backdrop-blur-sm rounded-xl shadow-lg p-6 border border-emerald-100">
          <span class="inline-block bg-gradient-to-r from-emerald-100 to-green-100 text-emerald-700 px-3 py-1 rounded-full mb-4 text-sm font-semibold border border-emerald-200">
            {{product.category}}
          </span>
          <h1 class="text-4xl font-bold text-emerald-800 mb-4">{{product.name}}</h1>
          <p class="text-3xl font-bold text-emerald-600 mb-4">₱{{product.price}}</p>
          
          <!-- Stock Status -->
          <div class="flex items-center mb-4">
            {{#if product.stocks}}
            <span class="inline-flex items-center bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full text-sm font-semibold">
              <span class="w-2 h-2 bg-emerald-500 rounded-full mr-2"></span>
              In Stock: {{product.stocks}} units
            </span>
            {{else}}
            <span class="inline-flex items-center bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-semibold">
              <span class="w-2 h-2 bg-red-500 rounded-full mr-2"></span>
              Out of Stock
            </span>
            {{/if}}
          </div>
          
          <p class="text-gray-700 mb-6 leading-relaxed text-lg">{{product.description}}</p>
          
          <!-- Add to Cart Form -->
          <form method="POST" action="/cart/add">
            <div class="flex items-center space-x-4 mb-6">
              <label class="font-bold text-emerald-700">Quantity:</label>
              <input type="number" 
                     name="quantity" 
                     min="1" 
                     max="{{product.stocks}}" 
                     value="1" 
                     class="w-20 p-2 border border-emerald-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
            </div>
            <input type="hidden" name="product_id" value="{{product.id}}">
            
            {{#if user.isAuthenticated}}
              <div class="flex space-x-3">
                <button type="submit" 
                        name="action" 
                        value="add" 
                        class="flex-1 bg-gradient-to-r from-emerald-600 to-green-700 hover:from-emerald-700 hover:to-green-800 text-white px-8 py-3 rounded-lg text-lg font-semibold transition duration-200 shadow-lg">
                  🛒 Add to Cart
                </button>
                <button type="submit" 
                        name="action" 
                        value="checkout" 
                        class="flex-1 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white px-8 py-3 rounded-lg text-lg font-semibold transition duration-200 shadow-lg">
                  ⚡ Buy Now
                </button>
                <button formaction="/wishlist/add" 
                        formmethod="post" 
                        title="Add to wishlist" 
                        class="flex items-center justify-center w-12 h-12 rounded-lg bg-white border border-emerald-300 hover:bg-rose-50 hover:border-rose-300 transition duration-200 shadow" 
                        aria-label="Add to wishlist">
                  <svg class="w-6 h-6 text-rose-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 21s-7-4.35-9-6.5C1.5 11.75 3 7 7 6.25 9.5 5.75 12 8 12 8s2.5-2.25 5-1.75c4 .75 5.5 5.5 4 8.25C19 16.65 12 21 12 21z"></path>
                  </svg>
                </button>
              </div>
            {{else}}
              {{#if user.user}}
                <div class="flex space-x-3">
                  <button type="submit" 
                          name="action" 
                          value="add" 
                          class="flex-1 bg-gradient-to-r from-emerald-600 to-green-700 hover:from-emerald-700 hover:to-green-800 text-white px-8 py-3 rounded-lg text-lg font-semibold transition duration-200 shadow-lg">
                    🛒 Add to Cart
                  </button>
                  <button type="submit" 
                          name="action" 
                          value="checkout" 
                          class="flex-1 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white px-8 py-3 rounded-lg text-lg font-semibold transition duration-200 shadow-lg">
                    ⚡ Buy Now
                  </button>
                  <button formaction="/wishlist/add" 
                          formmethod="post" 
                          title="Add to wishlist" 
                          class="flex items-center justify-center w-12 h-12 rounded-lg bg-white border border-emerald-300 hover:bg-rose-50 hover:border-rose-300 transition duration-200 shadow" 
                          aria-label="Add to wishlist">
                    <svg class="w-6 h-6 text-rose-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 21s-7-4.35-9-6.5C1.5 11.75 3 7 7 6.25 9.5 5.75 12 8 12 8s2.5-2.25 5-1.75c4 .75 5.5 5.5 4 8.25C19 16.65 12 21 12 21z"></path>
                    </svg>
                  </button>
                </div>
              {{else}}
                <a href="/login" 
                   class="block text-center bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-6 py-3 rounded-lg font-semibold transition duration-200 shadow-lg">
                  🔐 Login to Add to Cart
                </a>
              {{/if}}
            {{/if}}
          </form>

          <!-- Additional Info -->
          <div class="mt-8 pt-6 border-t border-emerald-200">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
              <div class="p-3 bg-emerald-50 rounded-lg">
                <div class="text-2xl mb-1">🚚</div>
                <p class="text-sm text-emerald-700 font-semibold">Free Shipping</p>
              </div>
              <div class="p-3 bg-emerald-50 rounded-lg">
                <div class="text-2xl mb-1">↩️</div>
                <p class="text-sm text-emerald-700 font-semibold">Easy Returns</p>
              </div>
              <div class="p-3 bg-emerald-50 rounded-lg">
                <div class="text-2xl mb-1">🔒</div>
                <p class="text-sm text-emerald-700 font-semibold">Secure Payment</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {{>quickview}}
    {{>footer}}
  </div>

  <style>
    /* Smooth animations */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .container {
      animation: fadeIn 0.6s ease-out;
    }
    
    /* Button hover effects */
    button, a {
      transition: all 0.2s ease-in-out;
    }
    
    button:hover, a:hover {
      transform: translateY(-2px);
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Add to cart/wishlist animations
      const forms = document.querySelectorAll('form');
      forms.forEach(form => {
        form.addEventListener('submit', function(e) {
          const button = this.querySelector('button[type="submit"]');
          if (button) {
            button.classList.add('transform', 'scale-95');
            setTimeout(() => {
              button.classList.remove('transform', 'scale-95');
            }, 150);
          }
        });
      });

      // Quantity input validation
      const quantityInput = document.querySelector('input[name="quantity"]');
      if (quantityInput) {
        quantityInput.addEventListener('change', function() {
          const max = parseInt(this.max);
          const value = parseInt(this.value);
          if (value > max) {
            this.value = max;
          } else if (value < 1) {
            this.value = 1;
          }
        });
      }
    });
  </script>
</body>
</html>