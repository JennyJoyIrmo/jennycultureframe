{{>head}}
<body class="min-h-screen bg-cover bg-center bg-fixed" style="background-image: url('https://images.unsplash.com/photo-1586773860418-d37222d8fce3?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2073&q=80');">
  <!-- Green gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-emerald-400/20 via-green-300/30 to-lime-200/40 z-0"></div>
  
  <div class="relative z-10">
    {{>nav}}

    <div class="container mx-auto px-4 py-8">
      <!-- Enhanced Header -->
      <div class="bg-white/90 backdrop-blur-sm rounded-xl shadow-lg p-6 mb-8 border border-emerald-100">
        <h2 class="text-4xl font-bold text-emerald-800 text-center mb-2">❤️ My Wishlist</h2>
        <p class="text-emerald-600 text-center">Your saved favorite items</p>
      </div>

      {{#if wishlist.length}}
        <!-- Wishlist Items Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
          {{#each wishlist}}
          <div class="bg-white/95 backdrop-blur-sm rounded-xl shadow-lg overflow-hidden border border-emerald-100 hover:shadow-xl transition duration-300 transform hover:-translate-y-1">
            <!-- Product Image -->
            <div class="relative h-48 bg-gray-100 overflow-hidden">
              {{#if this.image_url}}
                <img src="{{this.image_url}}" alt="{{this.name}}" class="w-full h-full object-cover hover:scale-110 transition-transform duration-300">
              {{else}}
                <div class="w-full h-full flex items-center justify-center bg-emerald-50">
                  <span class="text-6xl">📦</span>
                </div>
              {{/if}}
              <div class="absolute top-3 right-3 bg-pink-500 text-white p-2 rounded-full shadow-lg">
                <i class="fas fa-heart"></i>
              </div>
            </div>

            <!-- Product Info -->
            <div class="p-6">
              <h3 class="font-bold text-lg text-emerald-800 mb-2 line-clamp-2">{{this.name}}</h3>
              <p class="text-2xl font-bold text-emerald-700 mb-3">₱{{this.price}}</p>
              {{#if this.stocks}}
              <span class="inline-block bg-emerald-100 text-emerald-700 text-xs px-3 py-1 rounded-full font-semibold">
                ✅ In Stock
              </span>
              {{else}}
              <span class="inline-block bg-red-100 text-red-700 text-xs px-3 py-1 rounded-full font-semibold">
                ❌ Out of Stock
              </span>
              {{/if}}
              
              <div class="flex space-x-3 mt-4">
                <a href="/shop/product/{{this.product_id}}" 
                   class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white text-center py-2 px-4 rounded-lg transition duration-200 font-semibold">
                  View Details
                </a>
                <form method="POST" action="/wishlist/remove" class="flex-1">
                  <input type="hidden" name="product_id" value="{{this.product_id}}">
                  <button type="submit" 
                          class="w-full bg-red-500 hover:bg-red-600 text-white py-2 px-4 rounded-lg transition duration-200 font-semibold">
                    Remove
                  </button>
                </form>
              </div>

              <!-- Quick Add to Cart -->
              {{#if this.stocks}}
              <form method="POST" action="/cart/add" class="mt-3">
                <input type="hidden" name="product_id" value="{{this.product_id}}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" 
                        class="w-full bg-gray-800 hover:bg-gray-900 text-white py-2 px-4 rounded-lg transition duration-200 font-semibold">
                  🛒 Add to Cart
                </button>
              </form>
              {{/if}}
            </div>
          </div>
          {{/each}}
        </div>

        <!-- Wishlist Summary -->
        <div class="bg-gradient-to-r from-emerald-50 to-green-50 rounded-xl p-6 border border-emerald-200">
          <div class="flex justify-between items-center">
            <div>
              <h3 class="text-xl font-bold text-emerald-800 mb-2">Wishlist Summary</h3>
              <p class="text-emerald-600">{{wishlist.length}} item(s) in your wishlist</p>
            </div>
            <a href="/shop" 
               class="bg-gradient-to-r from-emerald-600 to-green-700 hover:from-emerald-700 hover:to-green-800 text-white px-6 py-3 rounded-lg transition duration-200 font-semibold">
              Continue Shopping →
            </a>
          </div>
        </div>

      {{else}}
        <!-- Empty Wishlist State -->
        <div class="bg-white/95 backdrop-blur-sm rounded-xl shadow-lg p-12 text-center border border-emerald-100">
          <div class="text-6xl mb-6">❤️</div>
          <h3 class="text-2xl font-bold text-emerald-800 mb-4">Your wishlist is empty</h3>
          <p class="text-emerald-600 mb-8 max-w-md mx-auto">
            Save your favorite products here to easily find them later. Start exploring our collection!
          </p>
          <div class="space-x-4">
            <a href="/shop" 
               class="bg-gradient-to-r from-emerald-600 to-green-700 hover:from-emerald-700 hover:to-green-800 text-white px-8 py-4 rounded-lg transition duration-200 font-semibold text-lg inline-flex items-center">
              <span class="mr-2">🌿</span>
              Explore Products
            </a>
          </div>
        </div>

        <!-- Suggested Products -->
        <div class="mt-12 bg-white/90 backdrop-blur-sm rounded-xl p-6 border border-emerald-200">
          <h3 class="text-xl font-bold text-emerald-800 mb-6 text-center">Popular Products You Might Like</h3>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            {{#each suggestedProducts}}
            <div class="bg-gradient-to-br from-white to-emerald-50 rounded-lg p-4 text-center border border-emerald-200 hover:shadow-md transition duration-200">
              <div class="w-16 h-16 bg-emerald-100 rounded-lg mx-auto mb-3 flex items-center justify-center">
                <span class="text-2xl">📦</span>
              </div>
              <h4 class="font-semibold text-emerald-700 mb-2">{{this.name}}</h4>
              <p class="text-lg font-bold text-emerald-800 mb-3">₱{{this.price}}</p>
              <a href="/shop/product/{{this.id}}" 
                 class="bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-2 rounded-lg text-sm transition duration-200">
                View Details
              </a>
            </div>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </div>

    {{>footer}}
  </div>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

  <style>
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Smooth animations */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .container {
      animation: fadeIn 0.6s ease-out;
    }
    
    /* Heart animation for wishlist */
    @keyframes heartBeat {
      0% { transform: scale(1); }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }
    .text-6xl {
      animation: heartBeat 2s ease-in-out infinite;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Add smooth animations to buttons
      const buttons = document.querySelectorAll('button, a');
      buttons.forEach(button => {
        button.addEventListener('click', function(e) {
          if (this.type !== 'submit' && this.href) {
            this.classList.add('transform', 'scale-95');
            setTimeout(() => {
              this.classList.remove('transform', 'scale-95');
            }, 150);
          }
        });
      });

      // Add to cart animation
      const addToCartForms = document.querySelectorAll('form[action="/cart/add"]');
      addToCartForms.forEach(form => {
        form.addEventListener('submit', function() {
          const button = this.querySelector('button');
          button.innerHTML = '✅ Added!';
          setTimeout(() => {
            button.innerHTML = '🛒 Add to Cart';
          }, 2000);
        });
      });
    });
  </script>
</body>
</html>