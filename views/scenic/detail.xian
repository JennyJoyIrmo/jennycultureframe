{{>head}}
<body class="min-h-screen bg-cover bg-center bg-fixed" style="background-image: url('https://travelorientalmindoro.ph/Content/img/uploads/mansalay_1.jpg');">
  <div class="absolute inset-0 bg-white/5 z-0"></div>
  
  <div class="relative z-10">
    {{>nav}}
    
    <!-- Hero Image Section -->
    <div class="relative h-96 bg-gradient-to-br from-emerald-600 via-green-600 to-teal-600 overflow-hidden">
      {{#if scenic.image_url}}
        <img src="{{scenic.image_url}}" alt="{{scenic.title}}" class="w-full h-full object-cover opacity-40" />
      {{/if}}
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
      
      <div class="absolute bottom-0 left-0 right-0 container mx-auto px-6 pb-12">
        <a href="/scenic" class="inline-flex items-center text-white/90 hover:text-white font-medium mb-6 transition-colors bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Scenic Spots
        </a>
        
        <h1 class="text-5xl font-bold text-white mb-4 drop-shadow-lg">{{scenic.title}}</h1>
        <div class="flex items-center text-white/95 text-lg">
          <svg class="w-6 h-6 text-emerald-300 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span class="drop-shadow">{{scenic.location}}</span>
        </div>
      </div>
    </div>
    
    <div class="container mx-auto px-6 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Description Card -->
          <div class="bg-white rounded-2xl shadow-lg p-8 border border-emerald-100">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-green-500 rounded-xl flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-gray-800">About This Location</h2>
            </div>
            
            <div class="prose max-w-none">
              <p class="text-gray-700 text-lg leading-relaxed">{{scenic.description}}</p>
            </div>
          </div>

          <!-- Full Image Card -->
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-emerald-100">
            <div class="bg-gradient-to-r from-emerald-600 to-green-600 p-4">
              <h3 class="text-white font-bold text-lg flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Gallery
              </h3>
            </div>
            {{#if scenic.image_url}}
              <img src="{{scenic.image_url}}" alt="{{scenic.title}}" class="w-full h-[500px] object-cover hover:scale-105 transition-transform duration-500" />
            {{else}}
              <div class="w-full h-[500px] bg-gradient-to-br from-emerald-400 via-green-400 to-teal-400 flex items-center justify-center">
                <div class="text-center">
                  <svg class="w-32 h-32 text-white/40 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <p class="text-white/60 text-lg">No image available</p>
                </div>
              </div>
            {{/if}}
          </div>

          <!-- Coordinates Card -->
          <div class="bg-white rounded-2xl shadow-lg p-6 border border-emerald-100">
            <div class="flex items-center mb-4">
              <div class="w-8 h-8 bg-gradient-to-br from-emerald-500 to-green-500 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-800">GPS Coordinates</h3>
            </div>
            
            <div class="bg-gradient-to-br from-emerald-50 to-green-50 rounded-lg p-4 border border-emerald-200">
              <div class="grid grid-cols-2 gap-3 mb-3">
                <div class="bg-white rounded-lg p-3 shadow-sm">
                  <p class="text-xs text-gray-600 mb-1 font-medium">Latitude</p>
                  <p class="font-mono text-sm font-bold text-emerald-700">{{scenic.latitude}}</p>
                </div>
                <div class="bg-white rounded-lg p-3 shadow-sm">
                  <p class="text-xs text-gray-600 mb-1 font-medium">Longitude</p>
                  <p class="font-mono text-sm font-bold text-green-700">{{scenic.longitude}}</p>
                </div>
              </div>
              
              <a href="https://www.google.com/maps?q={{scenic.latitude}},{{scenic.longitude}}" target="_blank" 
                 class="inline-flex items-center text-emerald-600 hover:text-emerald-700 font-semibold text-sm transition-colors">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
                Open in Google Maps
              </a>
              
              <!-- Barangay Info Display -->
              <div id="barangay-info" class="mt-4">
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 animate-pulse">
                  <p class="text-sm text-gray-500">🔍 Detecting barangay location...</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar with Map -->
        <div class="lg:col-span-1 space-y-6">
          <div class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-lg overflow-hidden border border-emerald-100 sticky top-24">
            <!-- Map Header -->
            <div class="bg-gradient-to-r from-emerald-600 to-green-600 p-5">
              <h3 class="text-white font-bold text-lg flex items-center">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                </svg>
                Interactive Map
              </h3>
              <p class="text-emerald-100 text-sm mt-1">Explore the exact location</p>
            </div>
            
            <!-- Map Container -->
            <div id="map-detail" class="w-full h-96"></div>
            
            <!-- Map Footer -->
            <div class="p-5 bg-gradient-to-br from-emerald-50 to-green-50 border-t-2 border-emerald-200">
              <div class="flex items-start space-x-3">
                <svg class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="text-sm text-gray-700 font-medium">Interactive Controls</p>
                  <p class="text-xs text-gray-600 mt-1">Click and drag to pan, scroll to zoom</p>
                </div>
              </div>
            </div>
          </div>


        </div>
      </div>
    </div>
  </div>

  <!-- Leaflet CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  
  <script>
    (function(){
      try {
        var lat = parseFloat('{{scenic.latitude}}');
        var lng = parseFloat('{{scenic.longitude}}');
        var defaultCenter = [12.5833, 121.4500]; // Mansalay center
        
        // Initialize map with better options
        var map = L.map('map-detail', {
          zoomControl: true,
          scrollWheelZoom: true,
          dragging: true,
          touchZoom: true,
          doubleClickZoom: true
        }).setView(
          isNaN(lat) || isNaN(lng) ? defaultCenter : [lat, lng], 
          isNaN(lat) || isNaN(lng) ? 12 : 16
        );
        
        // Add tile layer with better styling
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { 
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          maxZoom: 19,
          minZoom: 10
        }).addTo(map);
        
        // Add custom marker if coordinates exist
        if (!isNaN(lat) && !isNaN(lng)) {
          var customIcon = L.divIcon({
            className: 'custom-marker',
            html: '<div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); width: 48px; height: 48px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); border: 4px solid white; box-shadow: 0 6px 12px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center;"><div style="transform: rotate(45deg); color: white; font-size: 24px; margin-top: -4px;">📍</div></div>',
            iconSize: [48, 48],
            iconAnchor: [24, 48],
            popupAnchor: [0, -48]
          });
          
          var marker = L.marker([lat, lng], { icon: customIcon }).addTo(map);
          
          // Fetch detailed location information using reverse geocoding
          fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`)
            .then(response => response.json())
            .then(data => {
              console.log('🗺️ Geocoding data:', data);
              
              var address = data.address || {};
              
              // Try to detect sitio/purok (smallest subdivision)
              var sitio = address.hamlet || address.isolated_dwelling || address.locality || '';
              
              // Detect barangay (village level)
              var barangay = address.village || address.suburb || address.neighbourhood || address.quarter || 'Unknown Barangay';
              
              // Municipality
              var municipality = address.municipality || address.city || address.town || 'Mansalay';
              
              // Province
              var province = address.state || address.province || 'Oriental Mindoro';
              
              // Build detailed location string
              var locationParts = [];
              if (sitio) locationParts.push('Sitio ' + sitio);
              locationParts.push('Brgy. ' + barangay);
              locationParts.push(municipality);
              locationParts.push(province);
              
              var fullLocation = locationParts.join(', ');
              
              console.log('📍 Detected location:', {
                sitio: sitio,
                barangay: barangay,
                municipality: municipality,
                province: province,
                full: fullLocation
              });
              
              var popupContent = `
                <div style="text-align: center; padding: 16px; min-width: 280px;">
                  <strong style="color: #059669; font-size: 20px; display: block; margin-bottom: 12px;">{{scenic.title}}</strong>
                  <div style="text-align: left; background: #f0fdf4; padding: 12px; border-radius: 8px; margin-bottom: 8px;">
                    ${sitio ? `
                    <div style="color: #064e3b; font-size: 14px; margin-bottom: 6px; display: flex; align-items: center;">
                      <svg style="width: 16px; height: 16px; margin-right: 6px; flex-shrink: 0;" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                      </svg>
                      <strong>Sitio:</strong> <span style="margin-left: 4px;">${sitio}</span>
                    </div>
                    ` : ''}
                    <div style="color: #064e3b; font-size: 14px; margin-bottom: 6px; display: flex; align-items: center;">
                      <svg style="width: 16px; height: 16px; margin-right: 6px; flex-shrink: 0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      </svg>
                      <strong>Barangay:</strong> <span style="margin-left: 4px;">${barangay}</span>
                    </div>
                    <div style="color: #065f46; font-size: 13px; margin-bottom: 4px; padding-left: 22px;">
                      <strong>Municipality:</strong> ${municipality}
                    </div>
                    <div style="color: #047857; font-size: 13px; padding-left: 22px;">
                      <strong>Province:</strong> ${province}
                    </div>
                  </div>
                  <div style="color: #64748b; font-size: 12px; margin-top: 8px;">
                    📍 ${lat.toFixed(6)}, ${lng.toFixed(6)}
                  </div>
                </div>
              `;
              
              marker.bindPopup(popupContent, {
                maxWidth: 300,
                className: 'custom-popup'
              }).openPopup();
              
              // Update location display on page if element exists
              var locationDisplay = document.getElementById('barangay-info');
              if (locationDisplay) {
                locationDisplay.innerHTML = `
                  <div class="bg-gradient-to-r from-emerald-50 to-green-50 border-2 border-emerald-300 rounded-xl p-5 mt-4 shadow-lg">
                    <h4 class="font-bold text-emerald-800 mb-3 flex items-center text-lg">
                      <svg class="w-6 h-6 mr-2 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                      </svg>
                      📍 Detected Location
                    </h4>
                    <div class="space-y-2">
                      ${sitio ? `<p class="text-sm text-emerald-800 flex items-center"><span class="font-bold mr-2">🏘️ Sitio:</span> ${sitio}</p>` : ''}
                      <p class="text-sm text-emerald-700 flex items-center"><span class="font-bold mr-2">🏘️ Barangay:</span> ${barangay}</p>
                      <p class="text-sm text-emerald-600 flex items-center"><span class="font-bold mr-2">🏛️ Municipality:</span> ${municipality}</p>
                      <p class="text-sm text-emerald-600 flex items-center"><span class="font-bold mr-2">🗺️ Province:</span> ${province}</p>
                      <p class="text-xs text-gray-500 mt-3 pt-3 border-t border-emerald-200">
                        <strong>Full Address:</strong><br/>
                        ${fullLocation}
                      </p>
                    </div>
                  </div>
                `;
              }
            })
            .catch(error => {
              console.error('Geocoding error:', error);
              // Fallback popup without barangay info
              marker.bindPopup('<div style="text-align: center; padding: 12px; min-width: 200px;"><strong style="color: #059669; font-size: 18px; display: block; margin-bottom: 8px;">{{scenic.title}}</strong><span style="color: #64748b; font-size: 14px;">{{scenic.location}}</span></div>', {
                maxWidth: 300,
                className: 'custom-popup'
              }).openPopup();
            });
        }
        
        // Add scale control
        L.control.scale({ 
          imperial: false, 
          metric: true,
          position: 'bottomright'
        }).addTo(map);
        
      } catch(e) { 
        console.warn('Map initialization error:', e); 
      }
    })();
  </script>

  <style>
    .leaflet-popup-content-wrapper {
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      border: 2px solid #d1fae5;
    }
    
    .leaflet-popup-tip {
      background: white;
    }
    
    .custom-popup .leaflet-popup-content {
      margin: 0;
    }
    
    #map-detail {
      z-index: 1;
    }
    
    .leaflet-control-zoom {
      border: 2px solid #d1fae5 !important;
      border-radius: 12px !important;
      overflow: hidden;
    }
    
    .leaflet-control-zoom a {
      background: white !important;
      color: #059669 !important;
      font-weight: bold;
    }
    
    .leaflet-control-zoom a:hover {
      background: #d1fae5 !important;
    }
  </style>

{{>footer}}
</body>
</html>
