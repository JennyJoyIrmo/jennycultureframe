{{>head}}
<body class="bg-gray-50">
  {{>nav}}

  <div class="max-w-7xl mx-auto px-4 pt-8">
    <div class="cf-page-header cf-fade-up">
      <div class="flex items-center gap-2 mb-2">
        <i class="fas fa-mountain text-emerald-200"></i>
        <span class="text-emerald-200 text-sm font-medium">Scenic Locations</span>
      </div>
      <h1 class="text-3xl font-extrabold text-white">Scenic Spots in Mansalay</h1>
      <p class="text-emerald-100 mt-1 text-sm">Discover breathtaking natural wonders of Oriental Mindoro</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <!-- Grid -->
    {{#if scenics.length}}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {{#each scenics}}
      <article class="cf-card overflow-hidden hover:shadow-lg transition-all duration-200 group cf-fade-up">
        <div class="relative h-52 overflow-hidden bg-emerald-100">
          {{#if this.image_url}}
          <img src="{{this.image_url}}" alt="{{this.title}}"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
               onerror="this.src='/images/logo.png'" />
          {{else}}
          <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-400 to-teal-500">
            <i class="fas fa-mountain text-white text-5xl opacity-40"></i>
          </div>
          {{/if}}
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
          <span class="absolute top-3 left-3 cf-badge cf-badge-green">📍 Scenic Spot</span>
          <div class="absolute bottom-3 left-3 text-white text-xs bg-black/40 px-2 py-1 rounded-lg flex items-center gap-1">
            <i class="fas fa-map-marker-alt"></i>
            <span class="truncate max-w-[120px]">{{this.location}}</span>
          </div>
        </div>
        <div class="p-4">
          <h3 class="font-bold text-gray-800 mb-2 group-hover:text-emerald-600 transition-colors">{{this.title}}</h3>
          <p class="text-gray-500 text-sm mb-3 line-clamp-2">{{this.description}}</p>
          <a href="/scenic/{{this.id}}" class="inline-flex items-center gap-1.5 text-emerald-600 text-sm font-semibold hover:text-emerald-700 transition-colors">
            Explore <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
          </a>
        </div>
      </article>
      {{/each}}
    </div>
    {{else}}
    <div class="cf-card p-16 text-center mb-12">
      <i class="fas fa-mountain text-5xl text-gray-200 mb-4"></i>
      <h3 class="text-xl font-bold text-gray-500 mb-2">No Scenic Spots Yet</h3>
      <p class="text-gray-400 text-sm">Scenic content will appear here once added.</p>
    </div>
    {{/if}}

    <!-- Why visit section -->
    <div class="cf-card-green p-8 mb-8">
      <h2 class="cf-section-title mb-6 text-lg">Why Visit Mansalay?</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
        <div class="text-center">
          <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center mx-auto mb-2">
            <i class="fas fa-water text-emerald-600"></i>
          </div>
          <p class="font-semibold text-gray-800 text-sm">Natural Beauty</p>
          <p class="text-xs text-gray-500 mt-0.5">Pristine beaches & forests</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-2">
            <i class="fas fa-camera text-blue-600"></i>
          </div>
          <p class="font-semibold text-gray-800 text-sm">Photo Spots</p>
          <p class="text-xs text-gray-500 mt-0.5">Instagram-worthy views</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center mx-auto mb-2">
            <i class="fas fa-leaf text-green-600"></i>
          </div>
          <p class="font-semibold text-gray-800 text-sm">Nature Therapy</p>
          <p class="text-xs text-gray-500 mt-0.5">Relax & reconnect</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mx-auto mb-2">
            <i class="fas fa-compass text-amber-600"></i>
          </div>
          <p class="font-semibold text-gray-800 text-sm">Adventure</p>
          <p class="text-xs text-gray-500 mt-0.5">Explore hidden gems</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/events" class="cf-btn cf-btn-primary"><i class="fas fa-calendar"></i> View Events</a>
      <a href="/shop" class="cf-btn cf-btn-outline"><i class="fas fa-shopping-bag"></i> Shop Local Crafts</a>
    </div>
  </div>

  {{>footer}}
</body>
</html>
