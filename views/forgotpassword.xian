{{> head}}
<body class="min-h-screen bg-gradient-to-br from-emerald-900 via-teal-900 to-green-900">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('https://images.trvl-media.com/lodging/88000000/87680000/87675100/87675054/2d1f3220.jpg?impolicy=resizecrop&rw=575&rh=575&ra=fill');">
    <div class="absolute inset-0 bg-emerald-900/60 backdrop-blur-sm"></div>
  </div>

  <!-- Main Content -->
  <div class="relative z-10 flex items-center justify-center min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
      <!-- Animated Header -->
      <div class="text-center animate-fade-in-down">
        <div class="mx-auto w-20 h-20 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full flex items-center justify-center mb-6 shadow-2xl transform hover:scale-110 transition-transform duration-300">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-bold text-white mb-2 tracking-tight bg-gradient-to-r from-white to-emerald-200 bg-clip-text text-transparent">
          CultureFrame
        </h1>
        <p class="text-lg text-emerald-200 mb-2">Mansalay Cultural Heritage</p>
        <h2 class="text-3xl font-semibold text-white">Reset Password</h2>
        <p class="text-emerald-100 mt-2">Enter your email to reset your password</p>
      </div>

      <!-- Messages -->
      {{#if error_msg}}
      <div class="bg-red-500/20 backdrop-blur-lg border border-red-400/30 rounded-xl p-4 animate-fade-in shadow-lg">
        <div class="flex items-center">
          <svg class="h-6 w-6 text-red-300 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class="text-sm font-medium text-red-100">{{error_msg}}</h3>
        </div>
      </div>
      {{/if}}

      {{#if success_msg}}
      <div class="bg-emerald-500/20 backdrop-blur-lg border border-emerald-400/30 rounded-xl p-4 animate-fade-in shadow-lg">
        <div class="flex items-center">
          <svg class="h-6 w-6 text-emerald-300 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class="text-sm font-medium text-emerald-100">{{success_msg}}</h3>
        </div>
      </div>
      {{/if}}

      <!-- Glassmorphism Forgot Password Form -->
      <div class="bg-white/10 backdrop-blur-lg p-8 rounded-2xl shadow-2xl border border-white/20">
        <form method="POST" action="/forgot-password" class="space-y-6">
          <!-- Email Field -->
          <div class="group">
            <label for="email" class="block text-lg font-medium text-emerald-100 mb-3">
              <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              Email Address
            </label>
            <div class="relative">
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="Enter your registered email address" 
                class="w-full px-4 py-4 text-lg bg-white/5 border border-white/20 rounded-xl placeholder-emerald-200/60 text-white focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-all duration-300 group-hover:bg-white/10" 
                required 
              />
              <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-emerald-200/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
                </svg>
              </div>
            </div>
            <p class="mt-3 text-sm text-emerald-200/80">
              We'll send a password reset link to your email.
            </p>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            class="group relative w-full flex justify-center py-4 px-4 border border-transparent text-lg font-semibold rounded-xl text-white bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-400 transition-all duration-300 transform hover:scale-[1.02] active:scale-[0.98] shadow-lg hover:shadow-xl"
          >
            <span class="flex items-center">
              <svg class="w-5 h-5 mr-3 group-hover:animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              Send Reset Link
            </span>
            <div class="absolute right-6 top-1/2 transform -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </div>
          </button>
        </form>

        <!-- Back to Login -->
        <div class="mt-8 text-center pt-6 border-t border-white/20">
          <p class="text-lg text-emerald-100">
            Remember your password? 
            <a href="/login" class="font-semibold text-emerald-300 hover:text-white transition-colors duration-200 ml-1 inline-flex items-center group">
              Back to login
              <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating Elements for Visual Interest -->
  <div class="absolute top-10 left-10 w-6 h-6 bg-emerald-400/40 rounded-full animate-float"></div>
  <div class="absolute top-20 right-20 w-8 h-8 bg-teal-400/40 rounded-full animate-float-delayed"></div>
  <div class="absolute bottom-20 left-20 w-10 h-10 bg-green-400/40 rounded-full animate-float-slow"></div>
  <div class="absolute bottom-10 right-10 w-12 h-12 bg-lime-400/40 rounded-full animate-float-delayed-slow"></div>

  <!-- Additional decorative elements -->
  <div class="absolute top-1/4 left-5 w-8 h-8 bg-emerald-300/20 rounded-full animate-pulse-slow"></div>
  <div class="absolute bottom-1/3 right-8 w-6 h-6 bg-teal-300/30 rounded-full animate-pulse"></div>

  <!-- Location Tag -->
  <div class="absolute bottom-4 left-4 bg-black/40 backdrop-blur-sm text-white text-xs px-3 py-2 rounded-full border border-white/20">
    <svg class="w-3 h-3 inline mr-1 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
    </svg>
    Mansalay, Oriental Mindoro
  </div>

  {{> footer }}
</body>
</html>
