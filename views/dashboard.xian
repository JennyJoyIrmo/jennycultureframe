{{> head}}
<body class="bg-emerald-50 min-h-screen text-slate-700">

  <!-- Navigation -->
  <nav class="bg-emerald-900 text-emerald-50 shadow-xl border-b border-emerald-700">
    <div class="container mx-auto px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="rounded-2xl bg-emerald-700/20 p-3">
          <svg class="w-8 h-8 text-emerald-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-4.418 0-8 1.79-8 4v4h16v-4c0-2.21-3.582-4-8-4z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 16v1a2 2 0 002 2h8a2 2 0 002-2v-1" />
          </svg>
        </div>
        <div>
          <h1 class="text-2xl font-bold tracking-tight">CultureFrame</h1>
          <p class="text-sm text-emerald-200">Customer Dashboard</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <span class="rounded-full bg-emerald-700/20 px-4 py-2">Welcome, {{user.name}}</span>
        <a href="/" class="px-4 py-2 rounded-lg bg-emerald-700/20 hover:bg-emerald-600 transition">Home</a>
        <a href="/shop" class="px-4 py-2 rounded-lg bg-emerald-700/20 hover:bg-emerald-600 transition">Shop</a>
        <a href="/heritage" class="px-4 py-2 rounded-lg bg-emerald-700/20 hover:bg-emerald-600 transition">Heritage</a>
        <a href="/events" class="px-4 py-2 rounded-lg bg-emerald-700/20 hover:bg-emerald-600 transition">Events</a>
        <a href="/logout" class="px-4 py-2 rounded-lg bg-red-500 hover:bg-red-600 transition text-white">Logout</a>
      </div>
    </div>
  </nav>

  <main class="container mx-auto px-6 py-10">
    <section class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8 mb-10">
      <div class="rounded-[32px] bg-gradient-to-br from-emerald-600 to-teal-500 p-8 text-white shadow-2xl overflow-hidden relative">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.35),transparent_45%)]"></div>
        <h2 class="text-4xl font-extrabold tracking-tight mb-4">Mas maganda na dashboard mo.</h2>
        <p class="max-w-xl text-lg leading-8 opacity-90">
          Discover cultural finds, shop local goods, and manage your activities with a fresh green experience.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-3xl bg-white/10 p-5 backdrop-blur-sm border border-white/15">
            <p class="text-sm uppercase tracking-[0.24em] opacity-80">Next event</p>
            <p class="mt-3 text-xl font-semibold">Community Market</p>
          </div>
          <div class="rounded-3xl bg-white/10 p-5 backdrop-blur-sm border border-white/15">
            <p class="text-sm uppercase tracking-[0.24em] opacity-80">Total items</p>
            <p class="mt-3 text-xl font-semibold">25+ handcrafted goods</p>
          </div>
        </div>
      </div>
      <div class="space-y-6">
        <div class="rounded-[32px] bg-white shadow-xl p-6 border border-emerald-100">
          <h3 class="text-xl font-semibold text-slate-900 mb-4">Your profile</h3>
          <p class="text-sm text-slate-600 mb-4">Update your information, view your orders, and keep your account fresh.</p>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="rounded-3xl bg-emerald-50 p-5">
              <p class="text-xs uppercase tracking-[0.24em] text-emerald-700/80">Profile status</p>
              <p class="mt-3 text-lg font-semibold text-emerald-900">Active</p>
            </div>
            <div class="rounded-3xl bg-slate-50 p-5">
              <p class="text-xs uppercase tracking-[0.24em] text-slate-500">Orders</p>
              <p class="mt-3 text-lg font-semibold text-slate-900">0</p>
            </div>
          </div>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="/customer/profile/edit" class="inline-flex items-center justify-center rounded-full bg-emerald-600 px-5 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition">Edit Profile</a>
            <a href="/customer/orders" class="inline-flex items-center justify-center rounded-full border border-emerald-200 px-5 py-2 text-sm text-emerald-700 hover:bg-emerald-50 transition">View Orders</a>
          </div>
        </div>
        <div class="rounded-[32px] bg-white shadow-xl p-6 border border-emerald-100">
          <h3 class="text-xl font-semibold text-slate-900 mb-4">Quick actions</h3>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <a href="/shop" class="rounded-3xl border border-slate-200 p-4 hover:border-emerald-200 hover:bg-emerald-50 transition">
              <p class="text-sm text-slate-500">Browse</p>
              <p class="mt-2 font-semibold text-slate-900">Shop products</p>
            </a>
            <a href="/heritage" class="rounded-3xl border border-slate-200 p-4 hover:border-emerald-200 hover:bg-emerald-50 transition">
              <p class="text-sm text-slate-500">Discover</p>
              <p class="mt-2 font-semibold text-slate-900">Heritage sites</p>
            </a>
            <a href="/events" class="rounded-3xl border border-slate-200 p-4 hover:border-emerald-200 hover:bg-emerald-50 transition">
              <p class="text-sm text-slate-500">Attend</p>
              <p class="mt-2 font-semibold text-slate-900">Upcoming events</p>
            </a>
            <a href="/checkout" class="rounded-3xl border border-slate-200 p-4 hover:border-emerald-200 hover:bg-emerald-50 transition">
              <p class="text-sm text-slate-500">Checkout</p>
              <p class="mt-2 font-semibold text-slate-900">My cart</p>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="grid gap-6 xl:grid-cols-[2fr_1fr]">
      <div class="rounded-[32px] bg-white shadow-xl p-8 border border-emerald-100">
        <div class="flex items-center justify-between gap-4 mb-6">
          <div>
            <h2 class="text-2xl font-bold text-slate-900">Dashboard overview</h2>
            <p class="text-sm text-slate-500">See your current site activity and next steps.</p>
          </div>
          <a href="/shop" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition">Explore more →</a>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="rounded-3xl border border-emerald-50 bg-emerald-50 p-6">
            <span class="inline-flex rounded-full bg-white p-3 shadow-sm text-emerald-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4z"/></svg>
            </span>
            <div class="mt-4">
              <p class="text-sm text-slate-500">Cart items</p>
              <p class="mt-2 text-3xl font-bold text-slate-900">0</p>
            </div>
          </div>
          <div class="rounded-3xl border border-emerald-50 bg-white p-6">
            <span class="inline-flex rounded-full bg-emerald-100 p-3 text-emerald-700">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5a1 1 0 011-1h2a1 1 0 011 1v12h1a1 1 0 011 1v2H7v-2a1 1 0 011-1h1V5z"/></svg>
            </span>
            <div class="mt-4">
              <p class="text-sm text-slate-500">Wishlist</p>
              <p class="mt-2 text-3xl font-bold text-slate-900">0</p>
            </div>
          </div>
          <div class="rounded-3xl border border-emerald-50 bg-white p-6">
            <span class="inline-flex rounded-full bg-emerald-100 p-3 text-emerald-700">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6a2 2 0 012-2h2a2 2 0 012 2v6m-6 0a2 2 0 104 0m6 0v1a2 2 0 01-2 2H7a2 2 0 01-2-2v-1"/></svg>
            </span>
            <div class="mt-4">
              <p class="text-sm text-slate-500">Orders</p>
              <p class="mt-2 text-3xl font-bold text-slate-900">0</p>
            </div>
          </div>
          <div class="rounded-3xl border border-emerald-50 bg-emerald-50 p-6">
            <span class="inline-flex rounded-full bg-white p-3 shadow-sm text-emerald-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-4.418 0-8 1.79-8 4v4h16v-4c0-2.21-3.582-4-8-4z"/></svg></span>
            <div class="mt-4">
              <p class="text-sm text-slate-500">Activity</p>
              <p class="mt-2 text-3xl font-bold text-slate-900">Fresh</p>
            </div>
          </div>
        </div>
      </div>
      <aside class="space-y-6">
        <div class="rounded-[32px] bg-white shadow-xl p-6 border border-emerald-100">
          <h3 class="text-xl font-semibold text-slate-900 mb-4">Highlights</h3>
          <ul class="space-y-3 text-slate-600">
            <li class="rounded-3xl bg-emerald-50 p-4">New local crafts added every week.</li>
            <li class="rounded-3xl bg-emerald-50 p-4">Fast checkout with safe payments.</li>
            <li class="rounded-3xl bg-emerald-50 p-4">Join events and celebrate culture.</li>
          </ul>
        </div>
        <div class="rounded-[32px] bg-gradient-to-br from-emerald-600 to-teal-500 p-6 text-white shadow-xl">
          <h3 class="text-xl font-semibold">Want your page to look even better?</h3>
          <p class="mt-3 text-sm leading-6 text-emerald-100/90">I can continue refreshing the shop, profile, and event pages with the same polished green theme.</p>
          <a href="/customer/profile" class="mt-5 inline-flex w-full items-center justify-center rounded-full bg-white px-4 py-3 text-sm font-semibold text-emerald-800 hover:bg-emerald-100 transition">Go to Profile</a>
        </div>
      </aside>
    </section>
  </main>

  {{>footer}}