{{>head}}
<body class="bg-gray-50">
  {{>nav}}
  {{>messages}}

  <div class="max-w-7xl mx-auto px-4 pt-8">
    <div class="cf-page-header cf-fade-up">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <i class="fas fa-calendar-check text-emerald-200 text-sm"></i>
            <span class="text-emerald-200 text-sm font-medium">My Account</span>
          </div>
          <h1 class="text-2xl font-extrabold text-white">My Registered Events</h1>
          <p class="text-emerald-100 text-sm mt-0.5">View and manage your event registrations</p>
        </div>
        <div class="flex gap-2 flex-shrink-0">
          <a href="/customer/dashboard" class="cf-btn bg-white/15 text-white border border-white/30 hover:bg-white/25 text-sm" style="border-radius:10px">
            <i class="fas fa-arrow-left"></i> Dashboard
          </a>
          <a href="/events" class="cf-btn bg-white text-emerald-700 hover:bg-emerald-50 text-sm" style="border-radius:10px">
            <i class="fas fa-calendar-alt"></i> Browse Events
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-8">
    {{#if registeredEvents.length}}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {{#each registeredEvents}}
      <article class="cf-card overflow-hidden hover:shadow-lg transition-all duration-200 group cf-fade-up">
        <div class="relative h-44 overflow-hidden bg-emerald-100">
          {{#if event.image_url}}
          <img src="{{event.image_url}}" alt="{{event.title}}"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
               onerror="this.src='/images/logo.png'" />
          {{else}}
          <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-400 to-blue-500">
            <i class="fas fa-calendar-alt text-white text-4xl opacity-40"></i>
          </div>
          {{/if}}
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
          <span class="absolute top-3 right-3 cf-badge cf-badge-green">
            <i class="fas fa-check-circle mr-1"></i> Registered
          </span>
          {{#if event.category}}
          <span class="absolute top-3 left-3 cf-badge cf-badge-purple capitalize">{{event.category}}</span>
          {{/if}}
        </div>

        <div class="p-4">
          <h3 class="font-bold text-gray-800 mb-2 group-hover:text-emerald-600 transition-colors line-clamp-2">{{event.title}}</h3>
          <div class="space-y-1.5 mb-3">
            <div class="flex items-center gap-2 text-xs text-gray-500">
              <i class="fas fa-calendar text-emerald-500 w-3"></i>
              <span>{{event.event_date}}</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-500">
              <i class="fas fa-map-marker-alt text-emerald-500 w-3"></i>
              <span class="truncate">{{event.location}}</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-400">
              <i class="fas fa-clock w-3"></i>
              <span>Registered {{createdAt}}</span>
            </div>
          </div>
          <p class="text-gray-500 text-xs mb-3 line-clamp-2">{{event.description}}</p>
          <a href="/events/{{event.id}}"
             class="inline-flex items-center gap-1.5 text-emerald-600 text-sm font-semibold hover:text-emerald-700 transition-colors">
            View Details <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
          </a>
        </div>
      </article>
      {{/each}}
    </div>
    {{else}}
    <div class="cf-card p-16 text-center cf-fade-up">
      <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-calendar-times text-emerald-400 text-3xl"></i>
      </div>
      <h3 class="text-xl font-extrabold text-gray-700 mb-2">No Registered Events</h3>
      <p class="text-gray-400 text-sm mb-6 max-w-sm mx-auto">You haven't registered for any events yet. Explore upcoming cultural events in Mansalay!</p>
      <a href="/events" class="cf-btn cf-btn-primary">
        <i class="fas fa-calendar-alt"></i> Browse Available Events
      </a>
    </div>
    {{/if}}
  </div>

  {{>footer}}
</body>
</html>
