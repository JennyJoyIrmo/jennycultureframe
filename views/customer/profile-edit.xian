{{> head}}
<body class="min-h-screen bg-gradient-to-br from-emerald-50 via-green-50 to-teal-50">
  <div class="container mx-auto px-6 py-12">
    <div class="max-w-xl mx-auto bg-white rounded-2xl shadow-2xl p-8 border border-emerald-200/50">
      <h1 class="text-3xl font-bold text-emerald-700 mb-6 flex items-center"><i class="fas fa-user-edit mr-3"></i>Edit Profile</h1>
      <form method="POST" action="/customer/profile/edit" enctype="multipart/form-data" class="space-y-6">
                <div>
                  <label class="block text-emerald-800 font-semibold mb-2">Profile Picture</label>
                  <input type="file" name="profileImage" accept="image/*" class="w-full p-2 bg-emerald-50 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 transition-all font-medium" />
                  {{#if user.profileImage}}
                    <div class="mt-2 flex items-center">
                      <img src="/uploads/{{user.profileImage}}" alt="Profile Image" class="w-16 h-16 rounded-full object-cover border-2 border-emerald-400 shadow mr-3" />
                      <span class="text-gray-600 text-sm">Current photo</span>
                    </div>
                  {{/if}}
                </div>
        <div>
          <label class="block text-emerald-800 font-semibold mb-2">Name</label>
          <input type="text" name="name" value="{{user.name}}" required class="w-full p-4 bg-emerald-50 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 transition-all font-medium" />
        </div>
        <div>
          <label class="block text-emerald-800 font-semibold mb-2">Email</label>
          <input type="email" name="email" value="{{user.email}}" required class="w-full p-4 bg-emerald-50 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 transition-all font-medium" />
        </div>
        <div>
          <label class="block text-emerald-800 font-semibold mb-2">New Password <span class="text-gray-500 text-xs">(leave blank to keep current)</span></label>
          <input type="password" name="password" class="w-full p-4 bg-emerald-50 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 transition-all font-medium" />
        </div>
        <div class="flex space-x-4 pt-4">
          <button type="submit" class="flex-1 bg-gradient-to-r from-emerald-500 to-green-500 hover:from-emerald-600 hover:to-green-600 text-white py-4 px-6 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all flex items-center justify-center">
            <i class="fas fa-save mr-2"></i> Save Changes
          </button>
          <a href="/customer/dashboard" class="flex-1 bg-gradient-to-r from-gray-300 to-gray-400 hover:from-gray-400 hover:to-gray-500 text-gray-700 py-4 px-6 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all flex items-center justify-center">
            <i class="fas fa-arrow-left mr-2"></i> Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>