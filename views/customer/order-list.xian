{{>head}}
<body class="bg-gray-50">
  {{>nav}}
  {{>messages}}

  <div class="container mx-auto px-4 py-8">
    <h2 class="text-2xl font-bold mb-6">Your Orders</h2>

    {{#if orders.length}}
      <div class="space-y-4">
        {{#each orders}}
          <div class="bg-white p-4 rounded shadow flex justify-between items-center">
            <div>
              <div class="text-lg font-semibold">Order #{{this.id}}</div>
              <div class="text-sm text-gray-600">Placed: {{this.createdAt}}</div>
              <div class="text-sm">Total: ₱{{this.total_amount}}</div>
            </div>
            <div class="text-right">
              {{#if (eq this.status 'delivered')}}
                <div class="inline-block px-3 py-1 rounded bg-emerald-100 text-emerald-800">Delivered</div>
                <div class="mt-2">
                  <a href="/customer/orders/{{this.id}}#feedback" class="text-emerald-600 hover:underline">Leave feedback</a>
                </div>
              {{else}}
                <div class="inline-block px-3 py-1 rounded bg-gray-200 text-gray-800">{{this.status}}</div>
                <div class="mt-2">
                  <a href="/customer/orders/{{this.id}}" class="text-emerald-600 hover:underline">View details</a>
                </div>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="text-gray-600">You have no orders yet. <a href="/shop" class="text-emerald-600">Shop now</a>.</p>
    {{/if}}
  </div>

  {{>footer}}
</body>
</html>
