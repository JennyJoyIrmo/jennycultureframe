{{>head}}
<body class="bg-gray-50">
  {{>nav}}
  {{>messages}}

  <div class="max-w-4xl mx-auto px-4 pt-8">
    <div class="cf-page-header cf-fade-up">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <i class="fas fa-box text-emerald-200 text-sm"></i>
            <span class="text-emerald-200 text-sm font-medium">My Account</span>
          </div>
          <h1 class="text-2xl font-extrabold text-white">My Orders</h1>
          <p class="text-emerald-100 text-sm mt-0.5">Track and review all your purchases</p>
        </div>
        <a href="/shop" class="cf-btn bg-white text-emerald-700 hover:bg-emerald-50 text-sm flex-shrink-0" style="border-radius:10px">
          <i class="fas fa-shopping-bag"></i> Continue Shopping
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-8">
    {{#if orders.length}}
    <div class="space-y-4">
      {{#each orders}}
      <div class="cf-card p-5 hover:shadow-md transition-all cf-fade-up">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5">
              <i class="fas fa-box text-emerald-600 text-sm"></i>
            </div>
            <div>
              <p class="font-bold text-gray-800">Order #{{this.id}}</p>
              <p class="text-xs text-gray-400 mt-0.5">{{this.createdAt}}</p>
              <p class="text-sm font-semibold text-emerald-600 mt-1">₱{{this.total_amount}}</p>
              <p class="text-xs text-gray-500 capitalize mt-0.5">
                via <span class="font-medium">{{this.payment_method}}</span>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-3 sm:flex-col sm:items-end">
            <span class="cf-badge capitalize
              {{#if (eq this.status 'delivered')}}cf-badge-green
              {{else if (eq this.status 'shipped')}}cf-badge-blue
              {{else if (eq this.status 'processing')}}cf-badge-amber
              {{else}}cf-badge-gray{{/if}}">
              {{this.status}}
            </span>
            <a href="/customer/orders/{{this.id}}"
               class="cf-btn cf-btn-outline text-xs px-3 py-1.5">
              View Details
            </a>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="cf-card p-16 text-center cf-fade-up">
      <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-box-open text-emerald-400 text-3xl"></i>
      </div>
      <h3 class="text-xl font-extrabold text-gray-700 mb-2">No Orders Yet</h3>
      <p class="text-gray-400 text-sm mb-6">You haven't placed any orders yet. Explore our local products!</p>
      <a href="/shop" class="cf-btn cf-btn-primary">
        <i class="fas fa-shopping-bag"></i> Shop Now
      </a>
    </div>
    {{/if}}
  </div>

  {{>footer}}
</body>
</html>
