{{>head}}
<body class="bg-gray-50">
  {{>nav}}
  {{>messages}}

  <div class="container mx-auto px-4 py-8">
    <a href="/customer/orders" class="text-emerald-600 hover:underline">← Back to Orders</a>
    <h2 class="text-2xl font-bold mt-4">Order #{{order.id}}</h2>
    <div class="mt-2 text-sm text-gray-600">Status: <strong>{{order.status}}</strong></div>
    <div class="mt-4 bg-white p-4 rounded shadow">
      <div class="text-sm text-gray-600">Placed: {{order.createdAt}}</div>
      <div class="text-sm">Name: {{order.customer_name}}</div>
      <div class="text-sm">Email: {{order.customer_email}}</div>
      <div class="text-sm">Phone: {{order.customer_phone}}</div>
      <div class="mt-3">Shipping address: <div class="text-sm text-gray-700">{{order.shipping_address}}</div></div>

      <h3 class="mt-4 font-semibold">Items</h3>
      <ul class="mt-2 divide-y">
        {{#each items}}
          <li class="py-2 flex justify-between">
            <div>
              <div class="font-medium">{{this.product_name}}</div>
              <div class="text-xs text-gray-600">Qty: {{this.quantity}}</div>
            </div>
            <div class="text-sm">₱{{this.price}}</div>
          </li>
        {{/each}}
      </ul>

      <div class="mt-4 text-right font-bold">Total: ₱{{order.total_amount}}</div>
    </div>

    <!-- Feedback section: allow customers to leave feedback after delivery -->
    <div class="mt-6">
      <h3 class="text-lg font-semibold">Feedback</h3>
      {{#if (eq order.status 'delivered')}}
        {{#if feedback}}
          <div id="feedback" class="mt-3 bg-white p-4 rounded shadow">
            <div class="flex items-center justify-between">
              <div>
                <div class="text-sm text-gray-600">Your rating</div>
                <div class="text-xl font-bold">{{feedback.rating}} / 5</div>
              </div>
              <div class="text-right text-sm text-gray-500">Submitted: {{feedback.createdAt}}</div>
            </div>
            {{#if feedback.comment}}
              <div class="mt-3 text-gray-700">{{feedback.comment}}</div>
            {{/if}}
            <div class="mt-4 text-right">
              <a href="#" onclick="document.getElementById('feedbackForm').classList.toggle('hidden'); return false;" class="text-emerald-600 hover:underline">Edit feedback</a>
            </div>
          </div>
        {{else}}
          <div id="feedback" class="mt-3 bg-white p-4 rounded shadow">
            <form id="feedbackForm" method="POST" action="/customer/orders/{{order.id}}/feedback" class="space-y-3">
              <div>
                <label class="block text-sm text-gray-700">Rating</label>
                <select name="rating" class="mt-1 block w-32 border-gray-300 rounded p-2">
                  <option value="5">5 - Excellent</option>
                  <option value="4">4 - Very Good</option>
                  <option value="3">3 - Good</option>
                  <option value="2">2 - Fair</option>
                  <option value="1">1 - Poor</option>
                </select>
              </div>
              <div>
                <label class="block text-sm text-gray-700">Comment (optional)</label>
                <textarea name="comment" rows="4" class="mt-1 block w-full border border-gray-300 rounded p-2" placeholder="Tell us about your experience"></textarea>
              </div>
              <div class="text-right">
                <button type="submit" class="px-4 py-2 bg-emerald-600 text-white rounded">Submit feedback</button>
              </div>
            </form>
          </div>
        {{/if}}
      {{else}}
        <div class="mt-3 text-sm text-gray-600">You can leave feedback after your order has been delivered.</div>
      {{/if}}
    </div>
  </div>

  {{>footer}}
</body>
</html>
