<footer class="bg-gradient-to-br from-emerald-900 via-green-900 to-emerald-900 text-white mt-20">
  <div class="max-w-7xl mx-auto px-4 pt-12 pb-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">

      <!-- Brand -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-9 h-9 bg-white rounded-lg flex items-center justify-center shadow">
            <img src="/images/logo.png" alt="CultureFrame" class="w-8 h-8 object-contain rounded-md" />
          </div>
          <div>
            <p class="font-bold text-white leading-none">CultureFrame</p>
            <p class="text-emerald-400 text-xs mt-0.5">Mansalay Heritage</p>
          </div>
        </div>
        <p class="text-emerald-200 text-sm leading-relaxed">
          Preserving the rich cultural heritage of Mansalay, Oriental Mindoro through digital technology.
        </p>
      </div>

      <!-- Explore -->
      <div>
        <h4 class="font-bold text-white mb-3 text-sm uppercase tracking-wide">Explore</h4>
        <ul class="space-y-2">
          <li><a href="/heritage" class="text-emerald-300 hover:text-white text-sm transition-colors flex items-center gap-1.5"><i class="fas fa-landmark text-xs"></i> Heritage Sites</a></li>
          <li><a href="/events" class="text-emerald-300 hover:text-white text-sm transition-colors flex items-center gap-1.5"><i class="fas fa-calendar text-xs"></i> Events</a></li>
          <li><a href="/scenic" class="text-emerald-300 hover:text-white text-sm transition-colors flex items-center gap-1.5"><i class="fas fa-mountain text-xs"></i> Scenic Spots</a></li>
          <li><a href="/crafts" class="text-emerald-300 hover:text-white text-sm transition-colors flex items-center gap-1.5"><i class="fas fa-paint-brush text-xs"></i> Arts & Crafts</a></li>
        </ul>
      </div>

      <!-- Shop & Account -->
      <div>
        <h4 class="font-bold text-white mb-3 text-sm uppercase tracking-wide">Shop & Account</h4>
        <ul class="space-y-2">
          <li><a href="/shop" class="text-emerald-300 hover:text-white text-sm transition-colors flex items-center gap-1.5"><i class="fas fa-shopping-bag text-xs"></i> Local Products</a></li>
          <li><a href="/cart" class="text-emerald-300 hover:text-white text-sm transition-colors flex items-center gap-1.5"><i class="fas fa-shopping-cart text-xs"></i> My Cart</a></li>
          <li><a href="/customer/orders" class="text-emerald-300 hover:text-white text-sm transition-colors flex items-center gap-1.5"><i class="fas fa-box text-xs"></i> My Orders</a></li>
          <li><a href="/customer/profile" class="text-emerald-300 hover:text-white text-sm transition-colors flex items-center gap-1.5"><i class="fas fa-user text-xs"></i> Profile</a></li>
        </ul>
      </div>

      <!-- About -->
      <div>
        <h4 class="font-bold text-white mb-3 text-sm uppercase tracking-wide">About</h4>
        <ul class="space-y-2">
          <li><a href="/terms" class="text-emerald-300 hover:text-white text-sm transition-colors flex items-center gap-1.5"><i class="fas fa-file-alt text-xs"></i> Terms & Conditions</a></li>
        </ul>
        <div class="mt-4">
          <p class="text-emerald-400 text-xs mb-1">Location</p>
          <p class="text-emerald-200 text-sm flex items-center gap-1.5"><i class="fas fa-map-marker-alt text-xs"></i> Mansalay, Oriental Mindoro</p>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-emerald-400 text-xs text-center sm:text-left">
        &copy; 2025 CultureFrame Mansalay. All rights reserved.
      </p>
      <p class="text-emerald-500 text-xs flex items-center gap-1">
        Built with <i class="fas fa-heart text-red-400 text-[10px]"></i> using XianFire · Mindoro State University
      </p>
    </div>
  </div>
</footer>

<!-- AI Chatbot Widget -->
<div id="chatbot-widget" style="position:fixed;bottom:24px;right:24px;z-index:9999;font-family:'Inter',sans-serif;">
  <button id="chatbot-toggle" onclick="toggleChat()" aria-label="Open chat"
    style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#059669,#10b981);border:none;cursor:pointer;box-shadow:0 4px 16px rgba(5,150,105,.4);display:flex;align-items:center;justify-content:center;transition:transform .2s;">
    <svg id="chat-icon" width="22" height="22" fill="white" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
    <svg id="close-icon" width="22" height="22" fill="white" viewBox="0 0 24 24" style="display:none;"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
  </button>

  <div id="chat-window" style="display:none;position:absolute;bottom:64px;right:0;width:310px;background:white;border-radius:16px;box-shadow:0 8px 32px rgba(0,0,0,.15);overflow:hidden;border:1px solid #e5e7eb;">
    <div style="background:linear-gradient(135deg,#059669,#10b981);padding:12px 16px;display:flex;align-items:center;gap:10px;">
      <img src="/images/logo.png" style="width:30px;height:30px;border-radius:50%;object-fit:contain;background:white;padding:2px;" />
      <div>
        <div style="color:white;font-weight:700;font-size:13px;">CultureFrame Assistant</div>
        <div style="color:#d1fae5;font-size:11px;">● Typically replies instantly</div>
      </div>
    </div>

    <div id="chat-messages" style="height:260px;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;background:#f9fafb;">
      <div style="background:#ecfdf5;border-radius:12px 12px 12px 0;padding:10px 12px;max-width:90%;font-size:12px;color:#065f46;line-height:1.5;">
        👋 Hi! I'm the CultureFrame Assistant. How can I help?
        <div style="margin-top:8px;display:flex;flex-direction:column;gap:5px;">
          <button onclick="sendQuick('Tell me about heritage sites')" style="background:white;border:1px solid #059669;color:#059669;border-radius:20px;padding:4px 10px;font-size:11px;cursor:pointer;text-align:left;">🏛️ Heritage sites</button>
          <button onclick="sendQuick('Show me local products')" style="background:white;border:1px solid #059669;color:#059669;border-radius:20px;padding:4px 10px;font-size:11px;cursor:pointer;text-align:left;">🛍️ Local products</button>
          <button onclick="sendQuick('What events are coming up')" style="background:white;border:1px solid #059669;color:#059669;border-radius:20px;padding:4px 10px;font-size:11px;cursor:pointer;text-align:left;">🎉 Upcoming events</button>
        </div>
      </div>
    </div>

    <div style="padding:10px;border-top:1px solid #e5e7eb;display:flex;gap:8px;background:white;">
      <input id="chat-input" type="text" placeholder="Type a message…"
        style="flex:1;padding:7px 12px;border:1.5px solid #d1d5db;border-radius:20px;font-size:12px;outline:none;"
        onkeydown="if(event.key==='Enter')sendMessage()" />
      <button onclick="sendMessage()" aria-label="Send"
        style="background:#059669;color:white;border:none;border-radius:50%;width:34px;height:34px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <svg width="14" height="14" fill="white" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
function toggleChat(){
  const w=document.getElementById('chat-window'),ci=document.getElementById('chat-icon'),xi=document.getElementById('close-icon');
  const open=w.style.display==='block';
  w.style.display=open?'none':'block';
  ci.style.display=open?'block':'none';
  xi.style.display=open?'none':'block';
}
function sendQuick(t){document.getElementById('chat-input').value=t;sendMessage();}
function sendMessage(){
  const inp=document.getElementById('chat-input'),msgs=document.getElementById('chat-messages'),txt=inp.value.trim();
  if(!txt)return;
  const ud=document.createElement('div');
  ud.style.cssText='background:#059669;color:white;border-radius:12px 12px 0 12px;padding:9px 12px;max-width:85%;font-size:12px;align-self:flex-end;margin-left:auto;line-height:1.4;';
  ud.textContent=txt;msgs.appendChild(ud);inp.value='';msgs.scrollTop=msgs.scrollHeight;
  const tp=document.createElement('div');
  tp.style.cssText='background:#ecfdf5;border-radius:12px;padding:9px 12px;font-size:12px;color:#059669;max-width:60%;';
  tp.textContent='● ● ●';msgs.appendChild(tp);msgs.scrollTop=msgs.scrollHeight;
  setTimeout(()=>{
    tp.remove();
    const bd=document.createElement('div');
    bd.style.cssText='background:#ecfdf5;border-radius:12px 12px 12px 0;padding:9px 12px;max-width:90%;font-size:12px;color:#065f46;line-height:1.5;';
    bd.innerHTML=getBotReply(txt.toLowerCase());msgs.appendChild(bd);msgs.scrollTop=msgs.scrollHeight;
  },700);
}
function getBotReply(m){
  if(m.includes('heritage')||m.includes('history'))return'🏛️ Mansalay has rich cultural heritage including <strong>Hanunuo Mangyan</strong> traditions. <a href="/heritage" style="color:#059669;font-weight:600;">Explore Heritage →</a>';
  if(m.includes('shop')||m.includes('product')||m.includes('craft')||m.includes('local'))return'🛍️ Browse authentic Mangyan crafts and handmade items in our <a href="/shop" style="color:#059669;font-weight:600;">Shop →</a>';
  if(m.includes('event')||m.includes('festival'))return'🎉 Check upcoming events in the <a href="/events" style="color:#059669;font-weight:600;">Events section →</a>';
  if(m.includes('scenic')||m.includes('nature')||m.includes('tour'))return'📸 Discover Mansalay\'s scenic spots: <a href="/scenic" style="color:#059669;font-weight:600;">View Scenic →</a>';
  if(m.includes('hello')||m.includes('hi')||m.includes('hey'))return'👋 Hello! Welcome to CultureFrame. How can I assist you today?';
  if(m.includes('register')||m.includes('sign up'))return'👤 Create a free account: <a href="/register" style="color:#059669;font-weight:600;">Register →</a>';
  if(m.includes('login')||m.includes('sign in'))return'🔐 Log in here: <a href="/login" style="color:#059669;font-weight:600;">Login →</a>';
  if(m.includes('order')||m.includes('cart')||m.includes('checkout'))return'🛒 Browse the <a href="/shop" style="color:#059669;">Shop</a>, add to cart, then proceed to checkout. We accept COD and online payment.';
  return'🤔 I\'m not sure about that. Try asking about <a href="/heritage" style="color:#059669;">heritage</a>, <a href="/shop" style="color:#059669;">products</a>, or <a href="/events" style="color:#059669;">events</a>!';
}
</script>
