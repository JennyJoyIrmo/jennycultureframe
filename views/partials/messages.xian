{{#if error_msg}}
<div class="max-w-7xl mx-auto px-4 mt-4">
  <div class="flex items-start gap-3 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm cf-fade-up" role="alert">
    <i class="fas fa-circle-exclamation mt-0.5 flex-shrink-0"></i>
    <span class="flex-1">{{error_msg}}</span>
    <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-red-600 transition-colors flex-shrink-0" aria-label="Dismiss">
      <i class="fas fa-xmark"></i>
    </button>
  </div>
</div>
{{/if}}
{{#if success_msg}}
<div class="max-w-7xl mx-auto px-4 mt-4">
  <div class="flex items-start gap-3 p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-700 text-sm cf-fade-up" role="status">
    <i class="fas fa-circle-check mt-0.5 flex-shrink-0"></i>
    <span class="flex-1">{{success_msg}}</span>
    <button onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-600 transition-colors flex-shrink-0" aria-label="Dismiss">
      <i class="fas fa-xmark"></i>
    </button>
  </div>
</div>
{{/if}}
