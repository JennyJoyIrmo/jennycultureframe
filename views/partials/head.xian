<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#059669" />
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <title>{{#if title}}{{title}}{{else}}CultureFrame — Mansalay Heritage{{/if}}</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    /* ── Base ───────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; color: #1f2937; }

    /* ── Design tokens ──────────────────────────────────────── */
    :root {
      --cf-green:        #059669;
      --cf-green-dark:   #047857;
      --cf-green-light:  #d1fae5;
      --cf-green-bg:     #f0fdf4;
      --cf-radius:       12px;
      --cf-radius-lg:    16px;
      --cf-radius-xl:    20px;
      --cf-shadow:       0 1px 3px rgba(0,0,0,.06), 0 4px 16px rgba(5,150,105,.07);
      --cf-shadow-md:    0 4px 6px rgba(0,0,0,.07), 0 8px 24px rgba(5,150,105,.1);
    }

    /* ── Card utility ───────────────────────────────────────── */
    .cf-card {
      background: #fff;
      border-radius: var(--cf-radius-lg);
      box-shadow: var(--cf-shadow);
      border: 1px solid #e5e7eb;
    }
    .cf-card-green {
      background: #fff;
      border-radius: var(--cf-radius-lg);
      box-shadow: var(--cf-shadow);
      border: 1px solid var(--cf-green-light);
    }

    /* ── Button utilities ───────────────────────────────────── */
    .cf-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
      padding: .55rem 1.1rem;
      border-radius: var(--cf-radius);
      font-weight: 600; font-size: .875rem;
      transition: all .18s;
      cursor: pointer; border: none; text-decoration: none;
    }
    .cf-btn-primary {
      background: var(--cf-green);
      color: #fff;
      box-shadow: 0 2px 8px rgba(5,150,105,.25);
    }
    .cf-btn-primary:hover { background: var(--cf-green-dark); box-shadow: 0 4px 14px rgba(5,150,105,.35); transform: translateY(-1px); }
    .cf-btn-outline {
      background: transparent;
      color: var(--cf-green);
      border: 1.5px solid var(--cf-green);
    }
    .cf-btn-outline:hover { background: var(--cf-green-bg); }
    .cf-btn-ghost {
      background: transparent;
      color: #6b7280;
      border: 1.5px solid #e5e7eb;
    }
    .cf-btn-ghost:hover { background: #f9fafb; color: #374151; }

    /* ── Input utility ──────────────────────────────────────── */
    .cf-input {
      width: 100%;
      padding: .6rem 1rem;
      border: 1.5px solid #d1d5db;
      border-radius: var(--cf-radius);
      font-size: .875rem;
      outline: none;
      transition: border-color .18s, box-shadow .18s;
      background: #fff;
      color: #1f2937;
    }
    .cf-input:focus {
      border-color: var(--cf-green);
      box-shadow: 0 0 0 3px rgba(5,150,105,.12);
    }
    .cf-input::placeholder { color: #9ca3af; }

    /* ── Badge ──────────────────────────────────────────────── */
    .cf-badge {
      display: inline-flex; align-items: center;
      padding: .2rem .65rem;
      border-radius: 20px;
      font-size: .72rem; font-weight: 600;
      white-space: nowrap;
    }
    .cf-badge-green  { background: #dcfce7; color: #15803d; }
    .cf-badge-amber  { background: #fef9c3; color: #92400e; }
    .cf-badge-red    { background: #fee2e2; color: #b91c1c; }
    .cf-badge-blue   { background: #dbeafe; color: #1d4ed8; }
    .cf-badge-gray   { background: #f3f4f6; color: #6b7280; }
    .cf-badge-purple { background: #ede9fe; color: #6d28d9; }

    /* ── Section header ─────────────────────────────────────── */
    .cf-section-title {
      font-size: 1.5rem; font-weight: 800; color: #1f2937;
      display: flex; align-items: center; gap: .6rem;
    }
    .cf-section-title::before {
      content: ''; display: block;
      width: 4px; height: 1.4rem;
      background: var(--cf-green); border-radius: 4px; flex-shrink: 0;
    }

    /* ── Hero gradient ──────────────────────────────────────── */
    .cf-hero {
      background: linear-gradient(135deg, #064e3b 0%, #065f46 40%, #047857 100%);
      position: relative; overflow: hidden;
    }
    .cf-hero::before {
      content: '';
      position: absolute; inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    /* ── Page header bar ────────────────────────────────────── */
    .cf-page-header {
      background: linear-gradient(135deg, #059669, #10b981);
      border-radius: var(--cf-radius-xl);
      padding: 2rem 2.5rem;
      color: #fff;
      margin-bottom: 2rem;
    }

    /* ── Animations ─────────────────────────────────────────── */
    @keyframes cfFadeUp   { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
    @keyframes cfFadeIn   { from { opacity:0; } to { opacity:1; } }
    @keyframes cfSlideIn  { from { opacity:0; transform:translateX(-12px); } to { opacity:1; transform:translateX(0); } }
    .cf-fade-up  { animation: cfFadeUp  .4s ease both; }
    .cf-fade-in  { animation: cfFadeIn  .5s ease both; }
    .cf-slide-in { animation: cfSlideIn .35s ease both; }
    .cf-delay-1  { animation-delay: .08s; }
    .cf-delay-2  { animation-delay: .16s; }
    .cf-delay-3  { animation-delay: .24s; }
    .cf-delay-4  { animation-delay: .32s; }

    /* ── Line clamp helpers ─────────────────────────────────── */
    .line-clamp-2 { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .line-clamp-3 { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }

    /* ── Scrollbar ──────────────────────────────────────────── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* ── Focus ring ─────────────────────────────────────────── */
    :focus-visible { outline: 2px solid var(--cf-green); outline-offset: 2px; }
  </style>
</head>
