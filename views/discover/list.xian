{{>head}}
<body class="bg-gray-50">
  {{>nav}}

  <main class="max-w-7xl mx-auto px-4 py-9">
    <a href="/discover" class="inline-flex items-center gap-2 text-emerald-700 font-semibold text-sm mb-6 hover:text-emerald-800">
      <i class="fas fa-arrow-left"></i> All visitor information
    </a>

    <section class="cf-page-header cf-fade-up">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5">
        <div>
          <p class="text-emerald-100 text-sm font-semibold"><i class="fas {{module.icon}} mr-2"></i>Published archive</p>
          <h1 class="text-3xl md:text-4xl font-extrabold mt-2">{{module.label}}</h1>
          <p class="text-emerald-100 mt-2">{{module.description}}</p>
        </div>
        <form action="/discover/{{module.segment}}" method="GET" class="flex w-full lg:max-w-md">
          <label class="sr-only" for="category-search">Search {{module.label}}</label>
          <input id="category-search" name="q" value="{{q}}" maxlength="100" placeholder="Search this category..." class="flex-1 min-w-0 px-4 py-3 rounded-l-xl text-gray-900 outline-none" />
          <button type="submit" class="px-5 bg-emerald-950 text-white rounded-r-xl hover:bg-gray-900"><i class="fas fa-search"></i></button>
        </form>
      </div>
    </section>

    <div class="flex items-center justify-between gap-4 mb-6">
      <p class="text-sm text-gray-500"><strong class="text-gray-800">{{total}}</strong> published record(s){{#if q}} matching “{{q}}”{{/if}}</p>
      <a href="/discover/search" class="text-sm font-semibold text-emerald-700 hover:text-emerald-800"><i class="fas fa-magnifying-glass mr-1"></i>Search all categories</a>
    </div>

    {{#if items.length}}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {{#each items}}
      <a href="{{this.url}}" class="cf-card group p-6 hover:-translate-y-1 hover:shadow-lg transition-all">
        <div class="flex items-start justify-between gap-3">
          <span class="cf-badge cf-badge-green">{{this.categoryLabel}}</span>
          {{#if this.featured}}<i class="fas fa-star text-amber-400" title="Featured"></i>{{/if}}
        </div>
        <h2 class="text-xl font-bold text-gray-900 mt-4 group-hover:text-emerald-700 transition-colors">{{this.title}}</h2>
        <p class="text-gray-500 text-sm mt-2 leading-relaxed line-clamp-3">{{#if this.summary}}{{this.summary}}{{else}}{{this.description}}{{/if}}</p>
        {{#if this.location}}<p class="text-xs text-gray-500 mt-4"><i class="fas fa-location-dot text-emerald-600 mr-1"></i>{{this.location}}</p>{{/if}}
        <span class="inline-flex items-center gap-2 text-emerald-600 font-semibold text-sm mt-5">Read published record <i class="fas fa-arrow-right text-xs"></i></span>
      </a>
      {{/each}}
    </div>
    {{else}}
    <div class="cf-card p-14 text-center">
      <i class="fas fa-book-open text-5xl text-gray-200"></i>
      <h2 class="text-xl font-bold text-gray-700 mt-4">No published records found</h2>
      <p class="text-gray-500 text-sm mt-2">Try a different keyword or check again after the Visitor Information team publishes new content.</p>
    </div>
    {{/if}}

    {{#if hasPrevious}}
    <nav class="mt-8 flex items-center justify-center gap-3" aria-label="Pagination">
      <a href="/discover/{{module.segment}}?q={{qEncoded}}&page={{previousPage}}" class="cf-btn cf-btn-outline"><i class="fas fa-arrow-left"></i> Previous</a>
      <span class="text-sm text-gray-500">Page {{page}} of {{pages}}</span>
      {{#if hasNext}}<a href="/discover/{{module.segment}}?q={{qEncoded}}&page={{nextPage}}" class="cf-btn cf-btn-outline">Next <i class="fas fa-arrow-right"></i></a>{{/if}}
    </nav>
    {{else}}
      {{#if hasNext}}
      <nav class="mt-8 flex items-center justify-center gap-3" aria-label="Pagination">
        <span class="text-sm text-gray-500">Page {{page}} of {{pages}}</span>
        <a href="/discover/{{module.segment}}?q={{qEncoded}}&page={{nextPage}}" class="cf-btn cf-btn-outline">Next <i class="fas fa-arrow-right"></i></a>
      </nav>
      {{/if}}
    {{/if}}
  </main>

  {{>footer}}
</body>
</html>
