{{>head}}
<body class="bg-gray-50">
  {{>nav}}

  <div class="max-w-5xl mx-auto px-4 py-8">
    <!-- Back -->
    <a href="/heritage" class="inline-flex items-center gap-2 text-emerald-600 hover:text-emerald-700 font-semibold text-sm mb-6 transition-colors cf-fade-up">
      <i class="fas fa-arrow-left"></i> Back to Heritage Sites
    </a>

    <div class="cf-card overflow-hidden cf-fade-up">
      <!-- Hero image -->
      <div class="relative h-72 md:h-96 overflow-hidden bg-emerald-100">
        <img src="{{heritage.image_url}}" alt="{{heritage.title}}"
             class="w-full h-full object-cover"
             onerror="this.src='/images/logo.png'" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
        <div class="absolute bottom-5 left-6 right-6 flex flex-wrap items-end justify-between gap-3">
          <div>
            <span class="cf-badge cf-badge-green capitalize mb-2 block w-fit">{{heritage.category}}</span>
            <h1 class="text-2xl md:text-3xl font-extrabold text-white leading-tight">{{heritage.title}}</h1>
          </div>
          <div class="flex items-center gap-1.5 text-white text-sm bg-black/40 px-3 py-1.5 rounded-lg backdrop-blur-sm flex-shrink-0">
            <i class="fas fa-map-marker-alt text-emerald-400"></i>
            <span>{{heritage.location}}</span>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="p-6 md:p-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Main content -->
          <div class="md:col-span-2 space-y-6">
            <div>
              <h2 class="cf-section-title mb-3 text-base">About this Site</h2>
              <p class="text-gray-700 leading-relaxed">{{heritage.description}}</p>
            </div>

            {{#if heritage.historical_significance}}
            <div>
              <h2 class="cf-section-title mb-3 text-base">Historical Significance</h2>
              <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-5">
                <p class="text-gray-700 leading-relaxed">{{heritage.historical_significance}}</p>
              </div>
            </div>
            {{/if}}
          </div>

          <!-- Sidebar info -->
          <div class="space-y-4">
            <div class="cf-card-green p-5">
              <h3 class="font-bold text-gray-800 mb-3 text-sm">Site Details</h3>
              <div class="space-y-3">
                <div class="flex items-start gap-2.5">
                  <i class="fas fa-tag text-emerald-600 mt-0.5 text-xs w-4"></i>
                  <div>
                    <p class="text-xs text-gray-400">Category</p>
                    <p class="text-sm font-semibold text-gray-700 capitalize">{{heritage.category}}</p>
                  </div>
                </div>
                <div class="flex items-start gap-2.5">
                  <i class="fas fa-map-marker-alt text-emerald-600 mt-0.5 text-xs w-4"></i>
                  <div>
                    <p class="text-xs text-gray-400">Location</p>
                    <p class="text-sm font-semibold text-gray-700">{{heritage.location}}</p>
                  </div>
                </div>
                {{#if heritage.year_established}}
                <div class="flex items-start gap-2.5">
                  <i class="fas fa-calendar text-emerald-600 mt-0.5 text-xs w-4"></i>
                  <div>
                    <p class="text-xs text-gray-400">Year Established</p>
                    <p class="text-sm font-semibold text-gray-700">{{heritage.year_established}}</p>
                  </div>
                </div>
                {{/if}}
              </div>
            </div>

            <!-- CTA -->
            <div class="cf-page-header p-5 text-center" style="border-radius:12px;padding:1.25rem;">
              <i class="fas fa-compass text-2xl text-white mb-2"></i>
              <p class="text-white font-bold text-sm mb-3">Explore More</p>
              <a href="/heritage" class="cf-btn bg-white text-emerald-700 hover:bg-emerald-50 w-full justify-center text-xs">
                All Heritage Sites
              </a>
            </div>
          </div>
        </div>

        <!-- Related heritage -->
        {{#if relatedHeritage.length}}
        <div class="mt-8 pt-6 border-t border-gray-100">
          <h2 class="cf-section-title mb-5 text-base">Related Heritage Sites</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {{#each relatedHeritage}}
            <a href="/heritage/{{this.id}}" class="group cf-card overflow-hidden hover:shadow-md transition-all">
              <img src="{{this.image_url}}" alt="{{this.title}}"
                   class="w-full h-32 object-cover group-hover:scale-105 transition-transform duration-300"
                   onerror="this.src='/images/logo.png'" />
              <div class="p-3">
                <h4 class="font-semibold text-gray-800 text-sm group-hover:text-emerald-600 transition-colors line-clamp-1">{{this.title}}</h4>
                <p class="text-xs text-gray-400 mt-0.5 flex items-center gap-1">
                  <i class="fas fa-map-marker-alt"></i> {{this.location}}
                </p>
              </div>
            </a>
            {{/each}}
          </div>
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  {{>footer}}
</body>
</html>
