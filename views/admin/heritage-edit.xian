{{>head}}
<body class="min-h-screen relative overflow-x-hidden">
  <!-- Background Photo with Overlay -->
  <div class="fixed inset-0 z-0">
    <img 
      src="https://www.travelorientalmindoro.ph/Content/img/uploads/ae0f29d5-19bd-42aa-bf3f-5f5dd7da4b45.jpg" 
      alt="Oriental Mindoro Heritage Background" 
      class="w-full h-full object-cover"
    >
    <div class="absolute inset-0 bg-gradient-to-br from-emerald-900/80 via-emerald-800/70 to-teal-900/90 backdrop-blur-[1px]"></div>
  </div>

  <div class="flex relative z-10">
    <!-- Enhanced Sidebar -->
    <aside class="w-72 bg-gradient-to-b from-emerald-800/95 via-emerald-700/90 to-emerald-900/95 text-white min-h-screen p-6 shadow-2xl relative overflow-hidden backdrop-blur-sm">
      <!-- Animated Background Pattern -->
      <div class="absolute inset-0 bg-white/5 bg-[linear-gradient(45deg,transparent_25%,rgba(255,255,255,.1)_50%,transparent_75%,transparent_100%)] bg-[length:10px_10px] animate-pulse-slow"></div>
      
      <div class="relative z-10">
        <!-- Logo Section -->
        <div class="flex items-center space-x-3 mb-10 p-4 bg-white/10 rounded-2xl backdrop-blur-sm border border-white/20">
          <div class="w-12 h-12 bg-gradient-to-r from-emerald-400 to-green-400 rounded-xl flex items-center justify-center shadow-lg">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold bg-gradient-to-r from-emerald-200 to-green-200 bg-clip-text text-transparent">CultureFrame</h2>
            <p class="text-emerald-200 text-xs">Admin Panel</p>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="space-y-2 mb-8">
          <a href="/admin" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
              </svg>
            </div>
            <span class="font-medium">Dashboard</span>
          </a>
          
          <a href="/admin/heritage" class="flex items-center space-x-3 py-3 px-4 bg-white/20 rounded-xl border border-white/20 backdrop-blur-sm transform transition-all duration-300 hover:scale-105 hover:bg-white/25 group">
            <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center group-hover:bg-white/30 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="font-medium">Heritage</span>
          </a>
          
          <a href="/admin/products" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3z"></path>
              </svg>
            </div>
            <span class="font-medium">Products</span>
          </a>
          
          <a href="/admin/orders" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="font-medium">Orders</span>
          </a>
          
          <a href="/admin/events" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="font-medium">Events</span>
          </a>

          <a href="/admin/scenic" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 2a6 6 0 00-6 6v6a2 2 0 002 2h8a2 2 0 002-2V8a6 6 0 00-6-6zM8 10a2 2 0 114 0 2 2 0 01-4 0z"></path>
              </svg>
            </div>
            <span class="font-medium">Scenic</span>
          </a>

          <a href="/admin/crafts" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M4 3a1 1 0 000 2h12a1 1 0 100-2H4zm0 5a1 1 0 000 2h12a1 1 0 100-2H4zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"></path>
              </svg>
            </div>
            <span class="font-medium">Crafts</span>
          </a>
        </nav>

        <!-- Logout Button -->
        <a href="/logout" class="flex items-center space-x-3 py-3 px-4 bg-gradient-to-r from-green-600 to-emerald-600 rounded-xl transform transition-all duration-300 hover:scale-105 hover:from-green-700 hover:to-emerald-700 shadow-lg group">
          <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center group-hover:bg-white/30 transition-colors">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <span class="font-medium">Logout</span>
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-4xl font-bold text-white mb-2 bg-gradient-to-r from-white to-emerald-100 bg-clip-text text-transparent drop-shadow-lg">Add New Heritage</h1>
        <p class="text-emerald-100 text-lg drop-shadow">Preserve Oriental Mindoro's cultural treasures for future generations</p>
      </div>

       <!-- Enhanced Form with Mansalay Beach Background - More Transparent Overlay -->
       <div class="rounded-2xl shadow-2xl p-8 border border-white/20 max-w-4xl heritage-form"
         style="background-image: linear-gradient(rgba(255,255,255,0.65), rgba(255,255,255,0.75)), url('https://letmetravelph.wordpress.com/wp-content/uploads/2016/10/hidden-beach.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat; backdrop-filter: blur(8px);">
        <!-- Form Header -->
        <div class="flex items-center space-x-3 mb-8 pb-6 border-b border-emerald-100">
          <div class="w-12 h-12 bg-gradient-to-r from-emerald-100 to-green-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z"></path>
            </svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-emerald-800">Create New Heritage Entry</h2>
            <p class="text-emerald-600">Document and preserve cultural heritage from Oriental Mindoro</p>
          </div>
        </div>

        <form method="POST" action="/admin/heritage/add" enctype="multipart/form-data" class="space-y-6">
          <!-- Title -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>Title</span>
              <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              name="title" 
              required 
              class="w-full p-4 bg-white/80 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-sm"
              placeholder="Enter heritage title (e.g., 'Pahiyas Festival' or 'Mt. Halcon')"
            >
          </div>

          <!-- Category -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>Category</span>
              <span class="text-red-500">*</span>
            </label>
            <select 
              name="category" 
              required 
              class="w-full p-4 bg-white/80 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 font-medium appearance-none cursor-pointer shadow-sm"
            >
              <option value="" disabled selected>Select a category</option>
              <option value="landmark">Landmark</option>
              <option value="tradition">Tradition</option>
              <option value="fiesta">Fiesta</option>
            </select>
          </div>

          <!-- Location -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>Location</span>
              <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              name="location" 
              required 
              class="w-full p-4 bg-white/80 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-sm"
              placeholder="Enter location in Oriental Mindoro (e.g., 'Calapan City', 'Puerto Galera')"
            >
          </div>

          <!-- Image URL -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>Heritage Image (Upload)</span>
            </label>
            <input 
              type="file" 
              name="image_file" 
              accept="image/*"
              class="w-full p-4 bg-white/80 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-sm"
            >
            <div class="text-xs text-gray-700 mt-2">Or paste an image URL below:</div>
            <input 
              type="text" 
              name="image_url" 
              class="w-full p-4 bg-white/80 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-sm mt-2"
              placeholder="https://example.com/heritage-image.jpg"
            >
            <p class="text-xs text-emerald-700 mt-2">Provide a direct link to a high-quality image representing this heritage</p>
          </div>

          <!-- Description -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>Description</span>
              <span class="text-red-500">*</span>
            </label>
            <textarea 
              name="description" 
              required 
              rows="4" 
              class="w-full p-4 bg-white/80 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium resize-none shadow-sm"
              placeholder="Describe this heritage site or tradition in detail. Include cultural practices, significance, and current state..."
            ></textarea>
          </div>

          <!-- Historical Significance -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>Historical Significance</span>
            </label>
            <textarea 
              name="historical_significance" 
              rows="4" 
              class="w-full p-4 bg-white/80 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium resize-none shadow-sm"
              placeholder="Explain the historical and cultural importance to Oriental Mindoro. Include origins, evolution, and impact on local communities..."
            ></textarea>
          </div>

          <!-- Year Established -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>Year Established / Origin</span>
            </label>
            <input 
              type="text" 
              name="year_established" 
              class="w-full p-4 bg-white/80 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-sm"
              placeholder="e.g., '1920', 'Pre-colonial era', 'Spanish period'"
            >
          </div>

          <!-- Cultural Practices -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>Cultural Practices</span>
            </label>
            <textarea 
              name="cultural_practices" 
              rows="3" 
              class="w-full p-4 bg-white/80 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium resize-none shadow-sm"
              placeholder="Describe associated rituals, ceremonies, or traditional practices..."
            ></textarea>
          </div>

          <!-- Buttons -->
          <div class="flex space-x-4 pt-6 border-t border-emerald-100">
            <button 
              type="submit" 
              class="flex-1 bg-gradient-to-r from-emerald-500 to-green-500 hover:from-emerald-600 hover:to-green-600 text-white py-4 px-6 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2 group/btn border border-white/20"
            >
              <svg class="w-5 h-5 transform group-hover/btn:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              <span>Create Heritage</span>
            </button>
            
            <a 
              href="/admin/heritage" 
              class="flex-1 bg-gradient-to-r from-gray-300 to-gray-400 hover:from-gray-400 hover:to-gray-500 text-gray-700 py-4 px-6 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2 group/cancel border border-gray-200"
            >
              <svg class="w-5 h-5 transform group-hover/cancel:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <span>Cancel</span>
            </a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    // Enhanced form interactions for Add Heritage
    document.addEventListener('DOMContentLoaded', function() {
      const inputs = document.querySelectorAll('input, textarea, select');
      const form = document.querySelector('form');
      
      // Add focus animations
      inputs.forEach(input => {
        input.addEventListener('focus', function() {
          this.parentElement.classList.add('transform', 'scale-[1.02]');
        });
        
        input.addEventListener('blur', function() {
          this.parentElement.classList.remove('transform', 'scale-[1.02]');
        });
        
        // Add typing animation with color feedback
        input.addEventListener('input', function() {
          if (this.value) {
            this.classList.add('border-emerald-300', 'bg-white');
          } else {
            this.classList.remove('border-emerald-300', 'bg-white');
          }
        });
      });
      
      // Form submission animation with enhanced feedback
      form.addEventListener('submit', function(e) {
        const submitBtn = this.querySelector('button[type="submit"]');
        const inputs = this.querySelectorAll('input[required], textarea[required], select[required]');
        let isValid = true;
        
        // Validate required fields
        inputs.forEach(input => {
          if (!input.value.trim()) {
            input.classList.add('border-red-300', 'bg-red-50/50');
            isValid = false;
          } else {
            input.classList.remove('border-red-300', 'bg-red-50/50');
          }
        });
        
        if (!isValid) {
          e.preventDefault();
          submitBtn.classList.add('animate-pulse', 'bg-gradient-to-r', 'from-red-500', 'to-pink-500');
          setTimeout(() => {
            submitBtn.classList.remove('animate-pulse', 'bg-gradient-to-r', 'from-red-500', 'to-pink-500');
            submitBtn.classList.add('bg-gradient-to-r', 'from-emerald-500', 'to-green-500');
          }, 2000);
          
          // Scroll to first error
          const firstError = this.querySelector('.border-red-300');
          if (firstError) {
            firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          return;
        }
        
        // Success animation
        submitBtn.classList.add('animate-pulse');
        submitBtn.innerHTML = `
          <svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          <span>Creating Heritage...</span>
        `;
        
        setTimeout(() => {
          submitBtn.classList.remove('animate-pulse');
          submitBtn.innerHTML = `
            <svg class="w-5 h-5 transform group-hover/btn:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            <span>Create Heritage</span>
          `;
        }, 2000);
      });
      
      // Add character counter for textareas
      const textareas = document.querySelectorAll('textarea');
      textareas.forEach(textarea => {
        const counter = document.createElement('div');
        counter.className = 'text-xs text-emerald-700 text-right mt-1 opacity-0 transition-opacity duration-300';
        textarea.parentNode.appendChild(counter);
        
        textarea.addEventListener('input', function() {
          const count = this.value.length;
          counter.textContent = `${count} characters`;
          counter.style.opacity = count > 0 ? '1' : '0';
          
          if (count > 1000) {
            counter.classList.add('text-orange-600');
          } else {
            counter.classList.remove('text-orange-600');
          }
        });
      });
      
      // Add image preview functionality
      const imageUrlInput = document.querySelector('input[name="image_url"]');
      const imagePreview = document.createElement('div');
      imagePreview.className = 'mt-2 hidden';
      imageUrlInput.parentNode.appendChild(imagePreview);
      
      imageUrlInput.addEventListener('blur', function() {
        const url = this.value.trim();
        if (url && isValidUrl(url)) {
          imagePreview.innerHTML = `
            <div class="bg-emerald-50/80 rounded-lg p-3 border border-emerald-200">
              <p class="text-sm text-emerald-700 font-medium mb-2">Image Preview:</p>
              <img src="${url}" alt="Preview" class="max-w-full h-32 object-cover rounded-lg border border-emerald-200" onerror="this.style.display='none'" />
              <p class="text-xs text-emerald-700 mt-2">Image will load if URL is valid</p>
            </div>
          `;
          imagePreview.classList.remove('hidden');
        } else {
          imagePreview.classList.add('hidden');
        }
      });
      
      function isValidUrl(string) {
        try {
          new URL(string);
          return true;
        } catch (_) {
          return false;
        }
      }
    });
  </script>

  <style>
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pulseSlow {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.8;
      }
    }

    .animate-fade-in {
      animation: fadeIn 0.6s ease-out forwards;
    }

    .animate-pulse-slow {
      animation: pulseSlow 4s ease-in-out infinite;
    }

    /* Custom select arrow */
    select {
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2310b981' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
      background-position: right 0.75rem center;
      background-repeat: no-repeat;
      background-size: 1.5em 1.5em;
      padding-right: 2.5rem;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Custom scrollbar for textareas */
    textarea::-webkit-scrollbar {
      width: 6px;
    }

    textarea::-webkit-scrollbar-track {
      background: rgba(16, 185, 129, 0.1);
      border-radius: 3px;
    }

    textarea::-webkit-scrollbar-thumb {
      background: rgba(16, 185, 129, 0.3);
      border-radius: 3px;
    }

    textarea::-webkit-scrollbar-thumb:hover {
      background: rgba(16, 185, 129, 0.5);
    }

    /* Enhanced focus states */
    input:focus, textarea:focus, select:focus {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.2);
    }

    /* Loading animation for form submission */
    @keyframes shimmer {
      0% {
        background-position: -200px 0;
      }
      100% {
        background-position: 200px 0;
      }
    }

    .loading-shimmer {
      animation: shimmer 1.5s infinite linear;
      background: linear-gradient(
        to right,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.4) 50%,
        rgba(255, 255, 255, 0) 100%
      );
      background-size: 200px 100%;
    }

    /* Force readable text inside the heritage form */
    .heritage-form h2,
    .heritage-form p,
    .heritage-form label,
    .heritage-form input,
    .heritage-form textarea,
    .heritage-form select,
    .heritage-form .text-xs,
    .heritage-form option {
      color: #1f2937 !important;
    }

    .heritage-form input::placeholder,
    .heritage-form textarea::placeholder {
      color: #6b7280 !important;
    }
  </style>
</body>
</html>

