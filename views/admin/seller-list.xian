<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} - CultureFrame Admin</title>
  <link rel="stylesheet" href="/tailwind.css" />
</head>
<body class="bg-gray-50 flex">
  {{> admin-sidebar}}

  <main class="flex-1 p-8 overflow-auto">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Seller Management</h1>
        <p class="text-gray-500 mt-1">Manage all registered sellers and partners</p>
      </div>
      <a href="/admin/sellers/add"
         class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl font-semibold transition-colors shadow-lg">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Add Seller
      </a>
    </div>

    <!-- Flash messages -->
    {{#if success_msg}}<div class="mb-4 p-4 bg-green-100 border border-green-300 text-green-800 rounded-xl">{{success_msg}}</div>{{/if}}
    {{#if error_msg}}<div class="mb-4 p-4 bg-red-100 border border-red-300 text-red-800 rounded-xl">{{error_msg}}</div>{{/if}}

    <!-- Stat cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <a href="/admin/sellers?status=all"
         class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow {{#if (eq filter 'all')}}ring-2 ring-emerald-400{{/if}}">
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Total</p>
        <p class="text-3xl font-bold text-gray-800">{{counts.all}}</p>
      </a>
      <a href="/admin/sellers?status=active"
         class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow {{#if (eq filter 'active')}}ring-2 ring-emerald-400{{/if}}">
        <p class="text-xs text-green-600 uppercase tracking-wide mb-1">Active</p>
        <p class="text-3xl font-bold text-green-600">{{counts.active}}</p>
      </a>
      <a href="/admin/sellers?status=pending"
         class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow {{#if (eq filter 'pending')}}ring-2 ring-emerald-400{{/if}}">
        <p class="text-xs text-yellow-600 uppercase tracking-wide mb-1">Pending</p>
        <p class="text-3xl font-bold text-yellow-600">{{counts.pending}}</p>
      </a>
      <a href="/admin/sellers?status=inactive"
         class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow {{#if (eq filter 'inactive')}}ring-2 ring-emerald-400{{/if}}">
        <p class="text-xs text-red-500 uppercase tracking-wide mb-1">Inactive</p>
        <p class="text-3xl font-bold text-red-500">{{counts.inactive}}</p>
      </a>
    </div>

    <!-- Search + filter -->
    <form method="GET" action="/admin/sellers" class="flex gap-3 mb-6">
      <input type="text" name="search" value="{{search}}" placeholder="Search sellers..."
             class="flex-1 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-emerald-400 focus:outline-none" />
      <input type="hidden" name="status" value="{{filter}}" />
      <button type="submit" class="bg-emerald-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-emerald-700 transition-colors">Search</button>
      <a href="/admin/sellers" class="border border-gray-300 text-gray-600 px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-gray-50 transition-colors">Reset</a>
    </form>

    <!-- Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-50 border-b border-gray-100">
          <tr>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Business</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Contact</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Category</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Commission</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          {{#each sellers}}
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4">
              <p class="font-semibold text-gray-800">{{business_name}}</p>
              <p class="text-xs text-gray-400">{{email}}</p>
            </td>
            <td class="px-6 py-4">
              <p class="text-sm text-gray-700">{{contact_name}}</p>
              <p class="text-xs text-gray-400">{{phone}}</p>
            </td>
            <td class="px-6 py-4">
              <span class="text-sm text-gray-600 capitalize">{{category}}</span>
            </td>
            <td class="px-6 py-4">
              <span class="text-sm font-semibold text-gray-700">{{commission_rate}}%</span>
            </td>
            <td class="px-6 py-4">
              {{#if (eq status 'active')}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
              {{else if (eq status 'pending')}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Pending</span>
              {{else}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Inactive</span>
              {{/if}}
            </td>
            <td class="px-6 py-4 flex gap-2">
              <a href="/admin/sellers/edit/{{id}}"
                 class="text-xs bg-emerald-100 text-emerald-700 hover:bg-emerald-200 px-3 py-1.5 rounded-lg font-medium transition-colors">Edit</a>
              <form method="POST" action="/admin/sellers/delete/{{id}}" onsubmit="return confirm('Delete this seller?')">
                <button type="submit"
                        class="text-xs bg-red-100 text-red-600 hover:bg-red-200 px-3 py-1.5 rounded-lg font-medium transition-colors">Delete</button>
              </form>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="6" class="text-center py-16 text-gray-400">No sellers found.</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
