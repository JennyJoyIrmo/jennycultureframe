{{>head}}
<body class="bg-gray-50 flex">
  {{> admin-sidebar activePage="crafts"}}
    <main class="flex-1 p-8">
      <!-- Header -->
      <div class="mb-8 animate-fade-in-down">
        <h1 class="text-4xl font-bold text-gray-800">Add New Craft</h1>
        <p class="text-gray-500 text-base">Create a new traditional craft entry</p>
      </div>

      <!-- Form Container -->
      <div class="max-w-4xl mx-auto bg-white/70 backdrop-blur-lg rounded-2xl shadow-2xl p-8 border border-white/30 animate-fade-in-up">
        <!-- Form Header -->
        <div class="flex items-center space-x-3 mb-8 pb-6 border-b border-emerald-100">
          <div class="w-12 h-12 bg-gradient-to-r from-emerald-100 to-green-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-emerald-800 drop-shadow-sm">Craft Details</h2>
            <p class="text-emerald-700 font-medium drop-shadow-sm">Fill in the information about the traditional craft</p>
          </div>
        </div>

        {{>messages}}
        <form id="craft-form" action="/admin/crafts/add" method="POST" enctype="multipart/form-data" class="space-y-6">
          <!-- Title -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2 drop-shadow-sm">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"></path>
              </svg>
              <span>Craft Title</span>
              <span class="text-red-500">*</span>
            </label>
            <input 
              name="title" 
              required 
              class="w-full p-4 bg-white/70 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-lg backdrop-blur-sm"
              placeholder="Enter craft name (e.g., 'Mangyan Weaving', 'Bamboo Crafts')"
            />
          </div>

          <!-- Description -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2 drop-shadow-sm">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
              </svg>
              <span>Description</span>
            </label>
            <textarea 
              name="description" 
              rows="4" 
              class="w-full p-4 bg-white/70 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium resize-none shadow-lg backdrop-blur-sm"
              placeholder="Describe the craft, its history, techniques, and cultural significance..."
            ></textarea>
          </div>

          <!-- Hidden fields for location data -->
          <input type="hidden" name="location" id="location" value="Mansalay, Oriental Mindoro" />
          <input type="hidden" name="latitude" id="latitude" value="12.5167" />
          <input type="hidden" name="longitude" id="longitude" value="121.4500" />

          <!-- Image Upload -->
          <div class="group">
            <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2 drop-shadow-sm">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
              </svg>
              <span>Craft Image</span>
            </label>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <input 
                  id="image_file" 
                  name="image_file" 
                  type="file" 
                  accept="image/*" 
                  class="block w-full text-sm text-emerald-700 bg-white/70 border-2 border-emerald-100 rounded-xl cursor-pointer focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 shadow-lg backdrop-blur-sm p-3"
                />
                <p class="text-xs text-emerald-700 font-medium drop-shadow-sm mt-2">Upload an image file</p>
              </div>
              <div>
                <input 
                  id="image_url" 
                  name="image_url" 
                  placeholder="Or paste image URL (https://...)" 
                  class="w-full p-4 bg-white/70 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-lg backdrop-blur-sm"
                />
                <p class="text-xs text-emerald-700 font-medium drop-shadow-sm mt-2">Or provide a direct image URL</p>
              </div>
            </div>
            <div class="mt-4">
              <p class="text-xs text-emerald-700 font-medium mb-2 drop-shadow-sm">Image Preview:</p>
              <div class="w-full h-64 bg-gradient-to-br from-emerald-50 to-green-50 rounded-xl overflow-hidden border-2 border-emerald-200 flex items-center justify-center shadow-lg">
                <img id="image-preview" src="" alt="Image preview" class="w-full h-full object-contain" style="display: none;" />
                <div id="preview-placeholder" class="text-center text-emerald-400">
                  <svg class="w-16 h-16 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <p class="text-sm font-medium">No image selected</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Buttons -->
          <div class="flex space-x-4 pt-6 border-t border-emerald-100">
            <button 
              type="submit" 
              class="flex-1 bg-gradient-to-r from-emerald-500 to-green-500 hover:from-emerald-600 hover:to-green-600 text-white py-4 px-6 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2 group/btn border border-white/20 backdrop-blur-sm"
            >
              <svg class="w-5 h-5 transform group-hover/btn:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              <span>Add Craft</span>
            </button>
            
            <a 
              href="/admin/crafts" 
              class="flex-1 bg-gradient-to-r from-gray-300 to-gray-400 hover:from-gray-400 hover:to-gray-500 text-gray-700 py-4 px-6 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2 group/cancel border border-gray-200 backdrop-blur-sm"
            >
              <svg class="w-5 h-5 transform group-hover/cancel:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <span>Cancel</span>
            </a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <style>
    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in-down {
      animation: fadeInDown 0.6s ease-out forwards;
    }

    .animate-fade-in-up {
      animation: fadeInUp 0.6s ease-out forwards;
    }

    .animate-pulse-slow {
      animation: pulse 4s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.8;
      }
    }
  </style>

  <script>
    // Enhanced preview for image file or URL
    (function(){
      const fileInput = document.getElementById('image_file');
      const urlInput = document.getElementById('image_url');
      const preview = document.getElementById('image-preview');
      const placeholder = document.getElementById('preview-placeholder');

      function showPreview(src){
        if(!src) { 
          preview.style.display = 'none';
          placeholder.style.display = 'block';
          return; 
        }
        preview.src = src;
        preview.style.display = 'block';
        placeholder.style.display = 'none';
      }

      fileInput && fileInput.addEventListener('change', function(e){
        const f = e.target.files && e.target.files[0];
        if(!f) return;
        const reader = new FileReader();
        reader.onload = function(ev){ showPreview(ev.target.result); };
        reader.readAsDataURL(f);
      });

      urlInput && urlInput.addEventListener('input', function(e){
        const v = e.target.value.trim();
        showPreview(v);
      });

      // Add input animations
      const inputs = document.querySelectorAll('input, textarea');
      inputs.forEach(input => {
        input.addEventListener('focus', function() {
          this.parentElement.classList.add('transform', 'scale-[1.02]');
        });
        
        input.addEventListener('blur', function() {
          this.parentElement.classList.remove('transform', 'scale-[1.02]');
        });
      });
    })();
  </script>
</body>
</html>


