<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} - CultureFrame Admin</title>
  <link rel="stylesheet" href="/tailwind.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="bg-gray-50 flex">
  {{> admin-sidebar}}

  <main class="flex-1 p-8 overflow-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Business Analytics</h1>
        <p class="text-gray-500 mt-1">Overall business health, trends, and performance</p>
      </div>
      <form method="GET" action="/admin/analytics/business" class="flex gap-2 items-center">
        <input type="date" name="start" value="{{dateStart}}" class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-400 focus:outline-none" />
        <span class="text-gray-400 text-sm">to</span>
        <input type="date" name="end" value="{{dateEnd}}" class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-400 focus:outline-none" />
        <button type="submit" class="bg-emerald-600 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-emerald-700 transition-colors">Apply</button>
      </form>
    </div>

    <!-- KPI row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Total Revenue</p>
        <p class="text-3xl font-bold text-emerald-600">₱{{totalRevenue}}</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Total Orders</p>
        <p class="text-3xl font-bold text-gray-800">{{totalOrders}}</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Delivery Rate</p>
        <p class="text-3xl font-bold text-blue-600">{{conversionRate}}%</p>
      </div>
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Avg. Rating</p>
        <p class="text-3xl font-bold text-yellow-500">{{avgRating}} ★</p>
        <p class="text-xs text-gray-400 mt-1">{{totalReviews}} reviews</p>
      </div>
    </div>

    <!-- Sub-KPIs -->
    <div class="grid grid-cols-3 gap-4 mb-8">
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Avg. Order Value</p>
        <p class="text-2xl font-bold text-gray-700">₱{{avgOrderValue}}</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
        <p class="text-xs text-green-600 uppercase tracking-wide mb-1">Delivered Orders</p>
        <p class="text-2xl font-bold text-green-600">{{deliveredOrders}}</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
        <p class="text-xs text-yellow-600 uppercase tracking-wide mb-1">Pending Orders</p>
        <p class="text-2xl font-bold text-yellow-600">{{pendingOrders}}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <!-- Monthly revenue trend -->
      <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h2 class="font-semibold text-gray-700 mb-4">Monthly Revenue Trend</h2>
        <canvas id="monthlyChart" height="120"></canvas>
      </div>

      <!-- Category breakdown -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h2 class="font-semibold text-gray-700 mb-4">Revenue by Category</h2>
        <canvas id="categoryChart" height="200"></canvas>
      </div>
    </div>

    <!-- Quick links to other admin sections -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="/admin/sellers" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow text-center group">
        <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:bg-emerald-200 transition-colors">
          <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
        </div>
        <p class="text-sm font-semibold text-gray-700">Sellers</p>
      </a>
      <a href="/admin/customers" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow text-center group">
        <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:bg-blue-200 transition-colors">
          <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
        </div>
        <p class="text-sm font-semibold text-gray-700">Customers</p>
      </a>
      <a href="/admin/payments" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow text-center group">
        <div class="w-10 h-10 bg-yellow-100 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:bg-yellow-200 transition-colors">
          <svg class="w-5 h-5 text-yellow-600" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"/><path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"/></svg>
        </div>
        <p class="text-sm font-semibold text-gray-700">Payments</p>
      </a>
      <a href="/admin/analytics/sales" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow text-center group">
        <div class="w-10 h-10 bg-purple-100 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:bg-purple-200 transition-colors">
          <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/></svg>
        </div>
        <p class="text-sm font-semibold text-gray-700">Sales Report</p>
      </a>
    </div>
  </main>

  <script>
    const monthlyLabels  = {{{monthlyLabels}}};
    const monthlyRevenue = {{{monthlyRevenue}}};
    const categoryData   = {{{categoryData}}};

    new Chart(document.getElementById('monthlyChart'), {
      type: 'bar',
      data: {
        labels: monthlyLabels,
        datasets: [{
          label: 'Revenue (₱)',
          data: monthlyRevenue,
          backgroundColor: '#059669',
          borderRadius: 8
        }]
      },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });

    const catLabels = Object.keys(categoryData);
    const catValues = Object.values(categoryData);
    if (catLabels.length) {
      new Chart(document.getElementById('categoryChart'), {
        type: 'doughnut',
        data: {
          labels: catLabels,
          datasets: [{ data: catValues, backgroundColor: ['#059669','#3b82f6','#f59e0b','#8b5cf6','#ef4444'] }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
      });
    }
  </script>
</body>
</html>
