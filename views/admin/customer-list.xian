<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} - CultureFrame Admin</title>
  <link rel="stylesheet" href="/tailwind.css" />
</head>
<body class="bg-gray-50 flex">
  {{> admin-sidebar}}

  <main class="flex-1 p-8 overflow-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Customer Management</h1>
        <p class="text-gray-500 mt-1">View and manage all registered customers</p>
      </div>
    </div>

    {{#if success_msg}}<div class="mb-4 p-4 bg-green-100 border border-green-300 text-green-800 rounded-xl">{{success_msg}}</div>{{/if}}
    {{#if error_msg}}<div class="mb-4 p-4 bg-red-100 border border-red-300 text-red-800 rounded-xl">{{error_msg}}</div>{{/if}}

    <!-- Stat cards -->
    <div class="grid grid-cols-3 gap-4 mb-8">
      <a href="/admin/customers?status=all"
         class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow {{#if (eq filter 'all')}}ring-2 ring-emerald-400{{/if}}">
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Total Customers</p>
        <p class="text-3xl font-bold text-gray-800">{{counts.all}}</p>
      </a>
      <a href="/admin/customers?status=active"
         class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow {{#if (eq filter 'active')}}ring-2 ring-emerald-400{{/if}}">
        <p class="text-xs text-green-600 uppercase tracking-wide mb-1">Active</p>
        <p class="text-3xl font-bold text-green-600">{{counts.active}}</p>
      </a>
      <a href="/admin/customers?status=inactive"
         class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-shadow {{#if (eq filter 'inactive')}}ring-2 ring-emerald-400{{/if}}">
        <p class="text-xs text-red-500 uppercase tracking-wide mb-1">Inactive</p>
        <p class="text-3xl font-bold text-red-500">{{counts.inactive}}</p>
      </a>
    </div>

    <!-- Search -->
    <form method="GET" action="/admin/customers" class="flex gap-3 mb-6">
      <input type="text" name="search" value="{{search}}" placeholder="Search by name, email, or phone..."
             class="flex-1 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-emerald-400 focus:outline-none" />
      <input type="hidden" name="status" value="{{filter}}" />
      <button type="submit" class="bg-emerald-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-emerald-700 transition-colors">Search</button>
      <a href="/admin/customers" class="border border-gray-300 text-gray-600 px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-gray-50 transition-colors">Reset</a>
    </form>

    <!-- Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-50 border-b border-gray-100">
          <tr>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Customer</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Contact</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Orders</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Total Spend</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Joined</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          {{#each customers}}
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4">
              <p class="font-semibold text-gray-800">{{name}}</p>
              <p class="text-xs text-gray-400">{{email}}</p>
            </td>
            <td class="px-6 py-4">
              <p class="text-sm text-gray-600">{{phone}}</p>
            </td>
            <td class="px-6 py-4">
              <span class="text-sm font-bold text-gray-700">{{orderCount}}</span>
            </td>
            <td class="px-6 py-4">
              <span class="text-sm font-bold text-emerald-600">₱{{totalSpend}}</span>
            </td>
            <td class="px-6 py-4">
              {{#if (eq status 'active')}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
              {{else}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Inactive</span>
              {{/if}}
            </td>
            <td class="px-6 py-4">
              <p class="text-xs text-gray-500">{{createdAt}}</p>
            </td>
            <td class="px-6 py-4">
              <a href="/admin/customers/{{id}}"
                 class="text-xs bg-emerald-100 text-emerald-700 hover:bg-emerald-200 px-3 py-1.5 rounded-lg font-medium transition-colors">View</a>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="7" class="text-center py-16 text-gray-400">No customers found.</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
