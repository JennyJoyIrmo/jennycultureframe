<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} - CultureFrame Admin</title>
  <link rel="stylesheet" href="/tailwind.css" />
</head>
<body class="bg-gray-50 flex">
  {{> admin-sidebar}}

  <main class="flex-1 p-8 overflow-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-800">Payment Management</h1>
        <p class="text-gray-500 mt-1">Track and manage all customer payments</p>
      </div>
      <a href="/admin/payments/add"
         class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl font-semibold transition-colors shadow-lg">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Record Payment
      </a>
    </div>

    {{#if success_msg}}<div class="mb-4 p-4 bg-green-100 border border-green-300 text-green-800 rounded-xl">{{success_msg}}</div>{{/if}}
    {{#if error_msg}}<div class="mb-4 p-4 bg-red-100 border border-red-300 text-red-800 rounded-xl">{{error_msg}}</div>{{/if}}

    <!-- Summary cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Total Records</p>
        <p class="text-3xl font-bold text-gray-800">{{counts.all}}</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
        <p class="text-xs text-green-600 uppercase tracking-wide mb-1">Paid</p>
        <p class="text-2xl font-bold text-green-600">₱{{totalPaid}}</p>
        <p class="text-xs text-gray-400">{{counts.paid}} transactions</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
        <p class="text-xs text-yellow-600 uppercase tracking-wide mb-1">Pending</p>
        <p class="text-2xl font-bold text-yellow-600">₱{{totalPending}}</p>
        <p class="text-xs text-gray-400">{{counts.pending}} transactions</p>
      </div>
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
        <p class="text-xs text-red-500 uppercase tracking-wide mb-1">Refunded</p>
        <p class="text-2xl font-bold text-red-500">₱{{totalRefunded}}</p>
        <p class="text-xs text-gray-400">{{counts.refunded}} transactions</p>
      </div>
    </div>

    <!-- Status filter tabs -->
    <div class="flex gap-2 mb-4">
      {{#each (array 'all' 'paid' 'pending' 'failed' 'refunded')}}
      <a href="/admin/payments?status={{this}}"
         class="px-4 py-2 rounded-xl text-sm font-semibold transition-colors capitalize
         {{#if (eq ../filter this)}}bg-emerald-600 text-white{{else}}bg-white text-gray-600 border border-gray-200 hover:bg-gray-50{{/if}}">
        {{this}}
      </a>
      {{/each}}
    </div>

    <!-- Search -->
    <form method="GET" action="/admin/payments" class="flex gap-3 mb-6">
      <input type="text" name="search" value="{{search}}" placeholder="Search by customer name, email, or ref #..."
             class="flex-1 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-emerald-400 focus:outline-none" />
      <input type="hidden" name="status" value="{{filter}}" />
      <select name="method" class="border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-emerald-400 focus:outline-none">
        <option value="all" {{#if (eq filterMethod 'all')}}selected{{/if}}>All Methods</option>
        <option value="gcash"          {{#if (eq filterMethod 'gcash')}}selected{{/if}}>GCash</option>
        <option value="cod"            {{#if (eq filterMethod 'cod')}}selected{{/if}}>COD</option>
        <option value="maya"           {{#if (eq filterMethod 'maya')}}selected{{/if}}>Maya</option>
        <option value="bank_transfer"  {{#if (eq filterMethod 'bank_transfer')}}selected{{/if}}>Bank Transfer</option>
        <option value="credit_card"    {{#if (eq filterMethod 'credit_card')}}selected{{/if}}>Credit Card</option>
      </select>
      <button type="submit" class="bg-emerald-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-emerald-700 transition-colors">Search</button>
    </form>

    <!-- Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-50 border-b border-gray-100">
          <tr>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Ref #</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Customer</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Order</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Amount</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Method</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Date</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          {{#each payments}}
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4 text-sm font-mono text-gray-600">{{reference_number}}</td>
            <td class="px-6 py-4">
              <p class="font-semibold text-gray-800 text-sm">{{customer_name}}</p>
              <p class="text-xs text-gray-400">{{customer_email}}</p>
            </td>
            <td class="px-6 py-4 text-sm text-gray-600">#{{order_id}}</td>
            <td class="px-6 py-4 text-sm font-bold text-emerald-600">₱{{amount}}</td>
            <td class="px-6 py-4 text-sm text-gray-600 capitalize">{{method}}</td>
            <td class="px-6 py-4">
              {{#if (eq status 'paid')}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Paid</span>
              {{else if (eq status 'pending')}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Pending</span>
              {{else if (eq status 'failed')}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Failed</span>
              {{else}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Refunded</span>
              {{/if}}
            </td>
            <td class="px-6 py-4 text-xs text-gray-400">{{createdAt}}</td>
            <td class="px-6 py-4">
              <a href="/admin/payments/{{id}}"
                 class="text-xs bg-emerald-100 text-emerald-700 hover:bg-emerald-200 px-3 py-1.5 rounded-lg font-medium transition-colors">View</a>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="8" class="text-center py-16 text-gray-400">No payments found.</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
