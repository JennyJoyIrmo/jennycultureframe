{{>head}}
<body class="bg-gray-50 flex">
  {{> admin-sidebar activePage="heritage"}}

    <main class="flex-1 p-8">
      <!-- Header -->
      <div class="mb-8">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-4xl font-bold text-gray-800">Heritage Management</h1>
            <p class="text-gray-500 text-base">Preserving Oriental Mindoro's Cultural Treasures</p>
          </div>
          <a 
            href="/admin/heritage/add" 
            class="bg-gradient-to-r from-emerald-500 to-green-500 hover:from-emerald-600 hover:to-green-600 text-white px-6 py-3 rounded-xl font-semibold shadow-2xl hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300 flex items-center space-x-2 group backdrop-blur-sm border border-white/20"
          >
            <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            <span>Add Heritage Site</span>
          </a>
        </div>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white/90 backdrop-blur-md rounded-2xl p-6 shadow-2xl border border-white/20 transform transition-all duration-300 hover:scale-105 hover:shadow-2xl">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Total Heritage</p>
              <h3 class="text-3xl font-bold text-gray-800 mt-2">{{heritages.length}}</h3>
            </div>
            <div class="w-12 h-12 bg-gradient-to-r from-emerald-100 to-green-100 rounded-xl flex items-center justify-center shadow-lg">
              <svg class="w-6 h-6 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white/90 backdrop-blur-md rounded-2xl p-6 shadow-2xl border border-white/20 transform transition-all duration-300 hover:scale-105 hover:shadow-2xl">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Active Sites</p>
              <h3 class="text-3xl font-bold text-gray-800 mt-2">{{activeCount}}</h3>
            </div>
            <div class="w-12 h-12 bg-gradient-to-r from-green-100 to-emerald-100 rounded-xl flex items-center justify-center shadow-lg">
              <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white/90 backdrop-blur-md rounded-2xl p-6 shadow-2xl border border-white/20 transform transition-all duration-300 hover:scale-105 hover:shadow-2xl">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Categories</p>
              <h3 class="text-3xl font-bold text-gray-800 mt-2">{{categoriesCount}}</h3>
            </div>
            <div class="w-12 h-12 bg-gradient-to-r from-blue-100 to-cyan-100 rounded-xl flex items-center justify-center shadow-lg">
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M17 10a1.5 1.5 0 01-1.5 1.5H14a1 1 0 100 2h1.5A3.5 3.5 0 1014 8.5H13a1 1 0 00-1 1v4a1 1 0 102 0v-1h.5a1.5 1.5 0 011.5 1.5zM8.5 5H10a1 1 0 100-2H8.5A3.5 3.5 0 005 6.5V8a1 1 0 002 0v-.5A1.5 1.5 0 018.5 6z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white/90 backdrop-blur-md rounded-2xl p-6 shadow-2xl border border-white/20 transform transition-all duration-300 hover:scale-105 hover:shadow-2xl">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-600 text-sm font-medium">Locations</p>
              <h3 class="text-3xl font-bold text-gray-800 mt-2">{{locationsCount}}</h3>
            </div>
            <div class="w-12 h-12 bg-gradient-to-r from-purple-100 to-pink-100 rounded-xl flex items-center justify-center shadow-lg">
              <svg class="w-6 h-6 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Heritage Table with MORE VISIBLE Buktot Beach Background -->
      <div class="rounded-2xl shadow-2xl border border-white/20 overflow-hidden relative heritage-table-container"
           style="background: linear-gradient(rgba(255,255,255,0.75), rgba(255,255,255,0.82)), url('https://letmetravelph.wordpress.com/wp-content/uploads/2016/10/hidden-beach.jpg?w=685'); background-size: cover; background-position: center; background-repeat: no-repeat; background-attachment: fixed;">
        
        <!-- Table Header with Search -->
        <div class="px-6 py-4 border-b border-emerald-100 bg-gradient-to-r from-emerald-50/85 to-green-50/85 backdrop-blur-sm">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <h2 class="text-xl font-semibold text-emerald-800">All Heritage Sites</h2>
              <p class="text-emerald-600 text-sm mt-1">{{heritages.length}} heritage sites found</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
              <div class="relative">
                <input type="text" placeholder="Search heritage..." class="pl-10 pr-4 py-2 border border-emerald-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 w-full md:w-64 bg-white/85 backdrop-blur-sm shadow-sm">
                <svg class="w-5 h-5 text-emerald-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
              <select class="border border-emerald-200 rounded-xl px-4 py-2 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 bg-white/85 backdrop-blur-sm shadow-sm">
                <option value="">All Categories</option>
                <option value="historical">Historical</option>
                <option value="cultural">Cultural</option>
                <option value="natural">Natural</option>
                <option value="archaeological">Archaeological</option>
              </select>
            </div>
          </div>
        </div>
        
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-emerald-100/50">
            <thead>
              <tr class="bg-emerald-50/75 backdrop-blur-sm">
                <th class="px-4 py-4 text-left text-xs font-semibold text-emerald-800 uppercase tracking-wider w-2/5">Heritage Site</th>
                <th class="px-4 py-4 text-left text-xs font-semibold text-emerald-800 uppercase tracking-wider w-32">Category</th>
                <th class="px-4 py-4 text-left text-xs font-semibold text-emerald-800 uppercase tracking-wider w-40">Location</th>
                <th class="px-4 py-4 text-left text-xs font-semibold text-emerald-800 uppercase tracking-wider w-24">Status</th>
                <th class="px-4 py-4 text-right text-xs font-semibold text-emerald-800 uppercase tracking-wider w-48">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-emerald-100/30">
              {{#each heritages}}
              <tr class="hover:bg-emerald-50/40 backdrop-blur-sm transform transition-all duration-300 hover:scale-[1.01]">
                <td class="px-4 py-4 align-top">
                  <div class="flex items-start">
                    <div class="h-16 w-16 flex-shrink-0">
                      <img class="h-16 w-16 rounded-lg object-cover border border-emerald-100 shadow" 
                           src="{{this.image_url}}" 
                           alt="{{this.title}}"
                           onerror="this.src='data:image/svg+xml;base64,'">
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-semibold text-gray-900 leading-5 max-w-[520px]">{{this.title}}</div>
                      <div class="text-xs text-gray-600 line-clamp-2 max-w-[520px]">{{this.description}}</div>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-4">
                  <span class="inline-flex px-2 py-1 text-xs font-semibold leading-4 rounded-full bg-gradient-to-r from-emerald-100 to-green-100 text-emerald-800 border border-emerald-200 capitalize">
                    {{this.category}}
                  </span>
                </td>
                <td class="px-4 py-4 text-sm text-gray-900">
                  <div class="flex items-center">
                    <svg class="w-3 h-3 text-emerald-500 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="truncate max-w-[120px]">{{this.location}}</span>
                  </div>
                </td>
                <td class="px-4 py-4">
                  <span class="inline-flex px-2 py-1 text-xs font-semibold leading-4 rounded-full {{#if (eq this.status 'active')}}bg-green-100 text-green-800{{else}}bg-red-100 text-red-800{{/if}} capitalize">
                    {{this.status}}
                  </span>
                </td>
                <td class="px-4 py-4 text-right">
                  <div class="flex justify-end space-x-1">
                    <a 
                      href="/heritage/{{this.id}}" 
                      class="inline-flex items-center px-2 py-1 bg-blue-50 text-blue-600 rounded-lg hover:bg-blue-100 transform hover:scale-105 transition-all duration-300 group text-xs border border-blue-100"
                      target="_blank"
                    >
                      <svg class="w-3 h-3 mr-1 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                      </svg>
                      View
                    </a>
                    <a 
                      href="/admin/heritage/edit/{{this.id}}" 
                      class="inline-flex items-center px-2 py-1 bg-emerald-50 text-emerald-600 rounded-lg hover:bg-emerald-100 transform hover:scale-105 transition-all duration-300 group text-xs border border-emerald-100"
                    >
                      <svg class="w-3 h-3 mr-1 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                      Edit
                    </a>
                    <form method="POST" action="/admin/heritage/delete" class="inline">
                      <input type="hidden" name="id" value="{{this.id}}">
                      <button 
                        type="submit" 
                        onclick="return confirm('Are you sure you want to delete {{this.title}}?')"
                        class="inline-flex items-center px-2 py-1 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transform hover:scale-105 transition-all duration-300 group text-xs border border-red-100"
                      >
                        <svg class="w-3 h-3 mr-1 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                        Delete
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        
        {{#unless heritages.length}}
        <div class="text-center py-12">
          <svg class="w-16 h-16 text-emerald-200 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No heritage sites found</h3>
          <p class="text-gray-600 mb-4">Get started by adding your first heritage site from Oriental Mindoro.</p>
          <a href="/admin/heritage/add" class="inline-flex items-center px-4 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transform hover:scale-105 transition-all duration-300 shadow-lg border border-white/20">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add First Heritage
          </a>
        </div>
        {{/unless}}
      </div>
    </main>
  </div>

  <script>
    // Add hover animations and search functionality
    document.addEventListener('DOMContentLoaded', function() {
      const rows = document.querySelectorAll('tbody tr');
      const searchInput = document.querySelector('input[type="text"]');
      const categoryFilter = document.querySelector('select');

      // Row hover effects
      rows.forEach(row => {
        row.addEventListener('mouseenter', function() {
          this.style.transform = 'scale(1.01)';
        });
        row.addEventListener('mouseleave', function() {
          this.style.transform = 'scale(1)';
        });
      });

      // Search functionality
      function filterHeritage() {
        const searchTerm = searchInput.value.toLowerCase();
        const categoryValue = categoryFilter.value.toLowerCase();

        rows.forEach(row => {
          const title = row.querySelector('.text-sm.font-semibold').textContent.toLowerCase();
          const description = row.querySelector('.text-gray-600').textContent.toLowerCase();
          const category = row.querySelector('td:nth-child(2) span').textContent.toLowerCase();

          const matchesSearch = title.includes(searchTerm) || description.includes(searchTerm);
          const matchesCategory = !categoryValue || category.includes(categoryValue);

          if (matchesSearch && matchesCategory) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      }

      searchInput.addEventListener('input', filterHeritage);
      categoryFilter.addEventListener('change', filterHeritage);
    });
  </script>

  <style>
    @keyframes pulseSlow {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.8;
      }
    }

    .animate-pulse-slow {
      animation: pulseSlow 4s ease-in-out infinite;
    }

    /* Smooth transitions */
    * {
      transition-property: color, background-color, border-color, transform, box-shadow;
      transition-duration: 300ms;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Custom scrollbar for better visibility */
    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb {
      background: rgba(16, 185, 129, 0.6);
      border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: rgba(16, 185, 129, 0.8);
    }

    /* Ensure table cells don't overflow */
    table {
      table-layout: fixed;
    }
    
    td, th {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: normal;
    }

    /* Two-line clamp helper for descriptions */
    .line-clamp-2 {
      line-clamp: 2;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Enhanced background styling for more visibility */
    .heritage-table-container {
      background-blend-mode: overlay;
    }

    /* Make background more visible */
    .heritage-table-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(rgba(255,255,255,0.7), rgba(255,255,255,0.8));
      z-index: -1;
    }
  </style>
</body>
</html>
