{{>head}}
<body class="bg-gradient-to-br from-gray-50 to-emerald-50 min-h-screen">
  <div class="container mx-auto p-8">
    <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow p-8">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">Edit Craft</h1>
        <a href="/admin/crafts" class="text-sm px-3 py-2 bg-gray-200 rounded">Back</a>
      </div>

      {{>messages}}
      <form id="craft-form" action="/admin/crafts/update/{{craft.id}}" method="POST" class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-gray-700">Title</label>
          <input name="title" value="{{craft.title}}" required class="mt-1 block w-full border border-gray-300 rounded px-4 py-2" />
        </div>

        <!-- Location is picked via map search/confirm. Hidden input receives the value on confirm. -->
        <input type="hidden" id="location" name="location" value="{{craft.location}}" />

        <div>
          <label class="block text-sm font-medium text-gray-700">Description</label>
          <textarea name="description" rows="4" class="mt-1 block w-full border border-gray-300 rounded px-4 py-2">{{craft.description}}</textarea>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700">Image URL</label>
          <input name="image_url" value="{{craft.image_url}}" placeholder="https://example.com/photo.jpg" class="mt-1 block w-full border border-gray-300 rounded px-4 py-2" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Select Location on Map (Mansalay)</label>
          <div class="flex items-center gap-2 mb-2">
            <input id="loc-search" type="text" placeholder="Enter address or place (e.g. Barangay name)" class="flex-1 border border-gray-300 rounded px-3 py-2" />
            <button id="loc-search-btn" type="button" class="px-4 py-2 bg-amber-600 text-white rounded">Search</button>
          </div>
          <div id="map" style="height:360px; border-radius:12px; border:1px solid #e5e7eb;"></div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <input type="text" id="latitude" name="latitude" value="{{craft.latitude}}" placeholder="Latitude" class="border border-gray-300 rounded px-3 py-2" />
            <input type="text" id="longitude" name="longitude" value="{{craft.longitude}}" placeholder="Longitude" class="border border-gray-300 rounded px-3 py-2" />
          </div>
          <p class="text-xs text-gray-500 mt-1">Click on the map to pick coordinates. Map language is English.</p>
          <div id="loc-confirm" class="fixed bottom-6 right-6 bg-white shadow-lg rounded-lg p-4 hidden z-50 border">
            <div class="mb-2 text-sm text-gray-700">Use this location?</div>
            <div class="flex gap-2">
              <button id="confirm-loc" type="button" class="px-4 py-2 bg-amber-600 text-white rounded">Confirm</button>
              <button id="cancel-loc" type="button" class="px-4 py-2 bg-gray-200 rounded">Cancel</button>
            </div>
          </div>
        </div>

        <div class="flex gap-4">
          <a href="/admin/crafts" class="px-6 py-3 rounded bg-gray-200">Cancel</a>
          <button class="px-6 py-3 rounded bg-amber-600 text-white">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    (function(){
      const defaultCenter = [12.5833, 121.4500];
      var lat = parseFloat('{{craft.latitude}}');
      var lng = parseFloat('{{craft.longitude}}');
      var center = (!isNaN(lat) && !isNaN(lng)) ? [lat, lng] : defaultCenter;
      var map = L.map('map').setView(center, (!isNaN(lat) && !isNaN(lng)) ? 14 : 12);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap contributors' }).addTo(map);
      var marker;
      var pendingMarker;
      function setMarker(lat, lng){ if(marker) map.removeLayer(marker); marker = L.marker([lat, lng]).addTo(map); }
      function setPendingMarker(lat, lng){ if(pendingMarker) map.removeLayer(pendingMarker); pendingMarker = L.marker([lat, lng], {opacity:0.8}).addTo(map); }
      function clearPending(){ if(pendingMarker){ map.removeLayer(pendingMarker); pendingMarker = null; } document.getElementById('loc-confirm').classList.add('hidden'); }
      if(!isNaN(lat) && !isNaN(lng)) setMarker(lat, lng);
      map.on('click', function(e){ const la = e.latlng.lat.toFixed(6); const lo = e.latlng.lng.toFixed(6); setPendingMarker(la, lo); document.getElementById('loc-confirm').classList.remove('hidden'); document.getElementById('confirm-loc').dataset.lat = la; document.getElementById('confirm-loc').dataset.lng = lo; });
      async function geocode(query){ if(!query) return null; const url = 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(query); try{ const resp = await fetch(url, { headers: { 'Accept-Language': 'en' } }); const json = await resp.json(); return json && json.length ? json[0] : null; }catch(e){ console.warn('geocode error', e); return null; } }
      document.getElementById('loc-search-btn').addEventListener('click', async function(){ const q = document.getElementById('loc-search').value.trim(); if(!q) return; const res = await geocode(q + ' Mansalay'); if(res){ const la = parseFloat(res.lat).toFixed(6); const lo = parseFloat(res.lon).toFixed(6); map.setView([la, lo], 14); setPendingMarker(la, lo); document.getElementById('loc-confirm').classList.remove('hidden'); document.getElementById('confirm-loc').dataset.lat = la; document.getElementById('confirm-loc').dataset.lng = lo; } else { alert('Location not found. Try a different query.'); } });
      document.getElementById('confirm-loc').addEventListener('click', function(){
        const la = this.dataset.lat;
        const lo = this.dataset.lng;
        if(la && lo){
          document.getElementById('latitude').value = la;
          document.getElementById('longitude').value = lo;
          // populate hidden location input with search text if available, otherwise lat,lng
          const searchText = document.getElementById('loc-search').value.trim();
          const locInput = document.getElementById('location');
          if(locInput) locInput.value = searchText || (la + ',' + lo);
          setMarker(la, lo);
          clearPending();
        }
      });
      document.getElementById('cancel-loc').addEventListener('click', function(){ clearPending(); });
      document.getElementById('latitude').addEventListener('change', function(){ const la = parseFloat(this.value); const lo = parseFloat(document.getElementById('longitude').value); if(!isNaN(la) && !isNaN(lo)){ setMarker(la, lo); map.setView([la, lo], 14); } });
      document.getElementById('longitude').addEventListener('change', function(){ const lo = parseFloat(this.value); const la = parseFloat(document.getElementById('latitude').value); if(!isNaN(la) && !isNaN(lo)){ setMarker(la, lo); map.setView([la, lo], 14); } });

      // prevent submit if location not set
      const craftForm = document.getElementById('craft-form');
      if(craftForm){
        craftForm.addEventListener('submit', function(e){
          const locVal = document.getElementById('location') && document.getElementById('location').value.trim();
          if(!locVal){
            e.preventDefault();
            alert('Please pick a location using the map search or click the map and press Confirm before submitting.');
          }
        });
      }
    })();
  </script>

  {{>footer}}
</body>
</html>


