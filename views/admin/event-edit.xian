{{>head}}
<body class="min-h-screen relative overflow-x-hidden">
  <!-- Background Photo with Overlay -->
  <div class="fixed inset-0 z-0">
    <img 
      src="https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/e2/a9/62/up-on-the-bluff.jpg?w=1000&h=-1&s=1" 
      alt="Oriental Mindoro Events Background" 
      class="w-full h-full object-cover"
    >
    <div class="absolute inset-0 bg-gradient-to-br from-emerald-900/80 via-emerald-800/70 to-teal-900/90 backdrop-blur-[1px]"></div>
  </div>

  <div class="flex relative z-10">
    <!-- Enhanced Sidebar -->
    <aside class="w-72 bg-gradient-to-b from-emerald-800/95 via-emerald-700/90 to-emerald-900/95 text-white min-h-screen p-6 shadow-2xl relative overflow-hidden backdrop-blur-sm">
      <!-- Animated Background Pattern -->
      <div class="absolute inset-0 bg-white/5 bg-[linear-gradient(45deg,transparent_25%,rgba(255,255,255,.1)_50%,transparent_75%,transparent_100%)] bg-[length:10px_10px] animate-pulse-slow"></div>
      
      <div class="relative z-10">
        <!-- Logo Section -->
        <div class="flex items-center space-x-3 mb-10 p-4 bg-white/10 rounded-2xl backdrop-blur-sm border border-white/20">
          <div class="w-12 h-12 bg-gradient-to-r from-emerald-400 to-green-400 rounded-xl flex items-center justify-center shadow-lg">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold bg-gradient-to-r from-emerald-200 to-green-200 bg-clip-text text-transparent">CultureFrame</h2>
            <p class="text-emerald-200 text-xs">Admin Panel</p>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="space-y-2 mb-8">
          <a href="/admin" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
              </svg>
            </div>
            <span class="font-medium">Dashboard</span>
          </a>
          
          <a href="/admin/heritage" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="font-medium">Heritage</span>
          </a>
          
          <a href="/admin/products" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3z"></path>
              </svg>
            </div>
            <span class="font-medium">Products</span>
          </a>
          
          <a href="/admin/orders" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="font-medium">Orders</span>
          </a>
          
          <a href="/admin/events" class="flex items-center space-x-3 py-3 px-4 bg-white/20 rounded-xl border border-white/20 backdrop-blur-sm transform transition-all duration-300 hover:scale-105 hover:bg-white/25 group">
            <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center group-hover:bg-white/30 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="font-medium">Events</span>
          </a>

          <a href="/admin/scenic" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 2a6 6 0 00-6 6v6a2 2 0 002 2h8a2 2 0 002-2V8a6 6 0 00-6-6zM8 10a2 2 0 114 0 2 2 0 01-4 0z"></path>
              </svg>
            </div>
            <span class="font-medium">Scenic</span>
          </a>

          <a href="/admin/crafts" class="flex items-center space-x-3 py-3 px-4 rounded-xl transform transition-all duration-300 hover:scale-105 hover:bg-white/15 group">
            <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center group-hover:bg-white/20 transition-colors">
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M4 3a1 1 0 000 2h12a1 1 0 100-2H4zm0 5a1 1 0 000 2h12a1 1 0 100-2H4zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"></path>
              </svg>
            </div>
            <span class="font-medium">Crafts</span>
          </a>
        </nav>

        <!-- Logout Button -->
        <a href="/logout" class="flex items-center space-x-3 py-3 px-4 bg-gradient-to-r from-green-600 to-emerald-600 rounded-xl transform transition-all duration-300 hover:scale-105 hover:from-green-700 hover:to-emerald-700 shadow-lg group">
          <div class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center group-hover:bg-white/30 transition-colors">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <span class="font-medium">Logout</span>
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-4xl font-bold text-white mb-2 bg-gradient-to-r from-white to-emerald-100 bg-clip-text text-transparent drop-shadow-lg">Edit Event</h1>
        <p class="text-emerald-100 text-lg drop-shadow">Update event details and information</p>
      </div>

      <!-- Enhanced Form with Proper Background Integration -->
      <div class="bg-white/60 backdrop-blur-lg rounded-2xl shadow-2xl p-8 border border-white/30 max-w-4xl relative overflow-hidden">
        
        <!-- Additional overlay for better text readability -->
        <div class="absolute inset-0 bg-gradient-to-br from-white/40 via-white/50 to-white/40 z-0"></div>
        
        <!-- Form Content -->
        <div class="relative z-10">
          <!-- Form Header -->
          <div class="flex items-center space-x-3 mb-8 pb-6 border-b border-emerald-100">
            <div class="w-12 h-12 bg-gradient-to-r from-emerald-100 to-green-100 rounded-xl flex items-center justify-center">
              <svg class="w-6 h-6 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-emerald-800 drop-shadow-sm">Edit Event Entry</h2>
              <p class="text-emerald-700 font-medium drop-shadow-sm">Update event details and information</p>
            </div>
          </div>

          <form method="POST" action="/admin/events/update/{{event.id}}" enctype="multipart/form-data" class="space-y-6">
            <!-- Title -->
            <div class="group">
              <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2 drop-shadow-sm">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Title</span>
                <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                name="title" 
                value="{{event.title}}"
                required 
                class="w-full p-4 bg-white/70 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-lg backdrop-blur-sm"
                placeholder="Enter event title (e.g., 'Mangyan Festival' or 'Cultural Workshop')"
              >
            </div>

            <!-- Category -->
            <div class="group">
              <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2 drop-shadow-sm">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Category</span>
                <span class="text-red-500">*</span>
              </label>
              <select 
                name="category" 
                required 
                class="w-full p-4 bg-white/70 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 font-medium appearance-none cursor-pointer shadow-lg backdrop-blur-sm"
              >
                <option value="festival" {{#if (eq event.category "festival")}}selected{{/if}}>Festival</option>
                <option value="workshop" {{#if (eq event.category "workshop")}}selected{{/if}}>Workshop</option>
                <option value="exhibition" {{#if (eq event.category "exhibition")}}selected{{/if}}>Exhibition</option>
                <option value="cultural" {{#if (eq event.category "cultural")}}selected{{/if}}>Cultural</option>
                <option value="educational" {{#if (eq event.category "educational")}}selected{{/if}}>Educational</option>
                <option value="community" {{#if (eq event.category "community")}}selected{{/if}}>Community</option>
              </select>
            </div>

            <!-- Location -->
            <div class="group">
              <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2 drop-shadow-sm">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Location</span>
                <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                name="location" 
                value="{{event.location}}"
                required 
                class="w-full p-4 bg-white/70 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-lg backdrop-blur-sm"
                placeholder="Enter event location (e.g., 'Calapan City Hall', 'Puerto Galera Beach')"
              >
            </div>

            <!-- Image Upload or URL -->
            <div class="group">
              <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2 drop-shadow-sm">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Image</span>
              </label>
              <div class="flex flex-col md:flex-row gap-4">
                <div class="flex-1">
                  <input 
                    type="file" 
                    name="image_file" 
                    accept="image/*"
                    class="block w-full text-sm text-emerald-700 bg-white/70 border-2 border-emerald-100 rounded-xl cursor-pointer focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 shadow-lg backdrop-blur-sm mb-2 p-3"
                  >
                  <p class="text-xs text-emerald-700 font-medium drop-shadow-sm">Upload a new image to replace the current one</p>
                </div>
                <div class="flex-1">
                  <input 
                    type="text" 
                    name="image_url" 
                    value="{{event.image_url}}"
                    class="w-full p-4 bg-white/70 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-lg backdrop-blur-sm"
                    placeholder="https://example.com/event-image.jpg"
                  >
                  <p class="text-xs text-emerald-700 font-medium drop-shadow-sm mt-2">Or provide a direct image URL</p>
                </div>
              </div>
              {{#if event.image_url}}
                <div class="mt-4">
                  <p class="text-xs text-emerald-700 font-medium mb-1 drop-shadow-sm">Current Image Preview:</p>
                  <img src="{{event.image_url}}" alt="Current Image" class="max-w-xs h-32 object-cover rounded-lg border-2 border-emerald-200 shadow-md" onerror="this.style.display='none'" />
                </div>
              {{/if}}
            </div>

            <!-- Description -->
            <div class="group">
              <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2 drop-shadow-sm">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A1 1 0 013.707 9.293L10 15.586l6.293-6.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Description</span>
                <span class="text-red-500">*</span>
              </label>
              <textarea 
                name="description" 
                required 
                rows="4" 
                class="w-full p-4 bg-white/70 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium resize-none shadow-lg backdrop-blur-sm"
                placeholder="Describe this event in detail. Include activities, schedule, and what attendees can expect..."
              >{{event.description}}</textarea>
            </div>

            <!-- Event Date -->
            <div class="group">
              <label class="block text-emerald-800 font-semibold mb-3 text-sm uppercase tracking-wide flex items-center space-x-2 drop-shadow-sm">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                </svg>
                <span>Event Date</span>
                <span class="text-red-500">*</span>
              </label>
              <input 
                type="date" 
                name="event_date" 
                value="{{event.event_date}}"
                required
                class="w-full p-4 bg-white/70 border-2 border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-400 focus:bg-white focus:ring-4 focus:ring-emerald-100 transition-all duration-300 placeholder-emerald-400/60 font-medium shadow-lg backdrop-blur-sm"
              >
            </div>

            <!-- Buttons -->
            <div class="flex space-x-4 pt-6 border-t border-emerald-100">
              <button 
                type="submit" 
                class="flex-1 bg-gradient-to-r from-emerald-500 to-green-500 hover:from-emerald-600 hover:to-green-600 text-white py-4 px-6 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2 group/btn border border-white/20 backdrop-blur-sm"
              >
                <svg class="w-5 h-5 transform group-hover/btn:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Update Event</span>
              </button>
              
              <a 
                href="/admin/events" 
                class="flex-1 bg-gradient-to-r from-gray-300 to-gray-400 hover:from-gray-400 hover:to-gray-500 text-gray-700 py-4 px-6 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2 group/cancel border border-gray-200 backdrop-blur-sm"
              >
                <svg class="w-5 h-5 transform group-hover/cancel:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                <span>Cancel</span>
              </a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <script>
    // Enhanced form interactions for Edit Heritage
    document.addEventListener('DOMContentLoaded', function() {
      const inputs = document.querySelectorAll('input, textarea, select');
      const form = document.querySelector('form');
      
      // Add focus animations with backdrop blur
      inputs.forEach(input => {
        input.addEventListener('focus', function() {
          this.style.backdropFilter = 'blur(8px)';
          this.parentElement.classList.add('transform', 'scale-[1.02]');
        });
        
        input.addEventListener('blur', function() {
          this.style.backdropFilter = 'blur(4px)';
          this.parentElement.classList.remove('transform', 'scale-[1.02]');
        });
        
        // Add typing animation with color feedback
        input.addEventListener('input', function() {
          if (this.value) {
            this.classList.add('border-emerald-300', 'bg-white/90');
          } else {
            this.classList.remove('border-emerald-300', 'bg-white/90');
          }
        });
      });
      
      // Form submission animation with enhanced feedback
      form.addEventListener('submit', function(e) {
        const submitBtn = this.querySelector('button[type="submit"]');
        const inputs = this.querySelectorAll('input[required], textarea[required], select[required]');
        let isValid = true;
        
        // Validate required fields
        inputs.forEach(input => {
          if (!input.value.trim()) {
            input.classList.add('border-red-300', 'bg-red-50/50');
            isValid = false;
          } else {
            input.classList.remove('border-red-300', 'bg-red-50/50');
          }
        });
        
        if (!isValid) {
          e.preventDefault();
          submitBtn.classList.add('animate-pulse', 'bg-gradient-to-r', 'from-red-500', 'to-pink-500');
          setTimeout(() => {
            submitBtn.classList.remove('animate-pulse', 'bg-gradient-to-r', 'from-red-500', 'to-pink-500');
            submitBtn.classList.add('bg-gradient-to-r', 'from-emerald-500', 'to-green-500');
          }, 2000);
          
          // Scroll to first error
          const firstError = this.querySelector('.border-red-300');
          if (firstError) {
            firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          return;
        }
        
        // Success animation
        submitBtn.classList.add('animate-pulse');
        submitBtn.innerHTML = `
          <svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Updating Event...</span>
        `;
        
        setTimeout(() => {
          submitBtn.classList.remove('animate-pulse');
          submitBtn.innerHTML = `
            <svg class="w-5 h-5 transform group-hover/btn:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Update Event</span>
          `;
        }, 2000);
      });
      
      // Add character counter for textareas
      const textareas = document.querySelectorAll('textarea');
      textareas.forEach(textarea => {
        const counter = document.createElement('div');
        counter.className = 'text-xs text-emerald-600 text-right mt-1 opacity-0 transition-opacity duration-300';
        textarea.parentNode.appendChild(counter);
        
        textarea.addEventListener('input', function() {
          const count = this.value.length;
          counter.textContent = `${count} characters`;
          counter.style.opacity = count > 0 ? '1' : '0';
          
          if (count > 1000) {
            counter.classList.add('text-orange-500');
          } else {
            counter.classList.remove('text-orange-500');
          }
        });
        
        // Initialize counter with current value
        if (textarea.value) {
          const count = textarea.value.length;
          counter.textContent = `${count} characters`;
          counter.style.opacity = '1';
          if (count > 1000) {
            counter.classList.add('text-orange-500');
          }
        }
      });
      
      // Add image preview functionality
      const imageUrlInput = document.querySelector('input[name="image_url"]');
      const imagePreview = document.createElement('div');
      imagePreview.className = 'mt-2';
      imageUrlInput.parentNode.appendChild(imagePreview);
      
      function updateImagePreview() {
        const url = imageUrlInput.value.trim();
        if (url && isValidUrl(url)) {
          imagePreview.innerHTML = `
            <div class="bg-emerald-50 rounded-lg p-3 border border-emerald-200">
              <p class="text-sm text-emerald-700 font-medium mb-2">Image Preview:</p>
              <img src="${url}" alt="Preview" class="max-w-full h-32 object-cover rounded-lg border border-emerald-200" onerror="this.style.display='none'" />
              <p class="text-xs text-emerald-600 mt-2">Image will load if URL is valid</p>
            </div>
          `;
        } else {
          imagePreview.innerHTML = '';
        }
      }
      
      imageUrlInput.addEventListener('blur', updateImagePreview);
      imageUrlInput.addEventListener('input', updateImagePreview);
      
      // Initialize image preview if URL exists
      if (imageUrlInput.value.trim()) {
        updateImagePreview();
      }
      
      function isValidUrl(string) {
        try {
          new URL(string);
          return true;
        } catch (_) {
          return false;
        }
      }
    });
  </script>

  <style>
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pulseSlow {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.8;
      }
    }

    .animate-fade-in {
      animation: fadeIn 0.6s ease-out forwards;
    }

    .animate-pulse-slow {
      animation: pulseSlow 4s ease-in-out infinite;
    }

    /* Custom select arrow */
    select {
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2310b981' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
      background-position: right 0.75rem center;
      background-repeat: no-repeat;
      background-size: 1.5em 1.5em;
      padding-right: 2.5rem;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Custom scrollbar for textareas */
    textarea::-webkit-scrollbar {
      width: 6px;
    }

    textarea::-webkit-scrollbar-track {
      background: rgba(16, 185, 129, 0.1);
      border-radius: 3px;
    }

    textarea::-webkit-scrollbar-thumb {
      background: rgba(16, 185, 129, 0.3);
      border-radius: 3px;
    }

    textarea::-webkit-scrollbar-thumb:hover {
      background: rgba(16, 185, 129, 0.5);
    }

    /* Enhanced focus states */
    input:focus, textarea:focus, select:focus {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.2);
    }

    /* Loading animation for form submission */
    @keyframes shimmer {
      0% {
        background-position: -200px 0;
      }
      100% {
        background-position: 200px 0;
      }
    }

    .loading-shimmer {
      animation: shimmer 1.5s infinite linear;
      background: linear-gradient(
        to right,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.4) 50%,
        rgba(255, 255, 255, 0) 100%
      );
      background-size: 200px 100%;
    }

    /* Category-specific color coding */
    select option[value="landmark"] {
      background-color: #d1fae5;
      color: #065f46;
    }

    select option[value="tradition"] {
      background-color: #e0e7ff;
      color: #3730a3;
    }

    select option[value="craft"] {
      background-color: #fce7f3;
      color: #831843;
    }

    select option[value="cuisine"] {
      background-color: #fed7aa;
      color: #9a3412;
    }

    select option[value="artifact"] {
      background-color: #f3e8ff;
      color: #581c87;
    }

    select option[value="music"] {
      background-color: #fef7cd;
      color: #713f12;
    }

    select option[value="language"] {
      background-color: #dcfce7;
      color: #166534;
    }

    /* Ensure form elements are properly visible */
    .group:hover {
      transform: translateX(4px);
      transition: transform 0.3s ease;
    }

    /* Background image optimization */
    .bg-cover {
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    /* Text shadow for better readability */
    .text-shadow {
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    /* Enhanced backdrop blur effects */
    .backdrop-blur-sm {
      backdrop-filter: blur(4px);
    }

    .backdrop-blur-md {
      backdrop-filter: blur(8px);
    }

    .backdrop-blur-lg {
      backdrop-filter: blur(16px);
    }
  </style>
</body>
</html>
