{{>head}}
<body class="bg-gray-50 flex">
  {{> admin-sidebar activePage="scenic"}}

    <main class="flex-1 p-8">
      <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow p-8">
        <div class="flex justify-between items-center mb-6">
          <h1 class="text-2xl font-bold">Add Scenic Spot</h1>
          <a href="/admin/scenic" class="text-sm px-3 py-2 bg-gray-200 rounded">Back</a>
        </div>

        <form action="/admin/scenic/add" method="POST" enctype="multipart/form-data" class="space-y-6">
          <div>
            <label class="block text-sm font-medium text-gray-700">Title</label>
            <input name="title" required class="mt-1 block w-full border border-gray-300 rounded px-4 py-2" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">Location</label>
            <input name="location" required class="mt-1 block w-full border border-gray-300 rounded px-4 py-2" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">Description</label>
            <textarea name="description" rows="4" class="mt-1 block w-full border border-gray-300 rounded px-4 py-2"></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">Image</label>
            <div class="flex gap-3 items-center">
              <input id="image_file" name="image_file" type="file" accept="image/*" class="mt-1" />
              <input id="image_url" name="image_url" placeholder="Or paste image URL (https://...)" class="mt-1 block w-full border border-gray-300 rounded px-4 py-2" />
            </div>
            <div class="mt-3">
              <div class="text-xs text-gray-500 mb-2">Preview</div>
              <div class="w-full h-56 bg-gray-100 rounded overflow-hidden border border-gray-200 flex items-center justify-center">
                <img id="image-preview" src="" alt="Image preview" class="w-full h-full object-contain" />
              </div>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Select Location on Map (Mansalay)</label>
            <div class="flex items-center gap-2 mb-2">
              <input id="loc-search" type="text" placeholder="Enter address or place (e.g. Barangay name)" class="flex-1 border border-gray-300 rounded px-3 py-2" />
              <button id="loc-search-btn" type="button" class="px-4 py-2 bg-emerald-600 text-white rounded">Search</button>
            </div>
            <div id="map" style="height:360px; border-radius:12px; border:1px solid #e5e7eb;"></div>
            <!-- confirmation bar -->
            <div id="loc-confirm" class="fixed bottom-6 right-6 bg-white shadow-lg rounded-lg p-4 hidden z-50 border">
              <div class="mb-2 text-sm text-gray-700">Use this location?</div>
              <div class="flex gap-2">
                <button id="confirm-loc" type="button" class="px-4 py-2 bg-emerald-600 text-white rounded">Confirm</button>
                <button id="cancel-loc" type="button" class="px-4 py-2 bg-gray-200 rounded">Cancel</button>
              </div>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-2">
              <input type="text" id="latitude" name="latitude" placeholder="Latitude" class="border border-gray-300 rounded px-3 py-2" />
              <input type="text" id="longitude" name="longitude" placeholder="Longitude" class="border border-gray-300 rounded px-3 py-2" />
            </div>
            <p class="text-xs text-gray-500 mt-1">Click on the map to pick coordinates. Map language is English.</p>
          </div>

          <div class="flex gap-4">
            <a href="/admin/scenic" class="px-6 py-3 rounded bg-gray-200">Cancel</a>
            <button class="px-6 py-3 rounded bg-emerald-600 text-white">Add Scenic</button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    (function(){
      // Mansalay center (approx)
      const defaultCenter = [12.5833, 121.4500];
      var map = L.map('map').setView(defaultCenter, 12);

      // Use standard OSM tiles (labels in English where available)
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      var marker;
      var pendingMarker; // marker for search preview before confirm

      function setMarker(lat, lng){
        if(marker) map.removeLayer(marker);
        marker = L.marker([lat, lng]).addTo(map);
      }
      function setPendingMarker(lat, lng){
        if(pendingMarker) map.removeLayer(pendingMarker);
        pendingMarker = L.marker([lat, lng], {opacity:0.8}).addTo(map);
      }
      function clearPending(){ if(pendingMarker){ map.removeLayer(pendingMarker); pendingMarker = null; } document.getElementById('loc-confirm').classList.add('hidden'); }

      // click to pick (immediate pick without search)
      map.on('click', function(e){
        const lat = e.latlng.lat.toFixed(6);
        const lng = e.latlng.lng.toFixed(6);
        // show pending preview and ask confirm
        setPendingMarker(lat, lng);
        document.getElementById('loc-confirm').classList.remove('hidden');
        // store temp values on confirm button dataset
        document.getElementById('confirm-loc').dataset.lat = lat;
        document.getElementById('confirm-loc').dataset.lng = lng;
      });

      // search flow using Nominatim
      async function geocode(query){
        if(!query) return null;
        const url = 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(query);
        try{
          const resp = await fetch(url, { headers: { 'Accept-Language': 'en' } });
          const json = await resp.json();
          return json && json.length ? json[0] : null;
        }catch(e){ console.warn('geocode error', e); return null; }
      }

      document.getElementById('loc-search-btn').addEventListener('click', async function(){
        const q = document.getElementById('loc-search').value.trim();
        if(!q) return;
        const res = await geocode(q + ' Mansalay');
        if(res){
          const lat = parseFloat(res.lat).toFixed(6);
          const lng = parseFloat(res.lon).toFixed(6);
          map.setView([lat, lng], 14);
          setPendingMarker(lat, lng);
          document.getElementById('loc-confirm').classList.remove('hidden');
          document.getElementById('confirm-loc').dataset.lat = lat;
          document.getElementById('confirm-loc').dataset.lng = lng;
        } else {
          alert('Location not found. Try a different query.');
        }
      });

      document.getElementById('confirm-loc').addEventListener('click', function(){
        const lat = this.dataset.lat;
        const lng = this.dataset.lng;
        if(lat && lng){
          document.getElementById('latitude').value = lat;
          document.getElementById('longitude').value = lng;
          setMarker(lat, lng);
          clearPending();
        }
      });
      document.getElementById('cancel-loc').addEventListener('click', function(){ clearPending(); });

      // allow manual lat/lng editing
      document.getElementById('latitude').addEventListener('change', function(){
        const lat = parseFloat(this.value);
        const lng = parseFloat(document.getElementById('longitude').value);
        if(!isNaN(lat) && !isNaN(lng)){
          setMarker(lat, lng);
          map.setView([lat, lng], 14);
        }
      });
      document.getElementById('longitude').addEventListener('change', function(){
        const lng = parseFloat(this.value);
        const lat = parseFloat(document.getElementById('latitude').value);
        if(!isNaN(lat) && !isNaN(lng)){
          setMarker(lat, lng);
          map.setView([lat, lng], 14);
        }
      });
    })();
  </script>

    <script>
      // Image preview for scenic add (file or URL)
      (function(){
        const fileInput = document.getElementById('image_file');
        const urlInput = document.getElementById('image_url');
        const preview = document.getElementById('image-preview');
        function showPreviewFromUrl(url){
          if(!url) { preview.src = ''; return; }
          preview.src = url;
        }
        fileInput && fileInput.addEventListener('change', function(e){
          const f = e.target.files && e.target.files[0];
          if(!f) return;
          const reader = new FileReader();
          reader.onload = function(ev){ preview.src = ev.target.result; };
          reader.readAsDataURL(f);
        });
        urlInput && urlInput.addEventListener('input', function(e){
          const v = e.target.value.trim();
          if(v) showPreviewFromUrl(v);
        });
      })();
    </script>
</body>
</html>

