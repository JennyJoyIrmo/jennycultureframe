{{>head}}
<body class="min-h-screen bg-cover bg-center bg-fixed" style="background-image: url('https://images.unsplash.com/photo-1586773860418-d37222d8fce3?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2073&q=80');">
  <div class="absolute inset-0 bg-gradient-to-br from-emerald-400/20 via-green-300/30 to-lime-200/40 z-0"></div>
  
  <div class="relative z-10">
    {{>nav}}

    <div class="container mx-auto px-4 py-20 text-center">
      <div class="bg-white/95 backdrop-blur-sm rounded-3xl shadow-2xl p-12 border border-emerald-100 max-w-2xl mx-auto">
        <div class="text-8xl mb-6">😔</div>
        <h1 class="text-5xl font-bold text-emerald-800 mb-4">Oops!</h1>
        <h2 class="text-2xl font-semibold text-gray-700 mb-6">{{message}}</h2>
        <p class="text-gray-600 mb-8">We're sorry, but something went wrong. Please try again or go back to the homepage.</p>
        <div class="space-x-4">
          <a href="/" class="inline-block bg-gradient-to-r from-emerald-600 to-green-700 hover:from-emerald-700 hover:to-green-800 text-white px-8 py-4 rounded-xl text-lg font-semibold transition duration-200 shadow-lg hover:shadow-xl">
            Go Home
          </a>
          <button onclick="history.back()" class="inline-block bg-gray-200 hover:bg-gray-300 text-gray-800 px-8 py-4 rounded-xl text-lg font-semibold transition duration-200">
            Go Back
          </button>
        </div>
      </div>
    </div>

    {{>footer}}
  </div>
</body>
</html>
