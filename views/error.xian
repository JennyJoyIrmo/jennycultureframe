{{>head}}
<body class="bg-gray-50 min-h-screen flex flex-col">
  {{>nav}}
  <div class="flex-1 flex items-center justify-center px-4 py-20">
    <div class="cf-card p-12 text-center max-w-lg w-full cf-fade-up">
      <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-5">
        <i class="fas fa-triangle-exclamation text-red-500 text-3xl"></i>
      </div>
      <h1 class="text-4xl font-extrabold text-gray-800 mb-2">Oops!</h1>
      <h2 class="text-lg font-semibold text-gray-600 mb-3">{{#if message}}{{message}}{{else}}Something went wrong{{/if}}</h2>
      <p class="text-gray-400 text-sm mb-8">We're sorry, something went wrong. Please try again or return home.</p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/" class="cf-btn cf-btn-primary"><i class="fas fa-home"></i> Go Home</a>
        <button onclick="history.back()" class="cf-btn cf-btn-ghost"><i class="fas fa-arrow-left"></i> Go Back</button>
      </div>
    </div>
  </div>
  {{>footer}}
</body>
</html>
